<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.narthur.obsidian-sync</string>

    <!-- Route through cron-run for consistent logging
         (~/.local/log/obsidian-sync.log, timestamped lines). -->
    <key>ProgramArguments</key>
    <array>
        <string>${HOME}/bin/cron-run</string>
        <string>obsidian-sync</string>
        <string>${HOME}/bin/obsidian-sync</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>${HOME}/bin:${HOME}/.local/bin:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>OBSIDIAN_VAULT</key>
        <string>${HOME}/Obsidian/Main</string>
    </dict>

    <!-- Every 2 hours. StartInterval (not calendar) so it simply runs every
         7200s the Mac is awake; launchd coalesces a missed interval once on wake.

         Was 1800s to match the old remotely-save cadence, but a run takes ~22
         minutes (26k files, 11GB, almost all listing — 6073 runs moved 0 bytes),
         so the job was live ~73% of the time and any reboot had a ~3-in-4 chance
         of killing it mid-run. Combined with an unexpiring lock that wedged the
         job for 31 of 45 days across two episodes. At 7200s the duty cycle is
         ~18%; --max-lock 5m in obsidian-sync makes a killed run self-heal. -->
    <key>StartInterval</key>
    <integer>7200</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
