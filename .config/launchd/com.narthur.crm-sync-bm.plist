<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.narthur.crm-sync-bm</string>

    <!-- Route through cron-run so logging matches the other jobs
         (~/.local/log/crm-sync-bm.log, timestamped lines). -->
    <key>ProgramArguments</key>
    <array>
        <string>${HOME}/bin/cron-run</string>
        <string>crm-sync-bm</string>
        <string>${HOME}/bin/crm-sync-bm</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>${HOME}/bin:${HOME}/.local/bin:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Hourly at :55, matching the old crontab entry. launchd also reruns
         a missed interval once on wake (cron just skips it). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>55</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
