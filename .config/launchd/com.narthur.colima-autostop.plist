<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.narthur.colima-autostop</string>
	<key>ProgramArguments</key>
	<array>
		<string>${HOME}/.local/bin/colima-autostop.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>900</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/colima-autostop.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/colima-autostop.log</string>
</dict>
</plist>
