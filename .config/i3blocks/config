# i3blocks config file

[buzz]
command=echo "🐝 $(buzz next)"
interval=30
separator_block_width=30

[bluetooth-battery]
command=~/.config/i3blocks/blocklets/bluetooth-battery
interval=30
separator_block_width=30

[vpn]
command=n=$(nmcli -t -f GENERAL.CONNECTION device show proton0 2>/dev/null | cut -d: -f2); [ -n "$n" ] && echo "🔒 ${n#ProtonVPN }" || echo "🔓 VPN OFF"
interval=10
separator_block_width=30

[volume]
command=echo "🔊 $(amixer get Master | grep -oP '\[\d+%\]' | head -1 | tr -d '[]')"
interval=1
signal=10
separator_block_width=30

[time]
command=date '+%Y-%m-%d %H:%M '
interval=60
separator_block_width=30
