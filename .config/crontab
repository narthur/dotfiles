# After making changes to this file, reinstall using command:
# setup-cron

PATH=$HOME/bin:$HOME/.local/bin:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin

*/10 * * * * cron-run sync-work-time $HOME/bin/sync-work-time
0 * * * * cron-run dashlane-sync dcli sync
0 */6 * * * cron-run sync-claude-tokens $HOME/bin/sync-claude-tokens
0 3 * * 0 cron-run backup-urls $HOME/bin/backup-urls
55 * * * * cron-run crm-sync-bm $HOME/bin/crm-sync-bm
