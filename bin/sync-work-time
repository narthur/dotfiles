#!/bin/bash

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Portable date helper: compute date N days ago
if date --version >/dev/null 2>&1; then
  # GNU date (Linux)
  days_ago_date() { date -d "$1 days ago" +%Y-%m-%d; }
else
  # BSD date (macOS)
  days_ago_date() { date -v-"$1"d +%Y-%m-%d; }
fi

# Machine identifier for multi-machine deduplication
MACHINE_ID=$(hostname -s)

# Loop through the last 7 days (including today)
for days_ago in {6..0}; do
  target_date=$(days_ago_date "$days_ago")

  # Daystamp format: YYYYMMDD (strip dashes from YYYY-MM-DD)
  DAYSTAMP=$(echo "$target_date" | tr -d '-')
  REQUEST_ID="${DAYSTAMP}-${MACHINE_ID}"

  # Get work time in seconds from ActivityWatch
  seconds=$("$SCRIPT_DIR/get-work-time" "$target_date")

  # Handle null/empty result
  if [ -z "$seconds" ] || [ "$seconds" = "null" ]; then
    seconds=0
  fi

  # Convert seconds to hours (with 2 decimal places)
  hours=$(echo "scale=2; $seconds / 3600" | bc | sed 's/^\./0./')

  echo "Syncing $target_date: $hours hours"
  buzz_output=$(buzz add \
    --requestid "$REQUEST_ID" \
    --daystamp "$DAYSTAMP" \
    bizsys "$hours" \
    "Work time on ${MACHINE_ID} for ${DAYSTAMP}" 2>&1)
  buzz_exit=$?

  if [ $buzz_exit -ne 0 ]; then
    if echo "$buzz_output" | grep -qi "duplicate"; then
      : # identical duplicate already recorded, skip silently
    else
      echo "$buzz_output" >&2
    fi
  else
    echo "$buzz_output"
  fi
done
