#!/bin/bash

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log() {
    echo -e "${BLUE}[$(date '+%Y-%m-%d %H:%M:%S')]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[$(date '+%Y-%m-%d %H:%M:%S')] ✓${NC} $1"
}

log_error() {
    echo -e "${RED}[$(date '+%Y-%m-%d %H:%M:%S')] ✗${NC} $1" >&2
}

log_section() {
    echo ""
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  $1${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

# Run a command with logging
run() {
    local description="$1"
    shift
    log "Running: $description"
    if "$@"; then
        log_success "$description"
        return 0
    else
        log_error "$description failed (exit code: $?)"
        return 1
    fi
}

log_section "Ollama Model Setup"
# Base coding models (also pulled by setup-mac; shared by bin/llm-local).
for model in qwen2.5-coder:14b qwen2.5-coder:7b; do
    if ollama list 2>/dev/null | grep -q "^${model}"; then
        log_success "${model} already pulled"
    else
        run "pull ${model}" ollama pull "$model"
    fi
done

# Create 16k-context variants for opencode (agentic coding needs more than
# Ollama's 4k default). `ollama create` with only a PARAMETER override shares
# the base weights, so these add negligible disk.
log "Creating 16k-context variants for opencode"
for base in qwen2.5-coder:14b qwen2.5-coder:7b; do
    variant="${base}-16k"
    MODELFILE=$(mktemp)
    printf 'FROM %s\nPARAMETER num_ctx 16384\n' "$base" > "$MODELFILE"
    run "create ${variant} variant" ollama create "$variant" -f "$MODELFILE"
    rm -f "$MODELFILE"
done

log_section "OpenCode Configuration"
OPENCODE_CONFIG_DIR="$HOME/.config/opencode"
OPENCODE_CONFIG="$OPENCODE_CONFIG_DIR/opencode.json"

run "create opencode config directory" mkdir -p "$OPENCODE_CONFIG_DIR"

log "Creating opencode configuration at $OPENCODE_CONFIG"
cat > "$OPENCODE_CONFIG" << 'EOF'
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:14b-16k": {
          "name": "Qwen2.5 Coder 14B (local, 16k context)"
        },
        "qwen2.5-coder:7b-16k": {
          "name": "Qwen2.5 Coder 7B (local, 16k context)"
        }
      }
    }
  }
}
EOF
log_success "OpenCode configuration created"

log_section "Complete"
log_success "OpenCode is now configured to use qwen2.5-coder 14B/7B (16k context)"
log "Start opencode and run /models to select the model"
