#!/bin/bash

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log() {
    echo -e "${BLUE}[$(date '+%Y-%m-%d %H:%M:%S')]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[$(date '+%Y-%m-%d %H:%M:%S')] ✓${NC} $1"
}

log_error() {
    echo -e "${RED}[$(date '+%Y-%m-%d %H:%M:%S')] ✗${NC} $1" >&2
}

log_section() {
    echo ""
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  $1${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

# Run a command with logging
run() {
    local description="$1"
    shift
    log "Running: $description"
    if "$@"; then
        log_success "$description"
        return 0
    else
        log_error "$description failed (exit code: $?)"
        return 1
    fi
}

log_section "Ollama Model Setup"
run "pull qwen3-coder:30b" ollama pull qwen3-coder:30b

# Create model variant with larger context window for opencode
log "Creating qwen3-coder:30b-16k variant with larger context window"
MODELFILE=$(mktemp)
cat > "$MODELFILE" << 'EOF'
FROM qwen3-coder:30b
PARAMETER num_ctx 16384
EOF
run "create qwen3-coder:30b-16k variant" ollama create qwen3-coder:30b-16k -f "$MODELFILE"
rm "$MODELFILE"

log_section "OpenCode Configuration"
OPENCODE_CONFIG_DIR="$HOME/.config/opencode"
OPENCODE_CONFIG="$OPENCODE_CONFIG_DIR/opencode.json"

run "create opencode config directory" mkdir -p "$OPENCODE_CONFIG_DIR"

log "Creating opencode configuration at $OPENCODE_CONFIG"
cat > "$OPENCODE_CONFIG" << 'EOF'
{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:30b-16k": {
          "name": "Qwen3 Coder 30B (16k context)"
        }
      }
    }
  }
}
EOF
log_success "OpenCode configuration created"

log_section "Complete"
log_success "OpenCode is now configured to use qwen3-coder:30b-16k"
log "Start opencode and run /models to select the model"
