#!/bin/bash
# Helper script to set client mappings for Claude Code projects

set -eo pipefail

CLIENT_MAPPING="$HOME/.claude/client-mapping.json"
TOKEN_DIR="$HOME/.claude/token-usage"

# Ensure client mapping file exists
if [ ! -f "$CLIENT_MAPPING" ]; then
    echo '{"clients":{}}' > "$CLIENT_MAPPING"
fi

# Function to list unknown projects
list_unknown() {
    if [ ! -f "$TOKEN_DIR/all-repos.jsonl" ]; then
        echo "No token usage data found yet."
        exit 0
    fi
    
    # Get unique repo paths for unknown clients
    jq -r 'select(.client == "unknown") | .repo_path' "$TOKEN_DIR/all-repos.jsonl" 2>/dev/null | sort -u
}

# Function to list all known clients
list_clients() {
    jq -r '.clients | to_entries[] | .value' "$CLIENT_MAPPING" 2>/dev/null | sort -u
}

# Function to set client for a repo
set_client() {
    local repo_path="$1"
    local client_name="$2"
    
    # Normalize client name to lowercase
    client_name=$(echo "$client_name" | tr '[:upper:]' '[:lower:]')
    
    # Update the mapping
    local temp_file=$(mktemp)
    jq --arg repo "$repo_path" --arg client "$client_name" \
        '.clients[$repo] = $client' \
        "$CLIENT_MAPPING" > "$temp_file"
    
    mv "$temp_file" "$CLIENT_MAPPING"
    
    echo "✓ Set client '$client_name' for repo: $repo_path"
}

# Function to show current mapping
show_mapping() {
    echo "Current client mappings:"
    echo ""
    jq -r '.clients | to_entries[] | "\(.key) → \(.value)"' "$CLIENT_MAPPING" 2>/dev/null | sort
}

# Main command handling
case "${1:-}" in
    list|ls)
        echo "=== Projects with 'unknown' client ==="
        echo ""
        unknown=$(list_unknown)
        if [ -z "$unknown" ]; then
            echo "No unknown projects found!"
        else
            echo "$unknown"
        fi
        ;;
    
    set)
        if [ -z "$2" ] || [ -z "$3" ]; then
            echo "Usage: $0 set <repo-path> <client-name>"
            echo ""
            echo "Example:"
            echo "  $0 set /mnt/backup/code/myproject myclient"
            exit 1
        fi
        
        set_client "$2" "$3"
        
        # Ask if user wants to resync
        echo ""
        read -p "Resync token logs to update client? (y/n) " -n 1 -r < /dev/tty
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            # Clear tracked sessions for this repo so sync will reprocess
            repo_slug=$(echo "$2" | sed 's|/|_|g' | sed 's|^_||')
            if [ -f "$TOKEN_DIR/.tracked-sessions" ]; then
                # Remove entries for this repo's sessions
                temp_file=$(mktemp)
                grep -v "$(basename "$repo_slug")" "$TOKEN_DIR/.tracked-sessions" > "$temp_file" || true
                mv "$temp_file" "$TOKEN_DIR/.tracked-sessions"
            fi
            
            echo "Running sync..."
            sync-claude-tokens
        fi
        ;;
    
    show)
        show_mapping
        ;;
    
    clients)
        echo "=== Known clients ==="
        echo ""
        clients=$(list_clients)
        if [ -z "$clients" ]; then
            echo "No clients configured yet."
        else
            echo "$clients"
        fi
        ;;
    
    interactive|i)
        # Interactive mode
        unknown=$(list_unknown)
        if [ -z "$unknown" ]; then
            echo "No unknown projects found!"
            exit 0
        fi
        
        echo "=== Interactive Client Assignment ==="
        echo ""
        echo "Known clients:"
        list_clients | sed 's/^/  - /'
        echo ""
        
        while IFS= read -r repo; do
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo "Project: $repo"
            echo ""
            read -p "Client name (or 'skip'): " client_name < /dev/tty
            
            if [ "$client_name" != "skip" ] && [ -n "$client_name" ]; then
                set_client "$repo" "$client_name"
            else
                echo "Skipped."
            fi
            echo ""
        done <<< "$unknown"
        
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        read -p "Resync all token logs to update clients? (y/n) " -n 1 -r < /dev/tty
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            # Clear all tracked sessions to force full resync
            rm -f "$TOKEN_DIR/.tracked-sessions"
            rm -f "$TOKEN_DIR"/*.jsonl
            
            echo "Running full sync..."
            sync-claude-tokens
        fi
        ;;
    
    help|--help|-h|"")
        echo "set-claude-client - Manage client mappings for Claude Code projects"
        echo ""
        echo "Usage: set-claude-client <command> [args]"
        echo ""
        echo "Commands:"
        echo "  list, ls             List projects with 'unknown' client"
        echo "  set <repo> <client>  Set client for a specific repo"
        echo "  show                 Show current client mappings"
        echo "  clients              List all known clients"
        echo "  interactive, i       Interactive mode to assign clients"
        echo "  help                 Show this help message"
        echo ""
        echo "Examples:"
        echo "  # List unknown projects"
        echo "  set-claude-client list"
        echo ""
        echo "  # Set client for a project"
        echo "  set-claude-client set /mnt/backup/code/myapp myclient"
        echo ""
        echo "  # Interactive mode (recommended)"
        echo "  set-claude-client interactive"
        echo ""
        echo "Client mapping file: $CLIENT_MAPPING"
        exit 0
        ;;
    
    *)
        echo "Error: Unknown command '$1'"
        echo "Run 'set-claude-client help' for usage information."
        exit 1
        ;;
esac
