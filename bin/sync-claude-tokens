#!/bin/bash
# Sync Claude Code token usage by scanning all transcripts
# This catches sessions that didn't exit cleanly and subagent usage

set -eo pipefail

# Directories
CLAUDE_DIR="$HOME/.claude"
PROJECTS_DIR="$CLAUDE_DIR/projects"
TOKEN_DIR="$CLAUDE_DIR/token-usage"
TRACKED_FILE="$TOKEN_DIR/.tracked-sessions"
CLIENT_MAPPING="$CLAUDE_DIR/client-mapping.json"

# Create directories if needed
mkdir -p "$TOKEN_DIR"

# Initialize tracked sessions file if it doesn't exist
touch "$TRACKED_FILE"

# Function to check if a session has been tracked
is_tracked() {
    local session_id="$1"
    grep -qx "$session_id" "$TRACKED_FILE" 2>/dev/null
}

# Function to mark a session as tracked
mark_tracked() {
    local session_id="$1"
    echo "$session_id" >> "$TRACKED_FILE"
}

# Function to get client name from repo path
get_client() {
    local repo_path="$1"
    local client="unknown"
    
    if [ -f "$CLIENT_MAPPING" ]; then
        client=$(jq -r --arg repo "$repo_path" '.clients[$repo] // "unknown"' "$CLIENT_MAPPING" 2>/dev/null || echo "unknown")
        client=$(echo "$client" | tr '[:upper:]' '[:lower:]')
    fi
    
    echo "$client"
}

# Function to process a transcript file
process_transcript() {
    local transcript="$1"
    local is_subagent="${2:-false}"
    
    # Skip if file is empty or doesn't exist
    if [ ! -s "$transcript" ]; then
        return
    fi
    
    # Extract session info from first entry
    local session_id=$(jq -r 'select(.sessionId != null) | .sessionId' "$transcript" 2>/dev/null | head -1)
    local cwd=$(jq -r 'select(.cwd != null) | .cwd' "$transcript" 2>/dev/null | head -1)
    
    if [ -z "$session_id" ]; then
        return
    fi
    
    # Default cwd if empty
    if [ -z "$cwd" ]; then
        cwd="unknown"
    fi
    
    # Generate unique ID for this transcript (session + file path for subagents)
    local tracking_id="$session_id"
    if [ "$is_subagent" = "true" ]; then
        tracking_id="${session_id}:$(basename "$transcript")"
    fi
    
    # Skip if already tracked
    if is_tracked "$tracking_id"; then
        return
    fi
    
    # Calculate token usage
    local usage=$(jq -s '
        map(select(.message.usage != null) | .message.usage) | 
        {
            input_tokens: (map(.input_tokens // 0) | add // 0),
            output_tokens: (map(.output_tokens // 0) | add // 0),
            cache_creation_tokens: (map(.cache_creation_input_tokens // 0) | add // 0),
            cache_read_tokens: (map(.cache_read_input_tokens // 0) | add // 0)
        }
    ' "$transcript" 2>/dev/null)
    
    if [ -z "$usage" ]; then
        mark_tracked "$tracking_id"
        return
    fi
    
    local input_tokens=$(echo "$usage" | jq -r '.input_tokens // 0')
    local output_tokens=$(echo "$usage" | jq -r '.output_tokens // 0')
    local cache_creation_tokens=$(echo "$usage" | jq -r '.cache_creation_tokens // 0')
    local cache_read_tokens=$(echo "$usage" | jq -r '.cache_read_tokens // 0')
    
    # Skip if no token usage
    if [ "$input_tokens" -eq 0 ] && [ "$output_tokens" -eq 0 ] && \
       [ "$cache_creation_tokens" -eq 0 ] && [ "$cache_read_tokens" -eq 0 ]; then
        mark_tracked "$tracking_id"
        return
    fi
    
    # Calculate total
    local total_tokens=$((input_tokens + output_tokens + cache_creation_tokens + cache_read_tokens))
    
    # Get model name
    local model=$(jq -r 'select(.message.model != null) | .message.model' "$transcript" 2>/dev/null | head -1)
    if [ -z "$model" ]; then
        model="unknown"
    fi
    
    # Get client name
    local client=$(get_client "$cwd")
    
    # Create timestamp
    local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    
    # Determine reason
    local reason="session"
    if [ "$is_subagent" = "true" ]; then
        reason="subagent"
    fi
    
    # Create log entry
    local log_entry=$(jq -nc \
        --arg timestamp "$timestamp" \
        --arg session_id "$session_id" \
        --arg repo_path "$cwd" \
        --arg client "$client" \
        --arg reason "$reason" \
        --arg model "$model" \
        --argjson input_tokens "$input_tokens" \
        --argjson output_tokens "$output_tokens" \
        --argjson cache_creation "$cache_creation_tokens" \
        --argjson cache_read "$cache_read_tokens" \
        --argjson total "$total_tokens" \
        '{
            timestamp: $timestamp,
            session_id: $session_id,
            repo_path: $repo_path,
            client: $client,
            reason: $reason,
            model: $model,
            tokens: {
                input: $input_tokens,
                output: $output_tokens,
                cache_creation: $cache_creation,
                cache_read: $cache_read,
                total: $total
            }
        }')
    
    # Create repo slug
    local repo_slug=$(echo "$cwd" | sed 's|/|_|g' | sed 's|^_||')
    local repo_log="$TOKEN_DIR/${repo_slug}.jsonl"
    
    # Append to logs
    echo "$log_entry" >> "$repo_log"
    echo "$log_entry" >> "$TOKEN_DIR/all-repos.jsonl"
    
    # Mark as tracked
    mark_tracked "$tracking_id"
    
    echo "Tracked: $model - $total_tokens tokens ($reason) - $cwd"
}

# Main execution
echo "Scanning for untracked Claude Code sessions..."
echo ""

# Find all transcript files
total_processed=0
total_new=0

while IFS= read -r -d '' transcript || [ -n "$transcript" ]; do
    # Skip empty entries
    [ -z "$transcript" ] && continue
    
    total_processed=$((total_processed + 1))
    
    # Check if this is a subagent
    is_subagent="false"
    if [[ "$transcript" == */subagents/* ]]; then
        is_subagent="true"
    fi
    
    # Get current tracked count
    before_count=$(wc -l < "$TRACKED_FILE" 2>/dev/null || echo "0")
    
    # Process the transcript (catch errors and continue)
    if ! process_transcript "$transcript" "$is_subagent" 2>&1; then
        echo "Warning: Failed to process $transcript" >&2
    fi
    
    # Check if we added a new entry
    after_count=$(wc -l < "$TRACKED_FILE" 2>/dev/null || echo "0")
    if [ "$after_count" -gt "$before_count" ]; then
        total_new=$((total_new + 1))
    fi
done < <(find "$PROJECTS_DIR" -name "*.jsonl" -type f -print0 2>/dev/null || true)

echo ""
echo "Done!"
echo "Processed: $total_processed transcripts"
echo "New sessions tracked: $total_new"
