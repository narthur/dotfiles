#!/usr/bin/env bash
# Install launchd user agents from ~/.config/launchd/*.plist and create
# necessary directories. The launchd analog of setup-cron.
set -e

echo "Setting up launchd agents..."

mkdir -p "$HOME/.local/log"
echo "  Created $HOME/.local/log"

mkdir -p "$HOME/Library/LaunchAgents"

shopt -s nullglob
domain="gui/$(id -u)"

for template in "$HOME/.config/launchd/"*.plist; do
    name="$(basename "$template")"
    label="${name%.plist}"
    dest="$HOME/Library/LaunchAgents/$name"

    # Only ${HOME} is templated; leave everything else literal.
    envsubst '${HOME}' < "$template" > "$dest"
    echo "  Installed $dest"

    # Unload any existing instance, then wait for it to actually disappear.
    # bootout is async; bootstrapping too soon races and fails with
    # "5: Input/output error" (common with KeepAlive agents like aw-qt).
    launchctl bootout "$domain/$label" 2>/dev/null || true
    for _ in $(seq 1 20); do
        launchctl print "$domain/$label" &>/dev/null || break
        sleep 0.3
    done

    if launchctl bootstrap "$domain" "$dest" 2>/dev/null; then
        echo "  Loaded $label"
    else
        # Still registered (transient) — force a restart instead of failing.
        if launchctl kickstart -k "$domain/$label" 2>/dev/null; then
            echo "  Reloaded $label (kickstart)"
        else
            echo "  WARN: could not (re)load $label" >&2
        fi
    fi
done

echo ""
echo "Done! Loaded agents:"
launchctl list | grep -E "com\.narthur\.|net\.activitywatch\." || echo "  (none)"
