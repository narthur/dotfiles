#!/usr/bin/env bash
# Wrapper around gh that auto-injects --draft into `gh pr create`

# The first gh on PATH that isn't this wrapper (/usr/bin on Linux, Homebrew on mac).
self=$(realpath "$0")
REAL_GH=$(type -ap gh | while read -r p; do [ "$(realpath "$p")" != "$self" ] && { echo "$p"; break; }; done)
[ -n "$REAL_GH" ] || { echo "gh wrapper: no real gh on PATH" >&2; exit 127; }

args=("$@")

if [[ "$1" == "pr" && "$2" == "create" ]]; then
    has_draft=false
    for arg in "${args[@]}"; do
        [[ "$arg" == "--draft" || "$arg" == "-d" ]] && has_draft=true
    done
    if ! $has_draft; then
        args=("pr" "create" "--draft" "${args[@]:2}")
    fi
fi

exec "$REAL_GH" "${args[@]}"
