#!/bin/bash
# List listening TCP ports: PORT PID DIR. Skips apps started from / and Claude Code sessions.
echo "PORT   PID     DIR"
lsof -iTCP -sTCP:LISTEN -n -P -Fpcn 2>/dev/null | awk '
  /^p/ {pid=substr($0,2)} /^c/ {cmd=substr($0,2)}
  /^n/ {port=$0; sub(/.*:/,"",port); if (!seen[pid":"port]++) print port, pid, cmd}' |
while read -r port pid cmd; do
  [[ $cmd =~ ^(claude|[0-9]+\.[0-9]+\.[0-9]+)$ ]] && continue
  dir=$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')
  [[ $dir == "$HOME"* ]] && dir="~${dir#$HOME}"
  [[ -z $dir || $dir == / ]] && continue
  printf '%-6s %-7s %s\n' "$port" "$pid" "$dir"
done | sort -n
