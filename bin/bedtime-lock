#!/usr/bin/env bash
# Linux stand-in for macOS Screen Time Downtime (21:00-05:00, snoozable).
# Started by i3 so it inherits DISPLAY. During downtime it asks every minute;
# "Snooze 15m" buys 15 minutes, anything else (incl. ignoring it for 60s) locks.
# Minutes still get reported to Beeminder `abed` by bedtime-beemind either way.
while true; do
    now=$(date +%H%M)
    # ponytail: window hardcoded here and in bedtime-beemind; share a config if they need to move together
    if [ "$now" -ge 2100 ] || [ "$now" -lt 0500 ]; then
        if zenity --question --title=Bedtime --timeout=60 \
            --text="It's past 21:00. Time to stop." \
            --ok-label="Snooze 15m" --cancel-label="Lock now"; then
            sleep 900
            continue
        fi
        loginctl lock-session
    fi
    sleep 60
done
