#!/usr/bin/env bash

# create-pr-stack - Analyze uncommitted changes and suggest PR stack groupings
# Usage:
#   create-pr-stack [--max-partitions N] [--verbose] [--json]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

MAX_PARTITIONS=50
VERBOSE=false
JSON_OUTPUT=false

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --max-partitions|-m)
      MAX_PARTITIONS="$2"
      shift 2
      ;;
    --verbose|-v)
      VERBOSE=true
      shift
      ;;
    --json|-j)
      JSON_OUTPUT=true
      shift
      ;;
    -h|--help)
      cat <<EOF
Usage: $0 [options]

Analyzes uncommitted git changes and suggests ways to partition them into
valid PR stacks using .stacker/verify.sh for validation.

Options:
  --max-partitions|-m N   Limit number of partition combinations to try (default: 50)
  --verbose|-v            Show detailed verification output
  --json|-j               Output results as JSON
  -h, --help              Show this help

The script requires:
  - Running in a git repository
  - .stacker/verify.sh to exist in the repository root
  - Uncommitted changes to analyze

Examples:
  $0
  $0 --verbose
  $0 --max-partitions 100 --json
EOF
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

echo "DEBUG: Checking if in git repository" >&2
# Check if we're in a git repository
if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "Error: Not in a git repository" >&2
  exit 1
fi
echo "DEBUG: In git repository" >&2

# Get repository root
echo "DEBUG: Getting repository root" >&2
REPO_ROOT="$(git rev-parse --show-toplevel)"
echo "DEBUG: Repository root: $REPO_ROOT" >&2
VERIFY_SCRIPT="$REPO_ROOT/.stacker/verify.sh"
echo "DEBUG: Verify script path: $VERIFY_SCRIPT" >&2

# Check if verify script exists
echo "DEBUG: Checking if verify script exists" >&2
if [[ ! -f "$VERIFY_SCRIPT" ]]; then
  echo "Error: .stacker/verify.sh not found in repository root" >&2
  echo "       Expected: $VERIFY_SCRIPT" >&2
  exit 1
fi
echo "DEBUG: Verify script exists" >&2

# Check if verify script is executable
echo "DEBUG: Checking if verify script is executable" >&2
if [[ ! -x "$VERIFY_SCRIPT" ]]; then
  echo "Warning: .stacker/verify.sh is not executable, attempting to make it executable" >&2
  chmod +x "$VERIFY_SCRIPT" || {
    echo "Error: Could not make verify script executable" >&2
    exit 1
  }
fi
echo "DEBUG: Verify script is executable" >&2

# Get uncommitted changes (modified, added, deleted files)
get_uncommitted_changes() {
  git diff --name-only --diff-filter=ACDMR
}

# Generate partitions of files
# Strategy: Start simple - one file per PR, all files together, then try combinations
generate_partitions() {
  local files=("$@")
  local num_files=${#files[@]}
  local partitions=()
  local count=0

  if [[ $num_files -eq 0 ]]; then
    return
  fi

  # Strategy 1: One file per PR
  for file in "${files[@]}"; do
    if [[ $count -ge $MAX_PARTITIONS ]]; then
      break
    fi
    partitions+=("$file")
    ((count++))
  done

  # Strategy 2: All files together
  if [[ $count -lt $MAX_PARTITIONS ]]; then
    local all_files=$(IFS='|'; echo "${files[*]}")
    partitions+=("$all_files")
    ((count++))
  fi

  # Strategy 3: Try grouping by directory
  if [[ $count -lt $MAX_PARTITIONS ]] && [[ $num_files -gt 1 ]]; then
    declare -A dir_groups
    for file in "${files[@]}"; do
      dir=$(dirname "$file")
      if [[ -z "${dir_groups[$dir]:-}" ]]; then
        dir_groups[$dir]="$file"
      else
        dir_groups[$dir]="${dir_groups[$dir]}|$file"
      fi
    done
    for group in "${dir_groups[@]}"; do
      if [[ $count -ge $MAX_PARTITIONS ]]; then
        break
      fi
      partitions+=("$group")
      ((count++))
    done
  fi

  # Strategy 4: Try random combinations (up to limit)
  if [[ $count -lt $MAX_PARTITIONS ]] && [[ $num_files -gt 2 ]]; then
    local max_combos=$((MAX_PARTITIONS - count))
    local combo_count=0
    # Try splitting into 2 groups
    for ((i=1; i<num_files && combo_count<max_combos; i++)); do
      local group1=$(IFS='|'; echo "${files[*]:0:$i}")
      local group2=$(IFS='|'; echo "${files[*]:$i}")
      partitions+=("$group1")
      partitions+=("$group2")
      ((combo_count += 2))
      if [[ $combo_count -ge $max_combos ]]; then
        break
      fi
    done
  fi

  # Output partitions (each line is a partition, files separated by |)
  printf '%s\n' "${partitions[@]}"
}

# Verify a partition by creating temp directory and running verify.sh
verify_partition() {
  local partition_files="$1"
  echo "DEBUG verify_partition: Starting verification for: $partition_files" >&2
  local temp_dir
  temp_dir=$(mktemp -d)
  echo "DEBUG verify_partition: Created temp dir: $temp_dir" >&2
  local exit_code=1
  local use_worktree=false

  # Cleanup function
  cleanup() {
    if [[ -n "${temp_dir:-}" ]] && [[ -d "$temp_dir" ]]; then
      if [[ "$use_worktree" == "true" ]] && [[ -d "$REPO_ROOT" ]]; then
        (cd "$REPO_ROOT" && git worktree remove "$temp_dir" >/dev/null 2>&1) || true
      fi
      rm -rf "$temp_dir" 2>/dev/null || true
    fi
  }
  trap cleanup EXIT

  # Create a worktree or clone for testing
  # Use git worktree if available, otherwise clone
  echo "DEBUG verify_partition: Attempting to create worktree" >&2
  local worktree_error
  worktree_error=$(cd "$REPO_ROOT" && git worktree add "$temp_dir" HEAD 2>&1)
  local worktree_exit=$?
  echo "DEBUG verify_partition: Worktree add exit code: $worktree_exit" >&2
  if [[ $worktree_exit -eq 0 ]]; then
    use_worktree=true
    echo "DEBUG verify_partition: Worktree created successfully" >&2
  else
    use_worktree=false
    echo "DEBUG verify_partition: Worktree failed: $worktree_error" >&2
    # If worktree failed, try to remove any existing one and retry once
    if echo "$worktree_error" | grep -q "already exists\|already checked out"; then
      echo "DEBUG verify_partition: Worktree already exists, cleaning up and retrying" >&2
      (cd "$REPO_ROOT" && git worktree remove "$temp_dir" --force >/dev/null 2>&1) || true
      rm -rf "$temp_dir" 2>/dev/null || true
      temp_dir=$(mktemp -d)
      echo "DEBUG verify_partition: New temp dir: $temp_dir" >&2
      if (cd "$REPO_ROOT" && git worktree add "$temp_dir" HEAD >/dev/null 2>&1); then
        use_worktree=true
        echo "DEBUG verify_partition: Worktree created on retry" >&2
      else
        echo "DEBUG verify_partition: Worktree retry also failed" >&2
      fi
    fi
    
    # Clone to temp directory if worktree still didn't work
    if [[ "$use_worktree" != "true" ]]; then
      if ! (cd "$REPO_ROOT" && git clone -q --shared --no-checkout . "$temp_dir" >/dev/null 2>&1); then
        # Fallback: create new repo and checkout files
        (cd "$temp_dir" && git init -q && \
          git config user.email "stacker@example.com" && \
          git config user.name "Stacker") || {
          cleanup
          trap - EXIT
          return 1
        }
        if ! (cd "$REPO_ROOT" && git checkout-index -a -f --prefix="$temp_dir/" >/dev/null 2>&1); then
          # Last resort: copy files manually
          (cd "$REPO_ROOT" && find . -mindepth 1 -maxdepth 1 ! -name '.git' -exec cp -r {} "$temp_dir/" \; >/dev/null 2>&1) || true
        fi
        (cd "$temp_dir" && git add -A >/dev/null 2>&1 && \
          git commit -q -m "base" --allow-empty >/dev/null 2>&1) || true
      fi
    fi
  fi
  
  if [[ ! -d "$temp_dir" ]]; then
    echo "DEBUG verify_partition: Temp directory does not exist: $temp_dir" >&2
    cleanup
    trap - EXIT
    return 1
  fi
  
  echo "DEBUG verify_partition: Temp directory exists, applying changes" >&2
  # Apply only the changes for this partition
  IFS='|' read -ra files <<< "$partition_files"
  echo "DEBUG verify_partition: Files to apply: ${#files[@]}" >&2
  for file in "${files[@]}"; do
    if [[ -f "$REPO_ROOT/$file" ]]; then
      # Copy the modified version from working directory
      local file_dir
      file_dir=$(dirname "$file")
      if [[ "$file_dir" != "." ]]; then
        mkdir -p "$temp_dir/$file_dir" 2>/dev/null || true
      fi
      cp "$REPO_ROOT/$file" "$temp_dir/$file" 2>/dev/null || true
    elif [[ -f "$temp_dir/$file" ]]; then
      # File exists in temp but not in working dir - it was deleted
      rm -f "$temp_dir/$file" 2>/dev/null || true
    fi
  done
  
  # Stage all changes
  (cd "$temp_dir" && git add -A >/dev/null 2>&1) || true
  
  # Run verify.sh
  echo "DEBUG verify_partition: Looking for verify script" >&2
  local verify_script
  if [[ -f "$temp_dir/.stacker/verify.sh" ]]; then
    verify_script="$temp_dir/.stacker/verify.sh"
    echo "DEBUG verify_partition: Found verify script in temp dir: $verify_script" >&2
  elif [[ -f "$VERIFY_SCRIPT" ]]; then
    verify_script="$VERIFY_SCRIPT"
    echo "DEBUG verify_partition: Using verify script from repo: $verify_script" >&2
  else
    echo "DEBUG verify_partition: ERROR - verify script not found" >&2
    echo "DEBUG verify_partition: Checked: $temp_dir/.stacker/verify.sh and $VERIFY_SCRIPT" >&2
    if [[ "$VERBOSE" == "true" ]]; then
      echo "Error: verify script not found" >&2
    fi
    cleanup
    trap - EXIT
    return 1
  fi
  
  if [[ ! -x "$verify_script" ]]; then
    echo "DEBUG verify_partition: Making verify script executable" >&2
    chmod +x "$verify_script" 2>/dev/null || true
  fi
  
  echo "DEBUG verify_partition: Running verify script: $verify_script" >&2
  if [[ "$VERBOSE" == "true" ]]; then
    if (cd "$temp_dir" && bash "$verify_script" >&2); then
      exit_code=0
      echo "DEBUG verify_partition: Verify script succeeded" >&2
    else
      echo "DEBUG verify_partition: Verify script failed" >&2
    fi
  else
    if (cd "$temp_dir" && bash "$verify_script" >/dev/null 2>&1); then
      exit_code=0
      echo "DEBUG verify_partition: Verify script succeeded" >&2
    else
      echo "DEBUG verify_partition: Verify script failed" >&2
    fi
  fi

  cleanup
  trap - EXIT
  return $exit_code
}

# Verify a stack (ordered list of partitions)
verify_stack() {
  local partitions=("$@")
  local num_prs=${#partitions[@]}
  local temp_dir
  temp_dir=$(mktemp -d)
  local exit_code=1
  local use_worktree=false

  # Cleanup function
  cleanup() {
    if [[ -n "${temp_dir:-}" ]] && [[ -d "$temp_dir" ]]; then
      if [[ "$use_worktree" == "true" ]] && [[ -d "$REPO_ROOT" ]]; then
        (cd "$REPO_ROOT" && git worktree remove "$temp_dir" >/dev/null 2>&1) || true
      fi
      rm -rf "$temp_dir" 2>/dev/null || true
    fi
  }
  trap cleanup EXIT

  # Set up temp repo using worktree if available
  local worktree_error
  worktree_error=$(cd "$REPO_ROOT" && git worktree add "$temp_dir" HEAD 2>&1)
  if [[ $? -eq 0 ]]; then
    use_worktree=true
  else
    use_worktree=false
    # If worktree failed, try to remove any existing one and retry once
    if echo "$worktree_error" | grep -q "already exists\|already checked out"; then
      (cd "$REPO_ROOT" && git worktree remove "$temp_dir" --force >/dev/null 2>&1) || true
      rm -rf "$temp_dir" 2>/dev/null || true
      temp_dir=$(mktemp -d)
      if (cd "$REPO_ROOT" && git worktree add "$temp_dir" HEAD >/dev/null 2>&1); then
        use_worktree=true
      fi
    fi
    
    # Clone to temp directory if worktree still didn't work
    if [[ "$use_worktree" != "true" ]]; then
      if ! (cd "$REPO_ROOT" && git clone -q --shared --no-checkout . "$temp_dir" >/dev/null 2>&1); then
        # Fallback: create new repo and checkout files
        (cd "$temp_dir" && git init -q && \
          git config user.email "stacker@example.com" && \
          git config user.name "Stacker") || {
          cleanup
          trap - EXIT
          return 1
        }
        if ! (cd "$REPO_ROOT" && git checkout-index -a -f --prefix="$temp_dir/" >/dev/null 2>&1); then
          (cd "$REPO_ROOT" && find . -mindepth 1 -maxdepth 1 ! -name '.git' -exec cp -r {} "$temp_dir/" \; >/dev/null 2>&1) || true
        fi
        (cd "$temp_dir" && git add -A >/dev/null 2>&1 && \
          git commit -q -m "base" --allow-empty >/dev/null 2>&1) || true
      fi
    fi
  fi
  
  if [[ ! -d "$temp_dir" ]]; then
    cleanup
    trap - EXIT
    return 1
  fi
  
  # Apply each PR in sequence
  for ((i=0; i<num_prs; i++)); do
    local partition="${partitions[$i]}"
    IFS='|' read -ra files <<< "$partition"
    
    # Apply changes for this PR
    for file in "${files[@]}"; do
      if [[ -f "$REPO_ROOT/$file" ]]; then
        local file_dir
        file_dir=$(dirname "$file")
        if [[ "$file_dir" != "." ]]; then
          mkdir -p "$temp_dir/$file_dir" 2>/dev/null || true
        fi
        cp "$REPO_ROOT/$file" "$temp_dir/$file" 2>/dev/null || true
      elif [[ -f "$temp_dir/$file" ]]; then
        # File exists in temp but not in working dir - it was deleted
        rm -f "$temp_dir/$file" 2>/dev/null || true
      fi
    done
    
    (cd "$temp_dir" && git add -A >/dev/null 2>&1) || true
    
    # Verify this PR on top of previous PRs
    local verify_script
    if [[ -f "$temp_dir/.stacker/verify.sh" ]]; then
      verify_script="$temp_dir/.stacker/verify.sh"
    elif [[ -f "$VERIFY_SCRIPT" ]]; then
      verify_script="$VERIFY_SCRIPT"
    else
      cleanup
      trap - EXIT
      return 1
    fi
    
    if [[ ! -x "$verify_script" ]]; then
      chmod +x "$verify_script" 2>/dev/null || true
    fi
    
    if [[ "$VERBOSE" == "true" ]]; then
      if ! (cd "$temp_dir" && bash "$verify_script" >&2); then
        cleanup
        trap - EXIT
        return 1
      fi
    else
      if ! (cd "$temp_dir" && bash "$verify_script" >/dev/null 2>&1); then
        cleanup
        trap - EXIT
        return 1
      fi
    fi
  done

  cleanup
  trap - EXIT
  return 0
}

# Report valid stacks
report_stacks() {
  local valid_stacks=("$@")
  local num_stacks=${#valid_stacks[@]}

  if [[ "$JSON_OUTPUT" == "true" ]]; then
    echo "["
    for ((i=0; i<num_stacks; i++)); do
      local stack="${valid_stacks[$i]}"
      echo -n "  {"
      echo -n "\"stack_number\": $((i+1)),"
      echo -n "\"prs\": ["
      
      local first=true
      local pr_num=1
      while IFS= read -r partition; do
        if [[ -n "$partition" ]]; then
          if [[ "$first" == "true" ]]; then
            first=false
          else
            echo -n ","
          fi
          echo -n "{\"pr\": $pr_num, \"files\": ["
          IFS='|' read -ra files <<< "$partition"
          local first_file=true
          for file in "${files[@]}"; do
            if [[ "$first_file" == "true" ]]; then
              first_file=false
            else
              echo -n ","
            fi
            echo -n "\"$file\""
          done
          echo -n "]}"
          ((pr_num++))
        fi
      done <<< "$stack"
      
      echo -n "]"
      echo -n "}"
      if [[ $i -lt $((num_stacks - 1)) ]]; then
        echo ","
      else
        echo
      fi
    done
    echo "]"
  else
    echo "Found $num_stacks valid PR stack(s):"
    echo ""
    
    for ((i=0; i<num_stacks; i++)); do
      local stack="${valid_stacks[$i]}"
      echo "Stack $((i+1)):"
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      
      local pr_num=1
      while IFS= read -r partition; do
        if [[ -n "$partition" ]]; then
          echo "PR$pr_num:"
          IFS='|' read -ra files <<< "$partition"
          for file in "${files[@]}"; do
            echo "  - $file"
          done
          echo ""
          ((pr_num++))
        fi
      done <<< "$stack"
      
      if [[ $i -lt $((num_stacks - 1)) ]]; then
        echo ""
      fi
    done
  fi
}

# Clean up any leftover worktrees from previous runs
cleanup_worktrees() {
  if [[ -d "$REPO_ROOT/.git/worktrees" ]]; then
    local worktrees
    worktrees=$(cd "$REPO_ROOT" && git worktree list --porcelain 2>/dev/null | grep -E "^worktree " | cut -d' ' -f2- || true)
    if [[ -n "$worktrees" ]]; then
      while IFS= read -r wt_path; do
        if [[ -n "$wt_path" ]] && [[ "$wt_path" == /tmp/* ]]; then
          if [[ "$VERBOSE" == "true" ]]; then
            echo "Cleaning up leftover worktree: $wt_path" >&2
          fi
          (cd "$REPO_ROOT" && git worktree remove "$wt_path" --force >/dev/null 2>&1) || true
          rm -rf "$wt_path" 2>/dev/null || true
        fi
      done <<< "$worktrees"
    fi
  fi
}

# Main execution
main() {
  echo "DEBUG: Starting main()" >&2
  
  # Set up trap to clean up on exit
  trap 'cleanup_worktrees' EXIT INT TERM
  echo "DEBUG: Trap set" >&2
  
  # Clean up any leftover worktrees from previous runs
  echo "DEBUG: Cleaning up worktrees" >&2
  cleanup_worktrees
  echo "DEBUG: Worktree cleanup complete" >&2
  
  # Get uncommitted changes
  echo "DEBUG: Getting uncommitted changes" >&2
  local changed_files
  if ! changed_files=($(get_uncommitted_changes)); then
    echo "Error: Failed to get uncommitted changes" >&2
    exit 1
  fi
  echo "DEBUG: Got ${#changed_files[@]} changed files" >&2
  
  if [[ ${#changed_files[@]} -eq 0 ]]; then
    if [[ "$JSON_OUTPUT" == "true" ]]; then
      echo '{"error": "No uncommitted changes found"}' 
    else
      echo "No uncommitted changes found."
      echo "Make some changes to your files and try again."
    fi
    exit 0
  fi

  if [[ "$VERBOSE" == "true" ]]; then
    echo "Analyzing ${#changed_files[@]} changed file(s):" >&2
    for file in "${changed_files[@]}"; do
      echo "  - $file" >&2
    done
    echo "" >&2
  fi

  # Generate partitions
  echo "DEBUG: Generating partitions" >&2
  local partitions
  set +e  # Temporarily disable exit on error
  partitions=($(generate_partitions "${changed_files[@]}" 2>&1))
  local gen_exit=$?
  set -e  # Re-enable exit on error
  echo "DEBUG: Partition generation exit code: $gen_exit" >&2
  echo "DEBUG: Generated ${#partitions[@]} partitions" >&2
  
  if [[ $gen_exit -ne 0 ]]; then
    echo "Error: Failed to generate partitions (exit code: $gen_exit)" >&2
    exit 1
  fi
  
  if [[ ${#partitions[@]} -eq 0 ]]; then
    if [[ "$JSON_OUTPUT" == "true" ]]; then
      echo '{"error": "Could not generate partitions"}' 
    else
      echo "Error: Could not generate partitions" >&2
    fi
    exit 1
  fi

  if [[ "$VERBOSE" == "true" ]]; then
    echo "Generated ${#partitions[@]} partition(s) to test" >&2
    echo "" >&2
  fi

  # Verify each partition standalone
  echo "DEBUG: Starting partition verification" >&2
  local valid_partitions=()
  local total_partitions=${#partitions[@]}
  local partition_num=0
  
  if [[ $total_partitions -eq 0 ]]; then
    echo "Error: No partitions to verify" >&2
    exit 1
  fi
  
  echo "DEBUG: Will verify $total_partitions partitions" >&2
  echo "DEBUG: First partition: ${partitions[0]:-empty}" >&2
  echo "DEBUG: Array length: ${#partitions[@]}" >&2
  
  # Check if array is actually populated
  if [[ ${#partitions[@]} -eq 0 ]]; then
    echo "DEBUG: ERROR - partitions array is empty!" >&2
    exit 1
  fi
  
  # Debug: Show first few partitions
  echo "DEBUG: First 3 partitions:" >&2
  for i in 0 1 2; do
    if [[ $i -lt ${#partitions[@]} ]]; then
      echo "DEBUG:   partitions[$i]='${partitions[$i]}'" >&2
    fi
  done
  
  echo "DEBUG: Starting for loop" >&2
  set +e  # Disable exit on error for loop
  for partition in "${partitions[@]}"; do
    set -e  # Re-enable for the loop body
    echo "DEBUG: Loop iteration, partition_num before increment: $partition_num" >&2
    ((partition_num++)) || {
      echo "DEBUG: Arithmetic expansion failed, continuing anyway" >&2
      partition_num=$((partition_num + 1))
    }
    echo "DEBUG: Processing partition $partition_num of $total_partitions" >&2
    echo "DEBUG: Partition content: $partition" >&2
    
    if [[ "$VERBOSE" == "true" ]]; then
      echo "Verifying partition $partition_num of $total_partitions: $partition" >&2
    else
      echo "Verifying partition $partition_num of $total_partitions..." >&2
    fi
    
    # Temporarily disable exit on error for this check
    echo "DEBUG: Disabling exit on error" >&2
    set +e
    echo "DEBUG: Calling verify_partition" >&2
    if verify_partition "$partition" 2>&1; then
      echo "DEBUG: verify_partition returned success" >&2
      valid_partitions+=("$partition")
      echo "  ✓ Valid" >&2
    else
      local verify_exit=$?
      echo "DEBUG: verify_partition returned failure, exit code: $verify_exit" >&2
      echo "  ✗ Invalid" >&2
      # Continue even if verification had an error (not just invalid result)
      if [[ $verify_exit -gt 1 ]]; then
        echo "  Warning: Verification encountered an error (exit code: $verify_exit)" >&2
      fi
    fi
    echo "DEBUG: Re-enabling exit on error" >&2
    set -e  # Re-enable exit on error
    echo "DEBUG: Finished processing partition $partition_num" >&2
    set +e  # Disable again for next iteration
  done
  set -e  # Re-enable after loop
  echo "DEBUG: Finished all partition verifications" >&2

  if [[ ${#valid_partitions[@]} -eq 0 ]]; then
    if [[ "$JSON_OUTPUT" == "true" ]]; then
      echo '{"error": "No valid partitions found", "message": "All partition attempts failed verification"}' 
    else
      echo "No valid partitions found."
      echo "All partition attempts failed verification by .stacker/verify.sh"
      echo ""
      echo "This could mean:"
      echo "  - The changes cannot be split into standalone PRs"
      echo "  - The verify script is too strict"
      echo "  - All changes must be in a single PR"
    fi
    exit 0
  fi

  echo "" >&2
  echo "Partition verification complete: ${#valid_partitions[@]} of $total_partitions partition(s) are valid" >&2
  if [[ "$VERBOSE" != "true" ]]; then
    echo "Testing stack orderings..." >&2
  else
    echo "" >&2
    echo "Found ${#valid_partitions[@]} valid partition(s)" >&2
    echo "Testing stack orderings..." >&2
    echo "" >&2
  fi

  # Try different stack orderings with valid partitions
  local valid_stacks=()
  local num_valid=${#valid_partitions[@]}

  # If only one valid partition, it's a valid stack
  if [[ $num_valid -eq 1 ]]; then
    valid_stacks+=("${valid_partitions[0]}")
  else
    # Calculate total stack orderings to test
    local max_stack_tests=$((num_valid + 1))  # original + reverse + one per partition as first
    if [[ $max_stack_tests -gt 10 ]]; then
      max_stack_tests=10
    fi
    local stack_test_num=0
    
    # Try all permutations of valid partitions (up to reasonable limit)
    # For now, try simple orderings: original order and reverse
    ((stack_test_num++))
    echo "Testing stack ordering $stack_test_num of $max_stack_tests (original order)..." >&2
    if verify_stack "${valid_partitions[@]}"; then
      local stack=$(IFS=$'\n'; echo "${valid_partitions[*]}")
      valid_stacks+=("$stack")
      echo "  ✓ Valid stack" >&2
    else
      echo "  ✗ Invalid stack" >&2
    fi
    
    # Try reverse order
    local reversed=()
    for ((i=$((num_valid-1)); i>=0; i--)); do
      reversed+=("${valid_partitions[$i]}")
    done
    ((stack_test_num++))
    echo "Testing stack ordering $stack_test_num of $max_stack_tests (reverse order)..." >&2
    if verify_stack "${reversed[@]}"; then
      local stack=$(IFS=$'\n'; echo "${reversed[*]}")
      # Check if we already have this stack
      local found=false
      for existing in "${valid_stacks[@]}"; do
        if [[ "$existing" == "$stack" ]]; then
          found=true
          break
        fi
      done
      if [[ "$found" == "false" ]]; then
        valid_stacks+=("$stack")
        echo "  ✓ Valid stack" >&2
      else
        echo "  ✓ Valid stack (duplicate)" >&2
      fi
    else
      echo "  ✗ Invalid stack" >&2
    fi

    # Try each partition as the first PR, with others following
    for ((first=0; first<num_valid && ${#valid_stacks[@]}<10 && stack_test_num<max_stack_tests; first++)); do
      local stack_order=("${valid_partitions[$first]}")
      for ((other=0; other<num_valid; other++)); do
        if [[ $other -ne $first ]]; then
          stack_order+=("${valid_partitions[$other]}")
        fi
      done
      ((stack_test_num++))
      echo "Testing stack ordering $stack_test_num of $max_stack_tests (partition $((first+1)) first)..." >&2
      if verify_stack "${stack_order[@]}"; then
        local stack=$(IFS=$'\n'; echo "${stack_order[*]}")
        # Check for duplicates
        local found=false
        for existing in "${valid_stacks[@]}"; do
          if [[ "$existing" == "$stack" ]]; then
            found=true
            break
          fi
        done
        if [[ "$found" == "false" ]]; then
          valid_stacks+=("$stack")
          echo "  ✓ Valid stack" >&2
        else
          echo "  ✓ Valid stack (duplicate)" >&2
        fi
      else
        echo "  ✗ Invalid stack" >&2
      fi
    done
  fi

  echo "" >&2
  echo "Stack verification complete: found ${#valid_stacks[@]} valid stack(s)" >&2
  echo "" >&2

  # Report results
  if [[ ${#valid_stacks[@]} -eq 0 ]]; then
    if [[ "$JSON_OUTPUT" == "true" ]]; then
      echo '{"error": "No valid stacks found", "message": "Valid partitions exist but no valid orderings found"}' 
    else
      echo "No valid PR stacks found."
      echo ""
      echo "Found ${#valid_partitions[@]} valid partition(s), but no valid stack orderings."
      echo "This could mean the partitions have dependencies that prevent stacking."
    fi
    exit 0
  fi

  report_stacks "${valid_stacks[@]}"
}

main "$@"

