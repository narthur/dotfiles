#!/usr/bin/env bash

# create-pr-stack - Analyze uncommitted changes and suggest PR stack groupings
# Usage:
#   create-pr-stack [--max-partitions N] [--verbose] [--json]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

MAX_PARTITIONS=50
VERBOSE=false
JSON_OUTPUT=false

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --max-partitions|-m)
      MAX_PARTITIONS="$2"
      shift 2
      ;;
    --verbose|-v)
      VERBOSE=true
      shift
      ;;
    --json|-j)
      JSON_OUTPUT=true
      shift
      ;;
    -h|--help)
      cat <<EOF
Usage: $0 [options]

Analyzes uncommitted git changes and suggests ways to partition them into
valid PR stacks using .stacker/verify.sh for validation.

Options:
  --max-partitions|-m N   Limit number of partition combinations to try (default: 50)
  --verbose|-v            Show detailed verification output
  --json|-j               Output results as JSON
  -h, --help              Show this help

The script requires:
  - Running in a git repository
  - .stacker/verify.sh to exist in the repository root
  - Uncommitted changes to analyze

Examples:
  $0
  $0 --verbose
  $0 --max-partitions 100 --json
EOF
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

# Check if we're in a git repository
if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "Error: Not in a git repository" >&2
  exit 1
fi

# Get repository root
REPO_ROOT="$(git rev-parse --show-toplevel)"
VERIFY_SCRIPT="$REPO_ROOT/.stacker/verify.sh"

# Check if verify script exists
if [[ ! -f "$VERIFY_SCRIPT" ]]; then
  echo "Error: .stacker/verify.sh not found in repository root" >&2
  echo "       Expected: $VERIFY_SCRIPT" >&2
  exit 1
fi

# Check if verify script is executable
if [[ ! -x "$VERIFY_SCRIPT" ]]; then
  echo "Warning: .stacker/verify.sh is not executable, attempting to make it executable" >&2
  chmod +x "$VERIFY_SCRIPT" || {
    echo "Error: Could not make verify script executable" >&2
    exit 1
  }
fi

# Get uncommitted changes (modified, added, deleted files)
get_uncommitted_changes() {
  git diff --name-only --diff-filter=ACDMR
}

# Verify entire change set - exit immediately if invalid
verify_entire_changeset() {
  local all_files
  all_files=($(get_uncommitted_changes))
  
  if [[ ${#all_files[@]} -eq 0 ]]; then
    echo "No uncommitted changes found." >&2
    return 1
  fi
  
  # Create a partition string with all files
  local all_files_str=$(IFS='|'; echo "${all_files[*]}")
  
  # Verify using the same mechanism as verify_partition
  if verify_partition "$all_files_str"; then
    return 0
  else
    return 1
  fi
}

# Generator state (global variables)
GENERATOR_FILES=()
GENERATOR_STATE="single"  # single, two, directory, larger, all, done
GENERATOR_INDEX=0
GENERATOR_DIR_GROUPS=()
GENERATOR_DIR_INDEX=0
GENERATOR_COMBO_INDEX=1
GENERATOR_COUNT=0

# Initialize partition generator
init_partition_generator() {
  GENERATOR_FILES=("$@")
  GENERATOR_STATE="single"
  GENERATOR_INDEX=0
  GENERATOR_DIR_GROUPS=()
  GENERATOR_DIR_INDEX=0
  GENERATOR_COMBO_INDEX=1
  GENERATOR_COUNT=0
  
  # Pre-compute directory groups
  if [[ ${#GENERATOR_FILES[@]} -gt 1 ]]; then
    declare -A dir_groups
    for file in "${GENERATOR_FILES[@]}"; do
      dir=$(dirname "$file")
      if [[ -z "${dir_groups[$dir]:-}" ]]; then
        dir_groups[$dir]="$file"
      else
        dir_groups[$dir]="${dir_groups[$dir]}|$file"
      fi
    done
    GENERATOR_DIR_GROUPS=("${dir_groups[@]}")
  fi
}

# Generate next partition (returns partition string or empty if done)
generate_next_partition() {
  local num_files=${#GENERATOR_FILES[@]}
  
  if [[ $num_files -eq 0 ]]; then
    return 1
  fi
  
  # Strategy 1: Single-file partitions
  if [[ "$GENERATOR_STATE" == "single" ]]; then
    if [[ $GENERATOR_INDEX -lt $num_files ]] && [[ $GENERATOR_COUNT -lt $MAX_PARTITIONS ]]; then
      local partition="${GENERATOR_FILES[$GENERATOR_INDEX]}"
      ((GENERATOR_INDEX++))
      ((GENERATOR_COUNT++))
      echo "$partition"
      return 0
    else
      GENERATOR_STATE="two"
      GENERATOR_INDEX=0
    fi
  fi
  
  # Strategy 2: Two-file combinations
  if [[ "$GENERATOR_STATE" == "two" ]]; then
    if [[ $GENERATOR_COUNT -lt $MAX_PARTITIONS ]] && [[ $num_files -gt 1 ]]; then
      if [[ $GENERATOR_INDEX -lt $((num_files - 1)) ]]; then
        local next_idx=$((GENERATOR_INDEX + 1))
        if [[ $next_idx -lt $num_files ]]; then
          local partition="${GENERATOR_FILES[$GENERATOR_INDEX]}|${GENERATOR_FILES[$next_idx]}"
          ((GENERATOR_INDEX++))
          ((GENERATOR_COUNT++))
          echo "$partition"
          return 0
        fi
      fi
      GENERATOR_STATE="directory"
      GENERATOR_INDEX=0
    else
      GENERATOR_STATE="directory"
      GENERATOR_INDEX=0
    fi
  fi
  
  # Strategy 3: Directory-based groupings
  if [[ "$GENERATOR_STATE" == "directory" ]]; then
    if [[ $GENERATOR_COUNT -lt $MAX_PARTITIONS ]] && [[ ${#GENERATOR_DIR_GROUPS[@]} -gt 0 ]]; then
      if [[ $GENERATOR_DIR_INDEX -lt ${#GENERATOR_DIR_GROUPS[@]} ]]; then
        local partition="${GENERATOR_DIR_GROUPS[$GENERATOR_DIR_INDEX]}"
        ((GENERATOR_DIR_INDEX++))
        ((GENERATOR_COUNT++))
        echo "$partition"
        return 0
      fi
      GENERATOR_STATE="larger"
      GENERATOR_COMBO_INDEX=3
    else
      GENERATOR_STATE="larger"
      GENERATOR_COMBO_INDEX=3
    fi
  fi
  
  # Strategy 4: Larger combinations (3+ files)
  if [[ "$GENERATOR_STATE" == "larger" ]]; then
    if [[ $GENERATOR_COUNT -lt $MAX_PARTITIONS ]] && [[ $num_files -ge $GENERATOR_COMBO_INDEX ]]; then
      # Try combinations of GENERATOR_COMBO_INDEX files
      local max_start=$((num_files - GENERATOR_COMBO_INDEX))
      if [[ $GENERATOR_INDEX -le $max_start ]]; then
        local partition=$(IFS='|'; echo "${GENERATOR_FILES[*]:$GENERATOR_INDEX:$GENERATOR_COMBO_INDEX}")
        ((GENERATOR_INDEX++))
        if [[ $GENERATOR_INDEX -gt $max_start ]]; then
          GENERATOR_INDEX=0
          ((GENERATOR_COMBO_INDEX++))
        fi
        ((GENERATOR_COUNT++))
        echo "$partition"
        return 0
      fi
      GENERATOR_INDEX=0
      ((GENERATOR_COMBO_INDEX++))
      if [[ $GENERATOR_COMBO_INDEX -gt $num_files ]]; then
        GENERATOR_STATE="all"
      fi
    else
      GENERATOR_STATE="all"
    fi
  fi
  
  # Strategy 5: All files together (as fallback)
  if [[ "$GENERATOR_STATE" == "all" ]]; then
    if [[ $GENERATOR_COUNT -lt $MAX_PARTITIONS ]]; then
      local partition=$(IFS='|'; echo "${GENERATOR_FILES[*]}")
      GENERATOR_STATE="done"
      ((GENERATOR_COUNT++))
      echo "$partition"
      return 0
    fi
  fi
  
  # Done
  return 1
}

# Coverage tracking
declare -A COVERED_FILES
COVERED_COUNT=0

# Initialize coverage tracking
init_coverage() {
  COVERED_FILES=()
  COVERED_COUNT=0
}

# Add files to coverage
add_to_coverage() {
  local partition_files="$1"
  IFS='|' read -ra files <<< "$partition_files"
  for file in "${files[@]}"; do
    if [[ -z "${COVERED_FILES[$file]:-}" ]]; then
      COVERED_FILES[$file]=1
      ((COVERED_COUNT++))
    fi
  done
}

# Check if all files are covered
is_coverage_complete() {
  local total_files="$1"
  [[ $COVERED_COUNT -eq $total_files ]]
}

# Get uncovered files
get_uncovered_files() {
  local all_files=("$@")
  local uncovered=()
  for file in "${all_files[@]}"; do
    if [[ -z "${COVERED_FILES[$file]:-}" ]]; then
      uncovered+=("$file")
    fi
  done
  printf '%s\n' "${uncovered[@]}"
}

# JSON storage
JSON_FILE=""
JSON_PARTITIONS=()

# Initialize JSON storage
init_json_storage() {
  local timestamp=$(date -u +"%Y-%m-%d-%H-%M-%S")
  JSON_FILE="$REPO_ROOT/.stacker/stack-results-$timestamp.json"
  
  # Create .stacker directory if it doesn't exist
  mkdir -p "$REPO_ROOT/.stacker" || {
    echo "Error: Could not create .stacker directory" >&2
    return 1
  }
  
  # Initialize JSON structure
  local total_files="$1"
  cat > "$JSON_FILE" <<EOF
{
  "timestamp": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "total_files": $total_files,
  "initial_verification": {
    "verified": false
  },
  "partitions": [],
  "coverage": {
    "covered_files": [],
    "uncovered_files": [],
    "complete": false
  },
  "valid_stacks": []
}
EOF
}

# Update initial verification in JSON
update_json_initial_verification() {
  local verified="$1"
  local error="${2:-}"
  
  # Use jq if available, otherwise use sed
  if command -v jq >/dev/null 2>&1; then
    jq ".initial_verification.verified = $verified | .initial_verification.error = \"$error\"" "$JSON_FILE" > "$JSON_FILE.tmp" && mv "$JSON_FILE.tmp" "$JSON_FILE"
  else
    # Fallback: simple sed replacement (less robust)
    if [[ "$verified" == "true" ]]; then
      sed -i 's/"verified": false/"verified": true/' "$JSON_FILE"
    fi
    if [[ -n "$error" ]]; then
      sed -i "s/\"error\": \"\"/\"error\": \"$error\"/" "$JSON_FILE"
    fi
  fi
}

# Add partition result to JSON
add_partition_to_json() {
  local partition_id="$1"
  local files_str="$2"
  local verified="$3"
  local error="${4:-}"
  local timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  
  # Parse files
  IFS='|' read -ra files <<< "$files_str"
  local files_json="["
  local first=true
  for file in "${files[@]}"; do
    if [[ "$first" == "true" ]]; then
      first=false
    else
      files_json+=", "
    fi
    files_json+="\"$file\""
  done
  files_json+="]"
  
  # Use jq if available
  if command -v jq >/dev/null 2>&1; then
    jq --arg id "$partition_id" \
       --argjson files "$files_json" \
       --arg verified "$verified" \
       --arg error "$error" \
       --arg timestamp "$timestamp" \
       '.partitions += [{
         "id": ($id | tonumber),
         "files": $files,
         "verified": ($verified == "true"),
         "error": $error,
         "timestamp": $timestamp
       }]' "$JSON_FILE" > "$JSON_FILE.tmp" && mv "$JSON_FILE.tmp" "$JSON_FILE"
  else
    # Fallback: append to partitions array manually (less robust)
    local partition_json="{\"id\": $partition_id, \"files\": $files_json, \"verified\": $verified, \"error\": \"$error\", \"timestamp\": \"$timestamp\"}"
    # This is a simplified approach - in production, jq would be better
    echo "Warning: jq not available, JSON updates may be incomplete" >&2
  fi
}

# Update coverage in JSON
update_json_coverage() {
  local all_files=("$@")
  local covered_array=()
  local uncovered_array=()
  
  for file in "${all_files[@]}"; do
    if [[ -n "${COVERED_FILES[$file]:-}" ]]; then
      covered_array+=("$file")
    else
      uncovered_array+=("$file")
    fi
  done
  
  local total_files=${#all_files[@]}
  local is_complete=false
  if [[ $COVERED_COUNT -eq $total_files ]]; then
    is_complete=true
  fi
  
  # Use jq if available
  if command -v jq >/dev/null 2>&1; then
    local covered_json=$(printf '%s\n' "${covered_array[@]}" | jq -R . | jq -s .)
    local uncovered_json=$(printf '%s\n' "${uncovered_array[@]}" | jq -R . | jq -s .)
    jq --argjson covered "$covered_json" \
       --argjson uncovered "$uncovered_json" \
       --arg complete "$is_complete" \
       '.coverage.covered_files = $covered | .coverage.uncovered_files = $uncovered | .coverage.complete = ($complete == "true")' \
       "$JSON_FILE" > "$JSON_FILE.tmp" && mv "$JSON_FILE.tmp" "$JSON_FILE"
  else
    echo "Warning: jq not available, coverage update skipped" >&2
  fi
}

# Verify a partition by creating temp directory and running verify.sh
verify_partition() {
  local partition_files="$1"
  local temp_dir
  temp_dir=$(mktemp -d)
  local exit_code=1
  local use_worktree=false

  # Cleanup function
  cleanup() {
    if [[ -n "${temp_dir:-}" ]] && [[ -d "$temp_dir" ]]; then
      if [[ "$use_worktree" == "true" ]] && [[ -d "$REPO_ROOT" ]]; then
        (cd "$REPO_ROOT" && git worktree remove "$temp_dir" >/dev/null 2>&1) || true
      fi
      rm -rf "$temp_dir" 2>/dev/null || true
    fi
  }
  trap cleanup EXIT

  # Create a worktree or clone for testing
  # Use git worktree if available, otherwise clone
  echo "DEBUG verify_partition: Attempting to create worktree" >&2
  local worktree_error
  worktree_error=$(cd "$REPO_ROOT" && git worktree add "$temp_dir" HEAD 2>&1)
  local worktree_exit=$?
  echo "DEBUG verify_partition: Worktree add exit code: $worktree_exit" >&2
  if [[ $worktree_exit -eq 0 ]]; then
    use_worktree=true
    echo "DEBUG verify_partition: Worktree created successfully" >&2
  else
    use_worktree=false
    echo "DEBUG verify_partition: Worktree failed: $worktree_error" >&2
    # If worktree failed, try to remove any existing one and retry once
    if echo "$worktree_error" | grep -q "already exists\|already checked out"; then
      echo "DEBUG verify_partition: Worktree already exists, cleaning up and retrying" >&2
      (cd "$REPO_ROOT" && git worktree remove "$temp_dir" --force >/dev/null 2>&1) || true
      rm -rf "$temp_dir" 2>/dev/null || true
      temp_dir=$(mktemp -d)
      echo "DEBUG verify_partition: New temp dir: $temp_dir" >&2
      if (cd "$REPO_ROOT" && git worktree add "$temp_dir" HEAD >/dev/null 2>&1); then
        use_worktree=true
        echo "DEBUG verify_partition: Worktree created on retry" >&2
      else
        echo "DEBUG verify_partition: Worktree retry also failed" >&2
      fi
    fi
    
    # Clone to temp directory if worktree still didn't work
    if [[ "$use_worktree" != "true" ]]; then
      if ! (cd "$REPO_ROOT" && git clone -q --shared --no-checkout . "$temp_dir" >/dev/null 2>&1); then
        # Fallback: create new repo and checkout files
        (cd "$temp_dir" && git init -q && \
          git config user.email "stacker@example.com" && \
          git config user.name "Stacker") || {
          cleanup
          trap - EXIT
          return 1
        }
        if ! (cd "$REPO_ROOT" && git checkout-index -a -f --prefix="$temp_dir/" >/dev/null 2>&1); then
          # Last resort: copy files manually
          (cd "$REPO_ROOT" && find . -mindepth 1 -maxdepth 1 ! -name '.git' -exec cp -r {} "$temp_dir/" \; >/dev/null 2>&1) || true
        fi
        (cd "$temp_dir" && git add -A >/dev/null 2>&1 && \
          git commit -q -m "base" --allow-empty >/dev/null 2>&1) || true
      fi
    fi
  fi
  
  if [[ ! -d "$temp_dir" ]]; then
    cleanup
    trap - EXIT
    return 1
  fi
  
  # Apply only the changes for this partition
  IFS='|' read -ra files <<< "$partition_files"
  for file in "${files[@]}"; do
    if [[ -f "$REPO_ROOT/$file" ]]; then
      # Copy the modified version from working directory
      local file_dir
      file_dir=$(dirname "$file")
      if [[ "$file_dir" != "." ]]; then
        mkdir -p "$temp_dir/$file_dir" 2>/dev/null || true
      fi
      cp "$REPO_ROOT/$file" "$temp_dir/$file" 2>/dev/null || true
    elif [[ -f "$temp_dir/$file" ]]; then
      # File exists in temp but not in working dir - it was deleted
      rm -f "$temp_dir/$file" 2>/dev/null || true
    fi
  done
  
  # Stage all changes
  (cd "$temp_dir" && git add -A >/dev/null 2>&1) || true
  
  # Run verify.sh
  local verify_script
  if [[ -f "$temp_dir/.stacker/verify.sh" ]]; then
    verify_script="$temp_dir/.stacker/verify.sh"
  elif [[ -f "$VERIFY_SCRIPT" ]]; then
    verify_script="$VERIFY_SCRIPT"
  else
    cleanup
    trap - EXIT
    return 1
  fi
  
  if [[ ! -x "$verify_script" ]]; then
    chmod +x "$verify_script" 2>/dev/null || true
  fi
  
  if [[ "$VERBOSE" == "true" ]]; then
    if (cd "$temp_dir" && bash "$verify_script" >&2); then
      exit_code=0
    fi
  else
    if (cd "$temp_dir" && bash "$verify_script" >/dev/null 2>&1); then
      exit_code=0
    fi
  fi

  cleanup
  trap - EXIT
  return $exit_code
}

# Verify a stack (ordered list of partitions)
verify_stack() {
  local partitions=("$@")
  local num_prs=${#partitions[@]}
  local temp_dir
  temp_dir=$(mktemp -d)
  local exit_code=1
  local use_worktree=false

  # Cleanup function
  cleanup() {
    if [[ -n "${temp_dir:-}" ]] && [[ -d "$temp_dir" ]]; then
      if [[ "$use_worktree" == "true" ]] && [[ -d "$REPO_ROOT" ]]; then
        (cd "$REPO_ROOT" && git worktree remove "$temp_dir" >/dev/null 2>&1) || true
      fi
      rm -rf "$temp_dir" 2>/dev/null || true
    fi
  }
  trap cleanup EXIT

  # Set up temp repo using worktree if available
  local worktree_error
  worktree_error=$(cd "$REPO_ROOT" && git worktree add "$temp_dir" HEAD 2>&1)
  if [[ $? -eq 0 ]]; then
    use_worktree=true
  else
    use_worktree=false
    # If worktree failed, try to remove any existing one and retry once
    if echo "$worktree_error" | grep -q "already exists\|already checked out"; then
      (cd "$REPO_ROOT" && git worktree remove "$temp_dir" --force >/dev/null 2>&1) || true
      rm -rf "$temp_dir" 2>/dev/null || true
      temp_dir=$(mktemp -d)
      if (cd "$REPO_ROOT" && git worktree add "$temp_dir" HEAD >/dev/null 2>&1); then
        use_worktree=true
      fi
    fi
    
    # Clone to temp directory if worktree still didn't work
    if [[ "$use_worktree" != "true" ]]; then
      if ! (cd "$REPO_ROOT" && git clone -q --shared --no-checkout . "$temp_dir" >/dev/null 2>&1); then
        # Fallback: create new repo and checkout files
        (cd "$temp_dir" && git init -q && \
          git config user.email "stacker@example.com" && \
          git config user.name "Stacker") || {
          cleanup
          trap - EXIT
          return 1
        }
        if ! (cd "$REPO_ROOT" && git checkout-index -a -f --prefix="$temp_dir/" >/dev/null 2>&1); then
          (cd "$REPO_ROOT" && find . -mindepth 1 -maxdepth 1 ! -name '.git' -exec cp -r {} "$temp_dir/" \; >/dev/null 2>&1) || true
        fi
        (cd "$temp_dir" && git add -A >/dev/null 2>&1 && \
          git commit -q -m "base" --allow-empty >/dev/null 2>&1) || true
      fi
    fi
  fi
  
  if [[ ! -d "$temp_dir" ]]; then
    cleanup
    trap - EXIT
    return 1
  fi
  
  # Apply each PR in sequence
  for ((i=0; i<num_prs; i++)); do
    local partition="${partitions[$i]}"
    IFS='|' read -ra files <<< "$partition"
    
    # Apply changes for this PR
    for file in "${files[@]}"; do
      if [[ -f "$REPO_ROOT/$file" ]]; then
        local file_dir
        file_dir=$(dirname "$file")
        if [[ "$file_dir" != "." ]]; then
          mkdir -p "$temp_dir/$file_dir" 2>/dev/null || true
        fi
        cp "$REPO_ROOT/$file" "$temp_dir/$file" 2>/dev/null || true
      elif [[ -f "$temp_dir/$file" ]]; then
        # File exists in temp but not in working dir - it was deleted
        rm -f "$temp_dir/$file" 2>/dev/null || true
      fi
    done
    
    (cd "$temp_dir" && git add -A >/dev/null 2>&1) || true
    
    # Verify this PR on top of previous PRs
    local verify_script
    if [[ -f "$temp_dir/.stacker/verify.sh" ]]; then
      verify_script="$temp_dir/.stacker/verify.sh"
    elif [[ -f "$VERIFY_SCRIPT" ]]; then
      verify_script="$VERIFY_SCRIPT"
    else
      cleanup
      trap - EXIT
      return 1
    fi
    
    if [[ ! -x "$verify_script" ]]; then
      chmod +x "$verify_script" 2>/dev/null || true
    fi
    
    if [[ "$VERBOSE" == "true" ]]; then
      if ! (cd "$temp_dir" && bash "$verify_script" >&2); then
        cleanup
        trap - EXIT
        return 1
      fi
    else
      if ! (cd "$temp_dir" && bash "$verify_script" >/dev/null 2>&1); then
        cleanup
        trap - EXIT
        return 1
      fi
    fi
  done

  cleanup
  trap - EXIT
  return 0
}

# Report valid stacks
report_stacks() {
  local valid_stacks=("$@")
  local num_stacks=${#valid_stacks[@]}

  if [[ "$JSON_OUTPUT" == "true" ]]; then
    echo "["
    for ((i=0; i<num_stacks; i++)); do
      local stack="${valid_stacks[$i]}"
      echo -n "  {"
      echo -n "\"stack_number\": $((i+1)),"
      echo -n "\"prs\": ["
      
      local first=true
      local pr_num=1
      while IFS= read -r partition; do
        if [[ -n "$partition" ]]; then
          if [[ "$first" == "true" ]]; then
            first=false
          else
            echo -n ","
          fi
          echo -n "{\"pr\": $pr_num, \"files\": ["
          IFS='|' read -ra files <<< "$partition"
          local first_file=true
          for file in "${files[@]}"; do
            if [[ "$first_file" == "true" ]]; then
              first_file=false
            else
              echo -n ","
            fi
            echo -n "\"$file\""
          done
          echo -n "]}"
          ((pr_num++))
        fi
      done <<< "$stack"
      
      echo -n "]"
      echo -n "}"
      if [[ $i -lt $((num_stacks - 1)) ]]; then
        echo ","
      else
        echo
      fi
    done
    echo "]"
  else
    echo "Found $num_stacks valid PR stack(s):"
    echo ""
    
    for ((i=0; i<num_stacks; i++)); do
      local stack="${valid_stacks[$i]}"
      echo "Stack $((i+1)):"
      echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
      
      local pr_num=1
      while IFS= read -r partition; do
        if [[ -n "$partition" ]]; then
          echo "PR$pr_num:"
          IFS='|' read -ra files <<< "$partition"
          for file in "${files[@]}"; do
            echo "  - $file"
          done
          echo ""
          ((pr_num++))
        fi
      done <<< "$stack"
      
      if [[ $i -lt $((num_stacks - 1)) ]]; then
        echo ""
      fi
    done
  fi
}

# Clean up any leftover worktrees from previous runs
cleanup_worktrees() {
  if [[ -d "$REPO_ROOT/.git/worktrees" ]]; then
    local worktrees
    worktrees=$(cd "$REPO_ROOT" && git worktree list --porcelain 2>/dev/null | grep -E "^worktree " | cut -d' ' -f2- || true)
    if [[ -n "$worktrees" ]]; then
      while IFS= read -r wt_path; do
        if [[ -n "$wt_path" ]] && [[ "$wt_path" == /tmp/* ]]; then
          if [[ "$VERBOSE" == "true" ]]; then
            echo "Cleaning up leftover worktree: $wt_path" >&2
          fi
          (cd "$REPO_ROOT" && git worktree remove "$wt_path" --force >/dev/null 2>&1) || true
          rm -rf "$wt_path" 2>/dev/null || true
        fi
      done <<< "$worktrees"
    fi
  fi
}

# Signal handler for clean exit
handle_interrupt() {
  echo "" >&2
  echo "" >&2
  echo "Interrupted by user (Ctrl+C)" >&2
  cleanup_worktrees
  if [[ -n "${JSON_FILE:-}" ]] && [[ -f "$JSON_FILE" ]]; then
    # Update coverage in JSON before exiting
    if [[ -n "${changed_files:-}" ]]; then
      update_json_coverage "${changed_files[@]}" 2>/dev/null || true
    fi
    echo "Partial results saved to: $JSON_FILE" >&2
  fi
  exit 130  # Standard exit code for SIGINT
}

# Main execution
main() {
  # Set up signal handlers early - must be before any long-running operations
  trap 'handle_interrupt' INT
  trap 'handle_interrupt' TERM
  trap 'cleanup_worktrees; exit' EXIT
  
  # Clean up any leftover worktrees from previous runs
  cleanup_worktrees
  
  # Get uncommitted changes
  local changed_files
  if ! changed_files=($(get_uncommitted_changes)); then
    echo "Error: Failed to get uncommitted changes" >&2
    exit 1
  fi
  
  if [[ ${#changed_files[@]} -eq 0 ]]; then
    if [[ "$JSON_OUTPUT" == "true" ]]; then
      echo '{"error": "No uncommitted changes found"}' 
    else
      echo "No uncommitted changes found."
      echo "Make some changes to your files and try again."
    fi
    exit 0
  fi
  
  # Initialize JSON storage
  if ! init_json_storage ${#changed_files[@]}; then
    echo "Error: Failed to initialize JSON storage" >&2
    exit 1
  fi
  
  # Step 1: Verify entire change set first
  echo "Verifying entire change set..." >&2
  if ! verify_entire_changeset; then
    update_json_initial_verification false "Entire change set does not verify"
    update_json_coverage "${changed_files[@]}"
    if [[ "$JSON_OUTPUT" == "true" ]]; then
      cat "$JSON_FILE"
    else
      echo "Error: The entire change set does not verify. Cannot split into PRs." >&2
      echo "       Results saved to: $JSON_FILE" >&2
    fi
    exit 1
  fi
  
  update_json_initial_verification true ""
  echo "✓ Entire change set is valid" >&2
  echo "" >&2
  
  # Initialize coverage tracking and partition generator
  init_coverage
  init_partition_generator "${changed_files[@]}"
  
  # Step 2: Incremental generation and verification
  local valid_partitions=()
  local partition_id=0
  local partition
  
  echo "Generating and verifying partitions incrementally..." >&2
  echo "Press Ctrl+C to stop and save partial results" >&2
  echo "" >&2
  
  # Ensure signals are not blocked in the loop
  while partition=$(generate_next_partition); do
    ((partition_id++))
    
    if [[ "$VERBOSE" == "true" ]]; then
      echo "Verifying partition $partition_id: $partition" >&2
    else
      echo "Verifying partition $partition_id..." >&2
    fi
    
    # Verify partition (temporarily disable exit on error to allow signal handling)
    # Note: We keep set +e here so that verify_partition failures don't exit the script
    # Signals (Ctrl+C) will still be caught by the trap handler
    set +e
    local verified=false
    local error=""
    # Run verification - if user presses Ctrl+C, the trap will catch it
    if verify_partition "$partition" >/dev/null 2>&1; then
      verified=true
      valid_partitions+=("$partition")
      add_to_coverage "$partition"
      echo "  ✓ Valid" >&2
      # Show coverage progress after each valid partition
      echo "  Coverage: $COVERED_COUNT of ${#changed_files[@]} files covered ($(($COVERED_COUNT * 100 / ${#changed_files[@]}))%)" >&2
    else
      error="Partition verification failed"
      echo "  ✗ Invalid" >&2
      # Still show coverage progress periodically even for invalid partitions
      if [[ $((partition_id % 5)) -eq 0 ]]; then
        echo "  Coverage: $COVERED_COUNT of ${#changed_files[@]} files covered ($(($COVERED_COUNT * 100 / ${#changed_files[@]}))%)" >&2
      fi
    fi
    set -e
    
    # Add to JSON
    add_partition_to_json "$partition_id" "$partition" "$verified" "$error"
    
    # Update coverage in JSON
    update_json_coverage "${changed_files[@]}"
    
    # Check if coverage is complete
    if is_coverage_complete ${#changed_files[@]}; then
      echo "" >&2
      echo "✓ Coverage complete! All ${#changed_files[@]} files are covered by valid partitions." >&2
      break
    fi
  done
  
  echo "" >&2
  echo "Partition verification complete: ${#valid_partitions[@]} valid partition(s) found" >&2
  
  # Update final coverage status
  update_json_coverage "${changed_files[@]}"
  
  # Report results
  if [[ ${#valid_partitions[@]} -eq 0 ]]; then
    if [[ "$JSON_OUTPUT" == "true" ]]; then
      cat "$JSON_FILE"
    else
      echo "No valid partitions found." >&2
      echo "All partition attempts failed verification by .stacker/verify.sh" >&2
      echo "" >&2
      echo "Results saved to: $JSON_FILE" >&2
    fi
    exit 0
  fi
  
  # Show coverage summary
  local uncovered
  uncovered=($(get_uncovered_files "${changed_files[@]}"))
  if [[ ${#uncovered[@]} -gt 0 ]]; then
    echo "Warning: ${#uncovered[@]} file(s) not covered by any valid partition:" >&2
    for file in "${uncovered[@]}"; do
      echo "  - $file" >&2
    done
    echo "" >&2
  fi
  
  # Report valid partitions
  if [[ "$JSON_OUTPUT" == "true" ]]; then
    cat "$JSON_FILE"
  else
    echo "Valid partitions found:" >&2
    echo "" >&2
    for ((i=0; i<${#valid_partitions[@]}; i++)); do
      echo "Partition $((i+1)):" >&2
      IFS='|' read -ra files <<< "${valid_partitions[$i]}"
      for file in "${files[@]}"; do
        echo "  - $file" >&2
      done
      echo "" >&2
    done
    echo "Results saved to: $JSON_FILE" >&2
  fi
}

main "$@"

