#!/usr/bin/env bash
# obsidian-sync — two-way sync of the Obsidian vault to Backblaze B2 via rclone
# bisync. Replaces the Obsidian "remotely-save" plugin. Run on a 30-minute
# schedule by com.narthur.obsidian-sync (launchd), logged via cron-run.
#
# Usage:
#   obsidian-sync            normal incremental two-way sync (used by launchd)
#   obsidian-sync resync     ONE-TIME baseline; run this once by hand before
#                            scheduling. Establishes the bisync state that
#                            every later run compares against. Without it, a
#                            plain run errors out (by design — no silent first
#                            sync). "newer" wins on the baseline.
#
# Config:
#   ~/.config/rclone/rclone.conf                 (remote "obsidianb2"; tracked in dotfiles-private)
#   ~/.config/rclone/obsidian-bisync-filters.txt (excludes, in dotfiles)
#   ~/.env                                       (OBSIDIAN_VAULT, OBSIDIAN_B2_REMOTE)
#   login Keychain                               (B2 secret: svc rclone-obsidianb2-secret)
set -euo pipefail

# Non-secret config (OBSIDIAN_VAULT, ...) still comes from ~/.env. launchd does
# not source it, so do it here; interactive shells already have it.
[ -f "$HOME/.env" ] && . "$HOME/.env"

# The B2 secret comes from the login Keychain, NOT ~/.env. ~/.env is sourced by
# .zshrc, so anything in it sits in the environment of every process on this
# machine. Here it is exported only into this process tree, for rclone.
#
# Fails loudly on purpose: an empty credential must never be mistaken for
# "nothing to sync". Needs the login keychain unlocked, so this must stay a
# LaunchAgent in a logged-in GUI session -- never a LaunchDaemon.
if ! RCLONE_CONFIG_OBSIDIANB2_SECRET_ACCESS_KEY="$(security find-generic-password \
        -a obsidianb2 -s rclone-obsidianb2-secret -w </dev/null 2>&1)"; then
    echo "obsidian-sync: cannot read the B2 secret from the Keychain." >&2
    echo "  ${RCLONE_CONFIG_OBSIDIANB2_SECRET_ACCESS_KEY}" >&2
    echo "  Keychain locked, or item missing (svc rclone-obsidianb2-secret)." >&2
    exit 1
fi
if [[ -z "$RCLONE_CONFIG_OBSIDIANB2_SECRET_ACCESS_KEY" ]]; then
    echo "obsidian-sync: Keychain returned an empty secret -- refusing to sync." >&2
    exit 1
fi
export RCLONE_CONFIG_OBSIDIANB2_SECRET_ACCESS_KEY

VAULT="${OBSIDIAN_VAULT:-$HOME/Obsidian/Main}"
# No default: the bucket name is the only personal string in an otherwise
# generic script, so it lives in ~/.env and this stays publishable. Failing
# loudly beats defaulting to someone else's bucket name.
REMOTE="${OBSIDIAN_B2_REMOTE:?OBSIDIAN_B2_REMOTE not set (expected in ~/.env, e.g. myremote:my-bucket)}"
FILTERS="$HOME/.config/rclone/obsidian-bisync-filters.txt"

if [[ ! -d "$VAULT" ]]; then
    echo "obsidian-sync: vault not found at $VAULT — refusing to sync" >&2
    exit 1
fi

# Shared flags:
#   --conflict-resolve newer / --conflict-loser num
#       most-recently-edited copy wins; the losing copy is kept (numbered),
#       never silently deleted — a safety net for genuine edit conflicts.
#   --max-delete 25
#       abort if a run would delete >25% of files on either side (guards
#       against a missing mount or accidental mass deletion).
#   --resilient --recover
#       tolerate transient failures and recover from interrupted runs / stale
#       lock files instead of demanding a manual --resync.
args=(
    bisync "$VAULT" "$REMOTE"
    --filters-file "$FILTERS"
    --compare size,modtime
    --conflict-resolve newer
    --conflict-loser num
    --max-delete 25
    --resilient
    --recover
    #   --max-lock 5m
    #       THE fix for the wedging. Without it a lock never expires (rclone
    #       writes TimeExpires ~200 years out), so any run that dies leaves a
    #       lock blocking every future run until someone clears it by hand. That
    #       cost 31 of 45 days of backups across two episodes, one of 25 days.
    #       rclone renews the lock every (max-lock - 1m) while the process lives,
    #       so a 22-minute run is safe; a dead one clears in 5 minutes. The docs
    #       recommend this specifically alongside --resilient and --recover.
    --max-lock 5m
    --transfers 16
    --checkers 32
    --log-level INFO
)

# Healthchecks heartbeats are handled by cron-run (slug = obsidian-sync), which
# wraps this script from launchd. Not `exec`, so the exit status is this
# script's own and cron-run can act on it.
if [[ "${1:-}" == "resync" ]]; then
    echo "obsidian-sync: establishing bisync baseline (--resync, newer wins)..."
    rclone "${args[@]}" --resync --resync-mode newer
else
    rclone "${args[@]}"
fi
