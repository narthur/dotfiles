#!/bin/bash

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    cat <<'USAGE'
Usage: generate-illustrations [INPUT]

Generate a set of painterly illustrations for an article across a range of
artistic styles and abstractness levels. The article text is summarized with
an LLM, turned into image-generation prompts, and rendered via fal.ai.

Input options:
  FILE                  Read the article from FILE.
  -c, --from-clipboard  Read the article from the system clipboard.
  (none)                Read the article from stdin (type 'END' on a new line
                        when finished).

Other options:
  -h, --help            Show this help and exit.

Environment:
  FAL_KEY      Required. fal.ai API key (https://fal.ai/dashboard/keys).
               Add 'export FAL_KEY=...' to ~/.env.
  IMAGE_MODEL  Optional. Hosted image model (default: fal-ai/flux/dev).

Output:
  Images are saved to ~/Pictures/Illustrations. Each run also writes
  ~/Pictures/Illustrations/runs/<timestamp>/ with the source article, its
  summary, and a prompts.jsonl of every prompt/palette/seed used.
USAGE
    exit 0
fi

# Alias tracks the current Haiku snapshot without a hardcoded date.
# ponytail: llm has no cross-version "latest haiku"; bump the generation (4.5 -> 5) by hand.
model="claude-haiku-4.5"

# Hosted image model on fal.ai (override with IMAGE_MODEL env var if desired)
image_model="${IMAGE_MODEL:-fal-ai/flux/dev}"

# Appended to every image prompt so all styles render as paintings, never photos.
# Deliberately physical: the old suffix lost to "hyperrealist" style names and
# produced photos. This one insists on paint you can see.
painterly_suffix="Rendered unmistakably as a hand-painted picture: thick visible brushstrokes, ridges of paint catching the light, palette-knife marks and canvas weave showing through. Never smooth, never photographic. This is physical paint on canvas, not a photo."

# Fail fast if the image API key is missing (add `export FAL_KEY=...` to ~/.env)
if [[ -z "$FAL_KEY" ]]; then
    echo "Error: FAL_KEY is not set. Get one at https://fal.ai/dashboard/keys and add 'export FAL_KEY=...' to ~/.env" >&2
    exit 1
fi

# Print k random distinct elements (one per line) from the remaining args.
# Portable partial Fisher-Yates using $RANDOM (no shuf/coreutils; works on
# macOS bash 3.2). ponytail: this exists so every run samples a fresh mix.
pick_random() {
    local k="$1"; shift
    local pool=("$@")
    local n=${#pool[@]}
    local i j tmp
    for ((i=0; i<k && i<n; i++)); do
        j=$(( i + RANDOM % (n - i) ))
        tmp="${pool[$i]}"; pool[$i]="${pool[$j]}"; pool[$j]="$tmp"
        printf '%s\n' "${pool[$i]}"
    done
}

# Style POOLS per abstractness tier. Each run samples a random subset, so
# illustrations vary within a run and across runs. Every style is painterly by
# name — no "photoreal/hyperrealist" that would fight the painterly suffix.
declare -a very_concrete=(
    "Thick impasto oil painting, palette-knife texture"
    "Alla prima oil sketch, wet-on-wet, visible bristle marks"
    "Post-Impressionist oil with swirling van-Gogh-like brushwork"
    "Sargent-style loose realist oil, confident bravura strokes"
    "Vuillard-like patterned interior oil, painterly flatness"
    "Andrew-Wyeth-style egg tempera, dry-brush texture"
)
declare -a mod_concrete=(
    "Impressionist plein-air oil, broken color"
    "Fauvist oil, non-naturalistic high-key color"
    "Expressionist oil, Kirchner-like angular strokes"
    "Matte gouache narrative illustration"
    "Symbolist oil, Redon-like dreamlike glow"
    "Social-realist mural oil, Diego-Rivera-like"
)
declare -a mod_abstract=(
    "Abstract expressionist, de-Kooning-like gestural"
    "Surrealist metaphor, Ernst-like biomorphic forms"
    "Cubist fragmentation, Braque-like faceting"
    "Hilma-af-Klint-like symbolist diagrammatic abstraction"
    "Combine-painting collage, Rauschenberg-like"
    "Kandinsky-like lyrical abstraction with floating symbols"
)
declare -a very_abstract=(
    "Rothko-like color field, stacked veils of pigment"
    "Hard-edge geometric abstraction, Malevich-like forms"
    "Kline-like gestural calligraphic black strokes"
    "Turner-like dissolved-light atmospheric abstraction"
    "Frankenthaler-like soak-stain tachist washes"
    "Constructivist geometric, El-Lissitzky-like diagonals"
)

# Palettes sampled one-per-image to break Flux's default warm-center mood-scape
# (the reason every run's abstract image looked identical). Random ⇒ range.
declare -a palettes=(
    "restrained palette of ochre, bone white, and deep indigo"
    "high-contrast palette of vermilion, black, and raw canvas"
    "cool palette of teal, slate, and pale citron"
    "earthy palette of terracotta, olive, and cream"
    "muted palette of dusty rose, sage, and charcoal"
    "bold palette of cobalt, cadmium yellow, and magenta"
    "graphite-grey monochrome with a single saturated accent"
    "warm dusk palette of amber, rust, and violet shadow"
    "verdant palette of moss, emerald, and gold leaf"
    "austere palette of ice blue, white, and jet black"
)

# Sample a balanced, randomized set: N random styles from each tier this run.
per_tier=4
declare -a styles=()
while IFS= read -r s; do styles+=("Very Concrete:$s"); done < <(pick_random "$per_tier" "${very_concrete[@]}")
while IFS= read -r s; do styles+=("Moderately Concrete:$s"); done < <(pick_random "$per_tier" "${mod_concrete[@]}")
while IFS= read -r s; do styles+=("Moderately Abstract:$s"); done < <(pick_random "$per_tier" "${mod_abstract[@]}")
while IFS= read -r s; do styles+=("Very Abstract:$s"); done < <(pick_random "$per_tier" "${very_abstract[@]}")

# Prompt template for extracting key themes and concepts from the article
IFS= read -r -d '' extraction_prompt_template <<'PROMPT_END' || true
Analyze the following article and extract the key themes, concepts, subjects, and narrative 
elements that would be important for creating illustrations. Provide a concise but comprehensive 
summary that captures:

- Main subject matter and topics
- Key themes and concepts
- Mood, tone, and atmosphere
- Narrative elements or story points (if applicable)
- Symbolic or metaphorical elements that could be visualized

Then, add a SYMBOL BANK: a list of 6-10 concrete, specific metaphorical motifs or objects that
this article evokes and that could carry its meaning symbolically (e.g. "a frayed rope", "a
lighthouse in fog", "interlocking gears", "a single lit window"). These are the raw material the
abstract illustrations will abstract FROM, so make them concrete and specific, not moods. Prefer
motifs that are distinctive to THIS article, not generic art clichés.

Structure the output as:
THEMES: (the conceptual/thematic/atmospheric summary above)
SYMBOL BANK: (the bulleted list of concrete symbolic motifs)

Output ONLY those two sections - no introductions, explanations, or meta-commentary.

ARTICLE:
{ARTICLE}
PROMPT_END

# Base prompt template for generating a single image prompt
IFS= read -r -d '' base_prompt_template <<'PROMPT_END' || true
Create a single, detailed prompt for an image generator to create an illustration based on the 
following summary of key themes, concepts, and atmospheric elements from an article.

STYLE REQUIREMENTS:
Abstractness Level: {ABSTRACTNESS}
Artistic Style: {ARTISTIC_STYLE}

CRITICAL: The prompt must directly reflect and connect to specific aspects from the summary - its 
subject matter, themes, concepts, mood, tone, or narrative elements. The level of visual specificity 
should be determined by the abstractness level:
- Very Concrete: Include specific, recognizable visual elements from the article's subject matter
- Moderately Concrete: Include recognizable elements but with some abstraction or symbolism
- Moderately Abstract: Build the image around 1-3 SPECIFIC motifs drawn from the SYMBOL BANK, rendered as symbols/metaphors rather than literal scenes
- Very Abstract: Take 1-3 SPECIFIC motifs from the SYMBOL BANK and abstract them into pure form, color, gesture, and composition. The motifs must still shape the image. Do NOT default to a generic empty landscape, sunset, horizon, or misty water — those are forbidden unless a motif in the SYMBOL BANK explicitly calls for them.

Do not create generic artistic prompts; instead, ensure the prompt visually represents something 
meaningful from the article's content at the appropriate level of abstraction for the specified style.

The prompt should include ONLY visual description elements:
- Visual elements appropriate to the specified abstractness level and artistic style
- Specific art medium and technique (e.g., "Oil painting", "Watercolor", "Acrylic", "Impasto technique")
- Detailed color palette descriptions that reflect the mood and themes of the article
- Lighting details that enhance the article's atmosphere
- Texture and brushwork (e.g., "visible brushstrokes", "heavy texture", "smooth blended surfaces")
- Composition and mood elements that capture the essence of the article
- Specific visual details that create atmosphere and depth while staying true to the article's content

IMPORTANT: Write the prompt as a pure visual description. Do NOT include:
- Explanations of why you chose certain elements
- Rationale for the abstractness level or style
- Meta-commentary about the prompt itself
- References to "this prompt" or "this illustration"
- Phrases like "to represent", "to show", "to capture" - just describe what IS in the image
- Conceptual justifications - only describe the visual elements

Make the prompt rich, evocative, and detailed - like a professional art director's brief. Use 
artistic terminology and descriptive language that will produce high-quality, visually striking 
illustrations. Write as if describing an existing image, not explaining a concept.

CRITICAL OUTPUT FORMAT:
- Output ONLY the image generation prompt itself
- NO headings, labels, or category names
- NO explanations, rationale, or justification text
- NO numbering or bullet points
- NO meta-commentary
- The prompt should start directly with the visual description (e.g., "Oil painting of..." not "VERY CONCRETE: Oil painting of...")
- Focus exclusively on WHAT should appear in the image, not WHY or HOW it relates to the article

ARTICLE SUMMARY:
{SUMMARY}
PROMPT_END

if [[ "$1" == "--from-clipboard" || "$1" == "-c" ]]; then
    # Read the article straight from the system clipboard
    if command -v pbpaste >/dev/null 2>&1; then
        article_text=$(pbpaste)
    elif command -v wl-paste >/dev/null 2>&1; then
        article_text=$(wl-paste)
    elif command -v xclip >/dev/null 2>&1; then
        article_text=$(xclip -selection clipboard -o)
    elif command -v xsel >/dev/null 2>&1; then
        article_text=$(xsel --clipboard --output)
    else
        echo "Error: --from-clipboard needs pbpaste (macOS) or wl-paste/xclip/xsel (Linux)." >&2
        exit 1
    fi
    if [[ -z "${article_text//[[:space:]]/}" ]]; then
        echo "Error: clipboard is empty." >&2
        exit 1
    fi
elif [[ -n "$1" ]]; then
    if [[ ! -f "$1" ]]; then
        echo "Error: File not found: $1" >&2
        exit 1
    fi
    article_text=$(cat "$1")
else
    echo "Paste your text (type 'END' on a new line when finished):"
    article_text=$(sed '/^END$/q' | sed '$d')
fi

output_dir="$HOME/Pictures/Illustrations"

# Extract key themes and concepts from the article
printf "Analyzing article... "
extraction_prompt="${extraction_prompt_template//\{ARTICLE\}/$article_text}"
article_summary=$(llm prompt --model $model "$extraction_prompt")
echo "done"

# Arrays to store collected prompts and their labels
declare -a all_prompts=()
declare -a all_labels=()

total_styles=${#styles[@]}
style_num=0

# Loop through each sampled style and generate one image prompt
for style_entry in "${styles[@]}"; do
    IFS=':' read -r abstractness artistic_style <<< "$style_entry"
    style_num=$((style_num + 1))

    printf "  [%d/%d] %s - %s... " "$style_num" "$total_styles" "$abstractness" "$artistic_style"

    prompt="${base_prompt_template//\{ABSTRACTNESS\}/$abstractness}"
    prompt="${prompt//\{ARTISTIC_STYLE\}/$artistic_style}"
    prompt="${prompt//\{SUMMARY\}/$article_summary}"

    response=$(llm prompt --model $model "$prompt")

    cleaned_prompt=$(echo "$response" | \
        grep -v -iE '^(very|moderately|abstract|concrete)[\s]*:' | \
        grep -v -iE '^[0-9]+\.[\s]*' | \
        grep -v -iE '^[-*•][\s]*' | \
        grep -v -iE '^(prompt|illustration|image|output|result)[\s]*[0-9]*[\s]*:' | \
        grep -v -iE '^(this (prompt|illustration|image|represents|shows|depicts))' | \
        grep -v -iE '^(the|this) (represents|shows|depicts|captures|illustrates|is meant to)' | \
        grep -v -iE '^(to (represent|show|depict|capture|illustrate|convey|express))' | \
        grep -v -iE '^(in order to|because|since|due to|based on|according to)' | \
        sed 's/^[[:space:]]*//' | \
        sed 's/[[:space:]]*$//' | \
        grep -v '^$' | \
        awk 'length > 20' | \
        tr '\n' ' ' | \
        sed 's/[[:space:]]*$//')

    if [[ -n "$cleaned_prompt" ]]; then
        all_prompts+=("$cleaned_prompt")
        all_labels+=("$abstractness - $artistic_style")
        echo "✓"
    else
        echo "✗ (no prompt extracted)"
    fi
done

# Create output directory if it doesn't exist
mkdir -p "$output_dir"

# Per-run log dir: the article, its summary, and every prompt/palette/seed, so
# runs can be analyzed later to keep improving this script.
run_id=$(date +%Y%m%d-%H%M%S)
log_dir="$output_dir/runs/$run_id"
mkdir -p "$log_dir"
printf '%s' "$article_text" > "$log_dir/article.txt"
printf '%s' "$article_summary" > "$log_dir/summary.txt"

image_width=1024
image_height=608
total=${#all_prompts[@]}

# Generate images for each collected prompt
for i in "${!all_prompts[@]}"; do
    prompt_line="${all_prompts[$i]}"
    label="${all_labels[$i]}"

    if [[ -n "$prompt_line" ]]; then
        printf "[%d/%d] %s... " "$((i+1))" "$total" "$label"

        # Per-image palette + random seed drive variety between sibling styles
        palette=$(pick_random 1 "${palettes[@]}")
        seed=$RANDOM
        full_prompt="$prompt_line Color palette: $palette. $painterly_suffix"

        # Request a single image from the hosted model (synchronous endpoint)
        response=$(curl -sS -X POST "https://fal.run/$image_model" \
            -H "Authorization: Key $FAL_KEY" \
            -H "Content-Type: application/json" \
            -d "$(jq -n \
                --arg p "$full_prompt" \
                --argjson w "$image_width" \
                --argjson h "$image_height" \
                --argjson seed "$seed" \
                '{prompt:$p, image_size:{width:$w, height:$h}, num_images:1, output_format:"png", seed:$seed}')")

        image_url=$(echo "$response" | jq -r '.images[0].url // empty')

        filename="$run_id-$((i+1)).png"
        if [[ -n "$image_url" ]]; then
            if curl -sS -fL "$image_url" -o "$output_dir/$filename"; then
                echo "✓ $filename"
            else
                echo "✗ download failed"
            fi
        else
            err=$(echo "$response" | jq -r '.detail // .error // .message // "unknown error"' 2>/dev/null)
            echo "✗ no image ($err)"
        fi

        # Append this image's full record to the run log (one JSON object per line)
        jq -n --arg file "$filename" --arg label "$label" \
            --arg prompt "$full_prompt" --arg palette "$palette" --argjson seed "$seed" \
            '{file:$file, label:$label, palette:$palette, seed:$seed, prompt:$prompt}' \
            >> "$log_dir/prompts.jsonl"
    fi
done

echo "Done. $total images saved to $output_dir"
echo "Run log: $log_dir"
