#!/usr/bin/env bash

# user-org-report - Generate a report of issues and PRs for a user within an organization
# Usage:
#   bash user-org-report USERNAME ORG [--days N] [--state STATE] [--json] [--human] [--limit N]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

DAYS=30
STATE="all"
FORMAT="human"
LIMIT=0
DEBUG=false

# Parse arguments
USERNAME=""
ORG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --days|-d) DAYS="$2"; shift 2;;
    --state|-s) STATE="$2"; shift 2;;
    --json) FORMAT="json"; shift;;
    --human) FORMAT="human"; shift;;
    --limit|-l) LIMIT="$2"; shift 2;;
    --debug) DEBUG=true; shift;;
    -h|--help)
      cat <<EOF
Usage: $0 USERNAME ORG [options]

Arguments:
  USERNAME              GitHub username to search for
  ORG                   Organization name to search within

Options:
  --days|-d N           Number of days to look back (default: 30)
  --state STATE         State: all, open, closed, merged (default: all)
                        For PRs: all, open, closed, merged
                        For issues: all, open, closed
  --json                JSON output format
  --human               Human-readable format (default)
  --limit|-l N          Limit number of results per type (PRs and issues separately)
  --debug               Show debug information (queries, etc.)
  -h, --help            Show this help

Examples:
  $0 narthur myorg --days 14 --state open
  $0 narthur myorg --json --limit 10
  $0 narthur myorg --days 7
EOF
      exit 0
      ;;
    *)
      if [[ -z "$USERNAME" ]]; then
        USERNAME="$1"
      elif [[ -z "$ORG" ]]; then
        ORG="$1"
      else
        echo "Error: Unknown option or too many arguments: $1" >&2
        exit 1
      fi
      shift
      ;;
  esac
done

# Validate required arguments
if [[ -z "$USERNAME" ]] || [[ -z "$ORG" ]]; then
  echo "Error: USERNAME and ORG are required" >&2
  echo "Usage: $0 USERNAME ORG [options]" >&2
  echo "Run $0 --help for more information" >&2
  exit 1
fi

# Check for required dependencies
if ! command -v gh >/dev/null 2>&1; then
  echo "Error: GitHub CLI (gh) is not installed. Please install it first." >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "Error: jq is not installed. Please install it first." >&2
  exit 1
fi

# Build search query
SINCE=$(date -u -d "$DAYS days ago" +%Y-%m-%d)
# Use involves: to find all PRs/issues the user is involved in
SEARCH_QUERY="updated:>=$SINCE org:$ORG involves:$USERNAME sort:updated-desc"

# Function to calculate relative time
relative_time() {
  local timestamp="$1"
  local now=$(date +%s)
  local then=$(date -d "$timestamp" +%s 2>/dev/null || echo "$now")
  local diff=$((now - then))
  
  if [[ $diff -lt 3600 ]]; then
    echo "$((diff / 60))m ago"
  elif [[ $diff -lt 86400 ]]; then
    echo "$((diff / 3600))h ago"
  elif [[ $diff -lt 604800 ]]; then
    echo "$((diff / 86400))d ago"
  else
    echo "$((diff / 604800))w ago"
  fi
}

# Function to format state with ANSI colors
format_state() {
  local state="$1"
  local is_draft="$2"
  local state_str=""
  local color_reset=$'\033[0m'
  local visible_len=0
  
  case "$state" in
    OPEN)
      if [[ "$is_draft" == "true" ]]; then
        local color=$'\033[90m'  # Gray
        state_str="${color}draft${color_reset}"
        visible_len=5
      else
        local color=$'\033[32m'  # Green
        state_str="${color}open${color_reset}"
        visible_len=4
      fi
      ;;
    CLOSED)
      local color=$'\033[31m'  # Red
      state_str="${color}closed${color_reset}"
      visible_len=6
      ;;
    MERGED)
      local color=$'\033[34m'  # Blue
      state_str="${color}merged${color_reset}"
      visible_len=6
      ;;
    *)
      state_str="$state"
      visible_len=${#state}
      ;;
  esac
  local padding=$((8 - visible_len))
  if [[ $padding -gt 0 ]]; then
    printf "%s%*s" "$state_str" "$padding" ""
  else
    printf "%s" "$state_str"
  fi
}

# Function to format review decision
format_review() {
  local decision="$1"
  case "$decision" in
    APPROVED) echo "✓ approved" ;;
    CHANGES_REQUESTED) echo "⚠ changes" ;;
    REVIEW_REQUIRED) echo "⏳ review" ;;
    *) echo "" ;;
  esac
}

# Function to determine how a user is involved in a PR
# Returns a JSON array of involvement types: ["committer", "commenter", "reviewer"]
# Note: "author" is checked separately from PR data
determine_pr_involvement() {
  local owner="$1"
  local repo="$2"
  local pr_number="$3"
  local username="$4"
  
  local involvement_types=()
  
  # Check commits: fetch PR commits and see if user authored/committed any
  local commit_count=$(gh api "repos/$owner/$repo/pulls/$pr_number/commits" --jq "[.[] | select(.author.login == \"$username\" or .committer.login == \"$username\")] | length" 2>/dev/null || echo "0")
  if [[ "$commit_count" =~ ^[0-9]+$ ]] && [[ "$commit_count" -gt 0 ]]; then
    involvement_types+=("committer")
  fi
  
  # Check review comments (PR-specific comments)
  local review_comment_count=$(gh api "repos/$owner/$repo/pulls/$pr_number/comments" --jq "[.[] | select(.user.login == \"$username\")] | length" 2>/dev/null || echo "0")
  if [[ "$review_comment_count" =~ ^[0-9]+$ ]] && [[ "$review_comment_count" -gt 0 ]]; then
    involvement_types+=("commenter")
  fi
  
  # Check issue comments (general PR comments)
  local issue_comment_count=$(gh api "repos/$owner/$repo/issues/$pr_number/comments" --jq "[.[] | select(.user.login == \"$username\")] | length" 2>/dev/null || echo "0")
  if [[ "$issue_comment_count" =~ ^[0-9]+$ ]] && [[ "$issue_comment_count" -gt 0 ]]; then
    involvement_types+=("commenter")
  fi
  
  # Check reviews
  local review_count=$(gh api "repos/$owner/$repo/pulls/$pr_number/reviews" --jq "[.[] | select(.user.login == \"$username\")] | length" 2>/dev/null || echo "0")
  if [[ "$review_count" =~ ^[0-9]+$ ]] && [[ "$review_count" -gt 0 ]]; then
    involvement_types+=("reviewer")
  fi
  
  # Output as JSON array, removing duplicates
  if [[ ${#involvement_types[@]} -eq 0 ]]; then
    echo "[]"
  else
    printf '%s\n' "${involvement_types[@]}" | sort -u | jq -R . | jq -s .
  fi
}

# Fetch PRs using GitHub search API for better qualifier support
if [[ "$DEBUG" == true ]]; then
  echo "Debug: Fetching PRs for user $USERNAME in org $ORG" >&2
  echo "Debug: Search query: $SEARCH_QUERY" >&2
  echo "Debug: State: $STATE" >&2
fi

# Use gh api search for PRs to support full search qualifiers
PR_SEARCH_QUERY="is:pr $SEARCH_QUERY"
if [[ "$STATE" != "all" ]]; then
  if [[ "$STATE" == "merged" ]]; then
    PR_SEARCH_QUERY="$PR_SEARCH_QUERY is:merged"
  elif [[ "$STATE" == "closed" ]]; then
    PR_SEARCH_QUERY="$PR_SEARCH_QUERY is:closed"
  elif [[ "$STATE" == "open" ]]; then
    PR_SEARCH_QUERY="$PR_SEARCH_QUERY is:open"
  fi
fi

# Fetch PRs using search API
PR_SEARCH_RESULT=$(gh api --paginate "search/issues?q=$(echo "$PR_SEARCH_QUERY" | jq -sRr @uri)&per_page=100" 2>&1) || {
  echo "Error: Failed to search for PRs. Check your GitHub CLI authentication and permissions." >&2
  if [[ "$DEBUG" == true ]]; then
    echo "Debug: Search query was: $PR_SEARCH_QUERY" >&2
    echo "Debug: Raw error output:" >&2
    echo "$PR_SEARCH_RESULT" >&2
  fi
  exit 1
}

# Extract PR data from search results and transform to match expected format
# Note: Search API returns items in .items array
# involves: already filters by user, so we only need to check org
# Repository info is in repository_url, need to parse it
PRS_JSON=$(echo "$PR_SEARCH_RESULT" | jq --arg org "$ORG" --arg user "$USERNAME" '
  if type == "object" and has("items") then
    .items
  elif type == "array" then
    .
  else
    []
  end |
  map(
    . as $item |
    ($item.repository_url | split("/") | {owner: .[-2], name: .[-1]}) as $repo |
    $item | select($repo.owner | ascii_downcase == ($org | ascii_downcase)) |
    {
      number: .number,
      title: .title,
      author: {login: .user.login},
      updatedAt: .updated_at,
      state: (if .pull_request.merged_at then "MERGED" elif .state == "open" then "OPEN" else "CLOSED" end),
      headRepository: {owner: {login: $repo.owner}, name: $repo.name},
      headRepositoryOwner: {login: $repo.owner},
      url: .html_url,
      labels: (.labels // [] | map({name: .name})),
      isDraft: .draft,
      reviewDecision: null,
      repository: {owner: {login: $repo.owner}, name: $repo.name}
    }
  )
')

# Enrich PRs with involvement types
# This determines how the user was involved: author, committer, commenter, reviewer
if [[ "$DEBUG" == true ]]; then
  echo "Debug: Enriching PRs with involvement types..." >&2
fi

# Convert PRS_JSON to array and enrich each PR
PRS_ENRICHED="[]"
PR_COUNT=$(echo "$PRS_JSON" | jq 'length')

if [[ "$PR_COUNT" -gt 0 ]]; then
  for i in $(seq 0 $((PR_COUNT - 1))); do
    PR=$(echo "$PRS_JSON" | jq ".[$i]")
    OWNER=$(echo "$PR" | jq -r '.repository.owner.login')
    REPO=$(echo "$PR" | jq -r '.repository.name')
    PR_NUM=$(echo "$PR" | jq -r '.number')
    AUTHOR=$(echo "$PR" | jq -r '.author.login')
    
    # Build involvement types array
    INVOLVEMENT_TYPES=()
    
    # Check if user is author
    if [[ "$AUTHOR" == "$USERNAME" ]]; then
      INVOLVEMENT_TYPES+=("author")
    fi
    
    # Check other involvement types
    OTHER_INVOLVEMENT=$(determine_pr_involvement "$OWNER" "$REPO" "$PR_NUM" "$USERNAME" 2>/dev/null || echo "[]")
    
    # Merge involvement types
    if [[ "$OTHER_INVOLVEMENT" != "[]" ]] && [[ -n "$OTHER_INVOLVEMENT" ]]; then
      # Add other involvement types (committer, commenter, reviewer)
      while IFS= read -r type; do
        if [[ -n "$type" ]] && [[ "$type" != "null" ]]; then
          INVOLVEMENT_TYPES+=("$type")
        fi
      done < <(echo "$OTHER_INVOLVEMENT" | jq -r '.[]')
    fi
    
    # Remove duplicates and create JSON array
    # Handle empty array case - if no types, create empty JSON array directly
    if [[ ${#INVOLVEMENT_TYPES[@]} -eq 0 ]]; then
      INVOLVEMENT_JSON='[]'
    else
      INVOLVEMENT_JSON=$(printf '%s\n' "${INVOLVEMENT_TYPES[@]}" | sort -u | jq -R . | jq -s .)
    fi
    
    # Note: We don't add a fallback "involved" type because involves: search includes
    # PRs where a review was requested, which shouldn't count as actual involvement.
    # Only PRs with detected involvement types (author, committer, commenter, reviewer)
    # will be shown.
    
    # Add involvement to PR object
    PR_ENRICHED=$(echo "$PR" | jq --argjson involvement "$INVOLVEMENT_JSON" '. + {involvement: $involvement}')
    PRS_ENRICHED=$(echo "$PRS_ENRICHED" | jq --argjson pr "$PR_ENRICHED" '. + [$pr]')
    
    if [[ "$DEBUG" == true ]]; then
      echo "Debug: PR #$PR_NUM in $OWNER/$REPO: involvement=$(echo "$INVOLVEMENT_JSON" | jq -r 'join(", ")')" >&2
    fi
  done
fi

PRS_JSON="$PRS_ENRICHED"

# Apply limit if specified
if [[ "$LIMIT" -gt 0 ]]; then
  PRS_JSON=$(echo "$PRS_JSON" | jq --argjson limit "$LIMIT" '.[0:$limit]')
fi

# Fetch issues using GitHub search API
if [[ "$DEBUG" == true ]]; then
  echo "Debug: Fetching issues for user $USERNAME in org $ORG" >&2
fi

# For issues, we need to handle state differently (no "merged" state)
ISSUE_STATE="$STATE"
if [[ "$ISSUE_STATE" == "merged" ]]; then
  ISSUE_STATE="all"
fi

# Use gh api search for issues
ISSUE_SEARCH_QUERY="is:issue $SEARCH_QUERY"
if [[ "$ISSUE_STATE" != "all" ]]; then
  if [[ "$ISSUE_STATE" == "closed" ]]; then
    ISSUE_SEARCH_QUERY="$ISSUE_SEARCH_QUERY is:closed"
  elif [[ "$ISSUE_STATE" == "open" ]]; then
    ISSUE_SEARCH_QUERY="$ISSUE_SEARCH_QUERY is:open"
  fi
fi

# Fetch issues using search API
ISSUE_SEARCH_RESULT=$(gh api --paginate "search/issues?q=$(echo "$ISSUE_SEARCH_QUERY" | jq -sRr @uri)&per_page=100" 2>&1) || {
  echo "Error: Failed to search for issues. Check your GitHub CLI authentication and permissions." >&2
  if [[ "$DEBUG" == true ]]; then
    echo "Debug: Search query was: $ISSUE_SEARCH_QUERY" >&2
    echo "Debug: Raw error output:" >&2
    echo "$ISSUE_SEARCH_RESULT" >&2
  fi
  exit 1
}

# Extract issue data from search results and transform to match expected format
# involves: already filters by user, so we only need to check org
# Repository info is in repository_url, need to parse it
ISSUES_JSON=$(echo "$ISSUE_SEARCH_RESULT" | jq --arg org "$ORG" --arg user "$USERNAME" '
  if type == "object" and has("items") then
    .items
  elif type == "array" then
    .
  else
    []
  end |
  map(
    . as $item |
    ($item.repository_url | split("/") | {owner: .[-2], name: .[-1]}) as $repo |
    $item | select($repo.owner | ascii_downcase == ($org | ascii_downcase)) |
    {
      number: .number,
      title: .title,
      author: {login: .user.login},
      updatedAt: .updated_at,
      state: (.state | ascii_upcase),
      url: .html_url,
      labels: (.labels // [] | map({name: .name})),
      assignees: [],
      comments: .comments,
      repository: {owner: {login: $repo.owner}, name: $repo.name}
    }
  )
')

# Apply limit if specified
if [[ "$LIMIT" -gt 0 ]]; then
  ISSUES_JSON=$(echo "$ISSUES_JSON" | jq --argjson limit "$LIMIT" '.[0:$limit]')
fi

# Output based on format
if [[ "$FORMAT" == "json" ]]; then
  echo "$PRS_JSON" | jq --argjson issues "$ISSUES_JSON" '{
    user: "'"$USERNAME"'",
    organization: "'"$ORG"'",
    days: '"$DAYS"',
    state: "'"$STATE"'",
    pull_requests: .,
    issues: $issues,
    summary: {
      pr_count: length,
      issue_count: ($issues | length)
    }
  }'
else
  # Human-readable format
  # Count only PRs with actual involvement (excludes e.g. review-requested-only)
  PR_COUNT=$(echo "$PRS_JSON" | jq '[.[] | select((.involvement | length) > 0)] | length')
  ISSUE_COUNT=$(echo "$ISSUES_JSON" | jq 'length')
  TOTAL=$((PR_COUNT + ISSUE_COUNT))
  
  echo "GitHub Activity Report"
  echo "User: $USERNAME | Organization: $ORG"
  echo "Period: Last $DAYS days (since $SINCE)"
  echo "State: $STATE"
  echo "Found: $PR_COUNT PRs, $ISSUE_COUNT issues (Total: $TOTAL)"
  echo ""
  
  if [[ $TOTAL -eq 0 ]]; then
    echo "No activity found matching the criteria."
    echo ""
    echo "Search criteria:"
    echo "  - User: $USERNAME"
    echo "  - Organization: $ORG"
    echo "  - Updated in last $DAYS days (since $SINCE)"
    echo "  - State: $STATE"
    echo ""
    echo "Try:"
    echo "  - Increasing days: $0 $USERNAME $ORG --days $((DAYS * 2))"
    echo "  - Checking different state: $0 $USERNAME $ORG --state open"
    if [[ "$DEBUG" != true ]]; then
      echo "  - Debug mode: $0 $USERNAME $ORG --debug"
    fi
    exit 0
  fi
  
  # Get terminal width
  TERM_WIDTH=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}
  
  # Fixed column widths (no repo column since we group by repo)
  NUM_WIDTH=8
  STATE_WIDTH=8
  UPDATED_WIDTH=10
  SPACING=3
  
  # Calculate title width
  TITLE_WIDTH=$((TERM_WIDTH - NUM_WIDTH - STATE_WIDTH - UPDATED_WIDTH - SPACING))
  if [[ $TITLE_WIDTH -lt 20 ]]; then
    TITLE_WIDTH=20
  fi
  
  # Group PRs by involvement type, then by repository
  # Define involvement type labels, order, and colors for section headings
  INVOLVEMENT_TYPES=("author" "committer" "reviewer" "commenter")
  INVOLVEMENT_LABELS=("Authored" "Committed to" "Reviewed" "Commented on")
  # ANSI colors: green, blue, cyan, yellow (bold)
  INVOLVEMENT_COLORS=("32" "34" "36" "33")
  
  # Display PRs grouped by involvement type
  INVOLVEMENT_INDEX=0
  FIRST_SECTION=true
  for INVOLVEMENT_TYPE in "${INVOLVEMENT_TYPES[@]}"; do
    INVOLVEMENT_LABEL="${INVOLVEMENT_LABELS[$INVOLVEMENT_INDEX]}"
    INVOLVEMENT_COLOR="${INVOLVEMENT_COLORS[$INVOLVEMENT_INDEX]}"
    
    # Get PRs where user has this involvement type
    TYPE_PRS=$(echo "$PRS_JSON" | jq --arg type "$INVOLVEMENT_TYPE" '[.[] | select(.involvement | index($type))]')
    TYPE_PR_COUNT=$(echo "$TYPE_PRS" | jq 'length')
    
    if [[ $TYPE_PR_COUNT -gt 0 ]]; then
      # Add spacing between sections (except before first)
      if [[ "$FIRST_SECTION" != true ]]; then
        echo ""
      fi
      FIRST_SECTION=false
      
      # Print involvement type header (bold + color, count in gray)
      echo -e "\033[1;${INVOLVEMENT_COLOR}m$INVOLVEMENT_LABEL\033[0m \033[90m($TYPE_PR_COUNT PRs)\033[0m"
      echo ""
      
      # Get unique repos for this involvement type
      TYPE_REPOS=$(echo "$TYPE_PRS" | jq 'map(.repository) | unique_by(.name) | .[]' -c)
      
      # Loop through repositories for this involvement type
      REPO_INDEX=0
      REPO_ARRAY=()
      while IFS= read -r repo; do
        REPO_ARRAY+=("$repo")
      done < <(echo "$TYPE_REPOS")
      
      for repo in "${REPO_ARRAY[@]}"; do
        REPO_NAME=$(echo "$repo" | jq -r '.name')
        
        # Filter PRs for this repo and involvement type
        REPO_PRS=$(echo "$TYPE_PRS" | jq --arg repo "$REPO_NAME" --arg type "$INVOLVEMENT_TYPE" '[.[] | select(.repository.name == $repo and (.involvement | index($type)))]')
        REPO_PR_COUNT=$(echo "$REPO_PRS" | jq 'length')
        
        if [[ $REPO_PR_COUNT -gt 0 ]]; then
          # Print repository sub-header (dimmed, smaller)
          # Add spacing between repos (but not before first)
          if [[ $REPO_INDEX -gt 0 ]]; then
            echo ""
          fi
          echo -e "\033[90m$REPO_NAME\033[0m"
          REPO_INDEX=$((REPO_INDEX + 1))
          
          # Table header (no indentation to maximize width)
          printf "%-${NUM_WIDTH}s %-${STATE_WIDTH}s %-${UPDATED_WIDTH}s %-${TITLE_WIDTH}s\n" \
            "Number" "State" "Updated" "Title"
          
          printf "%-${NUM_WIDTH}s %-${STATE_WIDTH}s %-${UPDATED_WIDTH}s %-${TITLE_WIDTH}s\n" \
            "$(printf '%*s' $NUM_WIDTH '' | tr ' ' '-')" \
            "$(printf '%*s' $STATE_WIDTH '' | tr ' ' '-')" \
            "$(printf '%*s' $UPDATED_WIDTH '' | tr ' ' '-')" \
            "$(printf '%*s' $TITLE_WIDTH '' | tr ' ' '-')"
          
          echo "$REPO_PRS" | jq -r '.[] | 
            "\(.number)|\(.state)|\(.updatedAt)|\(.isDraft)|\(.reviewDecision // "none")|\(.title)"' | \
          while IFS='|' read -r number state updated draft review title; do
            relative=$(relative_time "$updated")
            state_fmt=$(format_state "$state" "$draft")
            
            # Truncate title
            title_short="${title:0:$((TITLE_WIDTH - 3))}"
            [[ ${#title} -gt $((TITLE_WIDTH - 3)) ]] && title_short="${title_short}..."
            
            printf "%-${NUM_WIDTH}s %s %-${UPDATED_WIDTH}s %-${TITLE_WIDTH}s\n" \
              "#$number" "$state_fmt" "$relative" "$title_short"
            
            # Show review status on second line if present
            review_fmt=$(format_review "$review")
            if [[ -n "$review_fmt" ]]; then
              printf "%-${NUM_WIDTH}s %-${STATE_WIDTH}s %-${UPDATED_WIDTH}s %-${TITLE_WIDTH}s\n" \
                "" "" "" "  └─ $review_fmt"
            fi
          done
        fi
      done
    fi
    
    INVOLVEMENT_INDEX=$((INVOLVEMENT_INDEX + 1))
  done
  
  # Display issues grouped by repository (issues don't have involvement types)
  ISSUE_REPOS=$(echo "$ISSUES_JSON" | jq 'map(.repository) | unique_by(.name) | .[]' -c)
  ISSUE_TOTAL=$(echo "$ISSUES_JSON" | jq 'length')
  
  if [[ $ISSUE_TOTAL -gt 0 ]]; then
    # Add spacing before issues section if PRs were shown
    if [[ $PR_COUNT -gt 0 ]]; then
      echo ""
    fi
    
    # Print issues section header
    # Issues section heading (bold magenta to distinguish from PR sections)
    echo -e "\033[1;35mIssues\033[0m \033[90m($ISSUE_TOTAL issues)\033[0m"
    echo ""
    
    ISSUE_REPO_INDEX=0
    ISSUE_REPO_ARRAY=()
    while IFS= read -r repo; do
      ISSUE_REPO_ARRAY+=("$repo")
    done < <(echo "$ISSUE_REPOS")
    
    for repo in "${ISSUE_REPO_ARRAY[@]}"; do
      REPO_NAME=$(echo "$repo" | jq -r '.name')
      
      # Filter issues for this repo
      REPO_ISSUES=$(echo "$ISSUES_JSON" | jq --arg repo "$REPO_NAME" '[.[] | select(.repository.name == $repo)]')
      REPO_ISSUE_COUNT=$(echo "$REPO_ISSUES" | jq 'length')
      
      # Skip repos with no issues
      if [[ $REPO_ISSUE_COUNT -eq 0 ]]; then
        continue
      fi
      
      # Print repository sub-header (dimmed, smaller)
      # Add spacing between repos (but not before first)
      if [[ $ISSUE_REPO_INDEX -gt 0 ]]; then
        echo ""
      fi
      echo -e "\033[90m$REPO_NAME\033[0m"
      ISSUE_REPO_INDEX=$((ISSUE_REPO_INDEX + 1))
      
      # Table header (no indentation to maximize width)
      printf "%-${NUM_WIDTH}s %-${STATE_WIDTH}s %-${UPDATED_WIDTH}s %-${TITLE_WIDTH}s\n" \
        "Number" "State" "Updated" "Title"
      
      printf "%-${NUM_WIDTH}s %-${STATE_WIDTH}s %-${UPDATED_WIDTH}s %-${TITLE_WIDTH}s\n" \
        "$(printf '%*s' $NUM_WIDTH '' | tr ' ' '-')" \
        "$(printf '%*s' $STATE_WIDTH '' | tr ' ' '-')" \
        "$(printf '%*s' $UPDATED_WIDTH '' | tr ' ' '-')" \
        "$(printf '%*s' $TITLE_WIDTH '' | tr ' ' '-')"
      
      echo "$REPO_ISSUES" | jq -r '.[] | 
        "\(.number)|\(.state)|\(.updatedAt)|\(.title)"' | \
      while IFS='|' read -r number state updated title; do
        relative=$(relative_time "$updated")
        state_fmt=$(format_state "$state" "false")
        
        # Truncate title
        title_short="${title:0:$((TITLE_WIDTH - 3))}"
        [[ ${#title} -gt $((TITLE_WIDTH - 3)) ]] && title_short="${title_short}..."
        
        printf "%-${NUM_WIDTH}s %s %-${UPDATED_WIDTH}s %-${TITLE_WIDTH}s\n" \
          "#$number" "$state_fmt" "$relative" "$title_short"
      done
    done
  fi
fi
