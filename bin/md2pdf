#!/bin/bash

# Function to process the markdown file
process_file() {
    local input_file="$1"
    local output="${input_file%.*}.pdf"
    local no_toc="$2"

    echo "Processing $input_file..."
    
    local pandoc_args=(
        "$input_file"
        -f markdown+footnotes
        --pdf-engine=xelatex
        --variable mainfont="DejaVu Sans"
        --variable fontsize=12pt
        --variable linestretch=1.3
        --variable geometry:margin=1in
        --variable linkcolor=blue
        --variable urlcolor=blue
        --variable toccolor=blue
        --variable table-cell-padding=10pt
        --variable header-includes="\usepackage{fancyhdr}\pagestyle{fancy}\fancyhead{}\fancyfoot{}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}\setlength{\headheight}{15pt}"
        -V colorlinks=true
    )
    
    # Add TOC options only if not disabled
    if [ "$no_toc" != "true" ]; then
        pandoc_args+=(--toc --toc-depth=3)
    fi
    
    pandoc_args+=(--output "$output")
    
    pandoc "${pandoc_args[@]}"

    echo "Generated $output"

    # Run markdown-link-check if available
    if command -v markdown-link-check >/dev/null 2>&1; then
        markdown-link-check "$input_file"
    elif command -v pnpm >/dev/null 2>&1 && command -v npx >/dev/null 2>&1; then
        pnpm markdown-link-check "$input_file" 2>/dev/null || npx markdown-link-check "$input_file" 2>/dev/null || true
    fi
}

# Parse command line arguments
watch_mode=false
no_toc=false
input_file=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --watch)
            watch_mode=true
            shift
            ;;
        --no-toc)
            no_toc=true
            shift
            ;;
        *)
            input_file="$1"
            shift
            ;;
    esac
done

# Check for required dependencies early
if ! command -v pandoc >/dev/null 2>&1; then
    echo "Error: pandoc is not installed. Please install pandoc package."
    exit 1
fi

if ! command -v xelatex >/dev/null 2>&1; then
    echo "Error: xelatex is not installed. Please install texlive-xetex package."
    exit 1
fi

# Check if inotifywait is available when watch mode is enabled
if [ "$watch_mode" = true ] && ! command -v inotifywait >/dev/null 2>&1; then
    echo "Error: inotifywait is not installed. Please install inotify-tools package."
    exit 1
fi

# Check if input file is provided
if [ -z "$input_file" ]; then
    echo "Usage: $0 [--watch] [--no-toc] <input.md>"
    exit 1
fi

# Convert input file to absolute path to work from any location
if [ ! -f "$input_file" ]; then
    echo "Input file not found: $input_file"
    exit 1
fi

# Get absolute path of input file
if command -v realpath >/dev/null 2>&1; then
    input_file=$(realpath "$input_file")
elif command -v readlink >/dev/null 2>&1; then
    # Fallback for systems without realpath
    if [ -L "$input_file" ]; then
        input_file=$(readlink -f "$input_file")
    else
        # Convert relative path to absolute
        if [[ "$input_file" != /* ]]; then
            input_file="$(cd "$(dirname "$input_file")" && pwd)/$(basename "$input_file")"
        fi
    fi
else
    # Manual absolute path conversion
    if [[ "$input_file" != /* ]]; then
        input_file="$(cd "$(dirname "$input_file")" && pwd)/$(basename "$input_file")"
    fi
fi

# Initial processing
process_file "$input_file" "$no_toc"

# Watch mode
if [ "$watch_mode" = true ]; then
    echo "Watching $input_file for changes... (Press Ctrl+C to stop)"
    while true; do
        inotifywait -e modify "$input_file"
        process_file "$input_file" "$no_toc"
    done
fi
