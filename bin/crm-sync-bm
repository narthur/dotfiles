#!/usr/bin/env bash

# Sync CRM activity to Beeminder goals
# Counts modified CRM docs and contacts touched for the last 7 days

# Source environment variables
source ~/.env

# Fail loudly if we can't actually read the CRM directory.
# macOS protects ~/Documents with TCC; a scheduled job (cron/launchd) without
# file access is silently denied, which makes `find` return 0 and would zero out
# the Beeminder goals. Refuse to sync rather than overwrite real data with zeros.
if [ -z "$CRM_DIR" ]; then
  echo "ERROR: CRM_DIR is unset (check ~/.env). Refusing to sync." >&2
  exit 1
fi
total_md=$(find "$CRM_DIR" -type f -name "*.md" 2>/dev/null | wc -l | tr -d ' ')
if [ "$total_md" -eq 0 ]; then
  echo "ERROR: Found 0 .md files under CRM_DIR ($CRM_DIR)." >&2
  echo "Likely missing file access (macOS Full Disk Access / TCC) or a bad path." >&2
  echo "Refusing to sync zeros to Beeminder." >&2
  exit 1
fi

# Portable date helpers
if date --version >/dev/null 2>&1; then
    # GNU date (Linux)
    days_ago_date() { date -d "$1 days ago" +%Y-%m-%d; }
    next_day_date() { date -d "$1 +1 day" +%Y-%m-%d; }
    find_modified_between() {
        local dir="$1" start="$2" end="$3"
        find "$dir" -type f -name "*.md" -newermt "$start 00:00:00" ! -newermt "$end 00:00:00" 2>/dev/null
    }
else
    # BSD date (macOS)
    days_ago_date() { date -v-"$1"d +%Y-%m-%d; }
    next_day_date() { date -j -v+1d -f "%Y-%m-%d" "$1" +%Y-%m-%d; }
    find_modified_between() {
        local dir="$1" start="$2" end="$3"
        local tmpstart tmpend
        tmpstart=$(mktemp)
        tmpend=$(mktemp)
        touch -t "$(date -j -f '%Y-%m-%d %H:%M:%S' "$start 00:00:00" '+%Y%m%d%H%M.%S')" "$tmpstart"
        touch -t "$(date -j -f '%Y-%m-%d %H:%M:%S' "$end 00:00:00" '+%Y%m%d%H%M.%S')" "$tmpend"
        find "$dir" -type f -name "*.md" -newer "$tmpstart" ! -newer "$tmpend" 2>/dev/null
        rm -f "$tmpstart" "$tmpend"
    }
fi

# Helper function to check if a datapoint should be updated
# Returns 0 (success) if update should proceed, 1 (failure) if it should be skipped
should_update() {
  local goalslug=$1
  local requestid=$2
  local new_value=$3
  
  # Get existing datapoint value (if any) for this requestid
  existing_value=$(buzz view "$goalslug" --json --datapoints 2>/dev/null | \
    jq -r --arg rid "$requestid" '.datapoints[] | select(.requestid == $rid) | .value' | \
    head -1)
  
  # If no existing value, update
  if [ -z "$existing_value" ]; then
    return 0
  fi
  
  # Compare: update only if new value is greater
  if (( $(echo "$new_value > $existing_value" | bc -l) )); then
    return 0
  fi
  
  return 1
}

# Process the last 14 days
for i in {0..13}; do
  # Calculate date for this iteration (i days ago)
  date_ymd=$(days_ago_date "$i")
  date_yyyymmdd=$(echo "$date_ymd" | tr -d '-')

  # Count CRM docs modified on this date
  next_date=$(next_day_date "$date_ymd")
  modified_count=$(find_modified_between "$CRM_DIR" "$date_ymd" "$next_date" | wc -l | tr -d ' ')
  
  # Count contacts with Last Contact date of this date
  touched_count=$(find "$CRM_DIR" -type f -name "*.md" -exec grep -l "^Last Contact: $date_ymd" {} \; 2>/dev/null | wc -l | tr -d ' ')
  
  # Add datapoint to rolofresh goal
  echo "Syncing rolofresh: $modified_count modified CRM docs for $date_ymd"
  if should_update rolofresh "$date_ymd" "$modified_count"; then
    buzz add --requestid "$date_ymd" --daystamp "$date_yyyymmdd" rolofresh "$modified_count" "CRM docs modified on $date_ymd (updated $(date '+%Y-%m-%d %H:%M:%S'))"
  else
    existing_value=$(buzz view rolofresh --json --datapoints 2>/dev/null | \
      jq -r --arg rid "$date_ymd" '.datapoints[] | select(.requestid == $rid) | .value' | head -1)
    echo "Skipping rolofresh update: existing value ($existing_value) is greater than or equal to new value ($modified_count)"
  fi
  
  # Add datapoint to rolotouch goal
  echo "Syncing rolotouch: $touched_count contacts touched on $date_ymd"
  if should_update rolotouch "$date_ymd" "$touched_count"; then
    buzz add --requestid "$date_ymd" --daystamp "$date_yyyymmdd" rolotouch "$touched_count" "Contacts touched on $date_ymd"
  else
    existing_value=$(buzz view rolotouch --json --datapoints 2>/dev/null | \
      jq -r --arg rid "$date_ymd" '.datapoints[] | select(.requestid == $rid) | .value' | head -1)
    echo "Skipping rolotouch update: existing value ($existing_value) is greater than or equal to new value ($touched_count)"
  fi
done

echo "Sync complete."
