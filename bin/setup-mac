#!/usr/bin/env bash

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log() {
    echo -e "${BLUE}[$(date '+%Y-%m-%d %H:%M:%S')]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[$(date '+%Y-%m-%d %H:%M:%S')] ✓${NC} $1"
}

log_error() {
    echo -e "${RED}[$(date '+%Y-%m-%d %H:%M:%S')] ✗${NC} $1" >&2
}

log_section() {
    echo ""
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  $1${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

run() {
    local description="$1"
    shift
    log "Running: $description"
    if "$@"; then
        log_success "$description"
        return 0
    else
        log_error "$description failed (exit code: $?)"
        return 1
    fi
}

# Detect architecture
ARCH=$(uname -m)
if [ "$ARCH" = "arm64" ]; then
    PLATFORM_ARCH="arm64"
else
    PLATFORM_ARCH="amd64"
fi

log_section "Brew Packages"
run "brew bundle install" brew bundle --global

log_section "PostgreSQL Client (libpq)"
# libpq ships psql (and pg_dump, etc.) but is keg-only, so Homebrew won't put it
# on PATH by default (it would clash with a full postgresql formula). Force-link
# it so `psql` is available. Idempotent: skip if psql already resolves.
if command -v psql &>/dev/null; then
    log_success "psql already on PATH"
else
    run "link libpq" brew link --force libpq
fi

log_section "asdf Plugins & Versions"
run "setup asdf" setup-asdf

log_section "Global pnpm Packages"
run "pnpm setup" pnpm setup
export PNPM_HOME="${PNPM_HOME:-$HOME/Library/pnpm}"
mkdir -p "$PNPM_HOME"
export PATH="$PNPM_HOME:$PATH"
run "install neonctl" pnpm install -g neonctl
run "install surge" pnpm install -g surge

log_section "Binary Manager (bin)"
# Pre-configure bin to install to ~/.local/bin (non-interactive)
mkdir -p "$HOME/.local/bin"
if [ ! -f "$HOME/.config/bin/config.json" ]; then
    mkdir -p "$HOME/.config/bin"
    printf '{"default_path":"%s/.local/bin","bins":{}}\n' "$HOME" > "$HOME/.config/bin/config.json"
fi
if ! command -v bin &>/dev/null; then
    log "bin not found, installing..."
    BIN_VERSION="0.24.2"
    BIN_URL="https://github.com/marcosnils/bin/releases/download/v${BIN_VERSION}/bin_${BIN_VERSION}_darwin_${PLATFORM_ARCH}"
    run "download bin" curl -L -o /tmp/bin-bootstrap "$BIN_URL"
    run "make bin executable" chmod +x /tmp/bin-bootstrap
    run "install bin" /tmp/bin-bootstrap install github.com/marcosnils/bin
else
    log_success "bin already installed"
fi

run "update bin" bin update bin
run "ensure buzz installed" bash -c 'bin ensure buzz || bin install github.com/pinepeakdigital/buzz'
run "ensure sysmon installed" bash -c 'bin ensure sysmon || bin install github.com/PinePeakDigital/sysmon'

log_section "scanline"
# scanline drives ICA scanners (e.g. the Brother DS-740D) from the CLI; used by
# ~/bin/scan on macOS. It isn't in brew or installable via `bin` (it ships only
# as a notarized .pkg), so extract the signed universal binary from the pkg
# payload into ~/.local/bin — no sudo and no installer required.
if ! command -v scanline &>/dev/null; then
    log "scanline not found, installing..."
    SCANLINE_VERSION="2.3"
    SCANLINE_TMP="$(mktemp -d)"
    run "download scanline" curl -fsSL -o "$SCANLINE_TMP/scanline.pkg" \
        "https://github.com/klep/scanline/raw/master/scanline-${SCANLINE_VERSION}.pkg"
    run "extract scanline" bash -c "cd '$SCANLINE_TMP' && pkgutil --expand scanline.pkg expanded && tar xf expanded/Payload"
    run "install scanline" install -m 0755 "$SCANLINE_TMP/usr/local/bin/scanline" "$HOME/.local/bin/scanline"
    rm -rf "$SCANLINE_TMP"
else
    log_success "scanline already installed"
fi
# The Brother DS-740D ICA scanner driver still can't be installed non-interactively
# (system driver: needs sudo + a System Settings approval), so flag it as a manual step.
log "Scanner driver is manual: run 'scan --check' to verify the DS-740D + ICA driver"

log_section "GitHub CLI Extensions"
gh extension list | grep -q poi || run "install gh-poi" gh extension install seachicken/gh-poi

log_section "LLM Plugins"
run "install llm-anthropic" llm install llm-anthropic
run "install llm-ollama" llm install llm-ollama

log_section "Cron"
run "setup cron" setup-cron

log_section "Claude Code"
if ! command -v claude &>/dev/null; then
    log "claude not found, installing..."
    run "install claude" bash -c 'curl -fsSL https://claude.ai/install.sh | bash'
else
    log_success "claude already installed"
fi

log_section "Claude Code Hooks"
# Register the ActivityWatch activity-tracking hooks in the machine-local
# ~/.claude/settings.json (which isn't tracked in dotfiles). Idempotent.
run "register Claude activity hooks" setup-claude-hooks

log_section "Bun"
if ! command -v bun &>/dev/null; then
    log "bun not found, installing..."
    run "install bun" bash -c 'curl -fsSL https://bun.sh/install | bash'
else
    log_success "bun already installed"
fi

# Make bun available in current session if just installed
export PATH="$HOME/.bun/bin:$PATH"

log_section "Vite+"
# VP_NODE_MANAGER=no: node comes from asdf, so skip the installer's interactive prompt.
if [ ! -x "$HOME/.vite-plus/bin/vp" ]; then
    log "vp not found, installing..."
    run "install vite-plus" bash -c 'curl -fsSL https://vite.plus | VP_NODE_MANAGER=no bash'
else
    log_success "vp already installed"
fi

log_section "YNAB CLI"
if ! command -v ynab &>/dev/null; then
    log "ynab not found, installing..."
    run "install ynab-cli" bun install -g @stephendolan/ynab-cli
else
    log_success "ynab already installed"
fi
# Auth is interactive (stores a token in the macOS keychain) — can't be automated here.
# `ynab auth status` always exits 0; it reports state as JSON, so grep the field.
if ynab auth status 2>/dev/null | grep -Eq '"authenticated":[[:space:]]*true'; then
    log_success "ynab authenticated"
else
    log "ynab not authenticated — run: ynab auth login  (token: https://app.ynab.com/settings/developer)"
fi

log_section "Colima"
run "enable colima service" brew services start colima

log_section "Ollama"
run "enable ollama service" brew services start ollama
# Wait for the Ollama API to come up before pulling (brew services start is async)
for _ in $(seq 1 30); do
    curl -fsS http://127.0.0.1:11434/api/version &>/dev/null && break
    sleep 1
done
# Local coding models (4-bit GGUF). 14B = offline quality driver; 7B = snappy/battery.
# Each is skipped if already pulled. See Fieldnotes "Local LLM Setup on Mac".
for model in qwen2.5-coder:14b qwen2.5-coder:7b; do
    if ollama list 2>/dev/null | grep -q "^${model}"; then
        log_success "${model} already pulled"
    else
        run "pull ${model}" ollama pull "$model"
    fi
done

log_section "LaunchAgents"
# Install + (re)load all hand-maintained LaunchAgents templated from
# ~/.config/launchd (crm-sync-bm, aw-qt, aw-active, backup-urls). brew-managed
# agents like colima/ollama are handled by `brew services` above.
run "setup launchd agents" setup-launchd

log_section "xbar"
mkdir -p "$HOME/Library/Application Support/xbar"
if [ ! -L "$HOME/Library/Application Support/xbar/plugins" ]; then
    rm -rf "$HOME/Library/Application Support/xbar/plugins"
    run "symlink xbar plugins" ln -sf "$HOME/.config/xbar/plugins" "$HOME/Library/Application Support/xbar/plugins"
else
    log_success "xbar plugins symlink already exists"
fi

log_section "Complete"
log_success "macOS setup complete!"
