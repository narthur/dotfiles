#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: to-markdown <file> [<file> ...]"
    echo ""
    echo "Converts files to Markdown format. Supported types:"
    echo "  .doc                                    — converted via libreoffice + pandoc"
    echo "  .docx, .odt, .epub, .rst, .html, .htm  — converted via pandoc"
    echo "  .pdf                                    — extracted via pdftotext"
    echo "  .txt                                    — copied as-is"
    exit 1
}

[[ $# -eq 0 ]] && usage

EXIT_CODE=0

convert_file() {
    local input="$1"
    local ext="${input##*.}"
    ext="${ext,,}"  # lowercase
    local output="${input%.*}.md"

    if [[ -e "$output" ]]; then
        echo "SKIP: $output already exists" >&2
        return 1
    fi

    case "$ext" in
        doc)
            local tmpdir
            tmpdir=$(mktemp -d)
            local docx_file
            docx_file="$tmpdir/$(basename "${input%.*}.docx")"
            libreoffice --headless --convert-to docx --outdir "$tmpdir" "$input" >/dev/null 2>&1 \
                && pandoc "$docx_file" -t markdown -o "$output"
            local rc=$?
            rm -rf "$tmpdir"
            [[ $rc -eq 0 ]] || { echo "ERROR: conversion failed: $input" >&2; rm -f "$output"; return 1; }
            ;;
        docx|odt|epub|rst|html|htm)
            pandoc "$input" -t markdown -o "$output" || { echo "ERROR: conversion failed: $input" >&2; rm -f "$output"; return 1; }
            ;;
        pdf)
            pdftotext "$input" - > "$output" || { echo "ERROR: conversion failed: $input" >&2; rm -f "$output"; return 1; }
            ;;
        txt)
            cp "$input" "$output" || { echo "ERROR: conversion failed: $input" >&2; rm -f "$output"; return 1; }
            ;;
        md|markdown)
            echo "SKIP: $input is already a Markdown file" >&2
            return 1
            ;;
        *)
            echo "ERROR: Unsupported file type: .$ext ($input)" >&2
            return 1
            ;;
    esac

    echo "OK: $input -> $output"
}

for file in "$@"; do
    if [[ ! -f "$file" ]]; then
        echo "ERROR: File not found: $file" >&2
        EXIT_CODE=1
        continue
    fi

    if ! convert_file "$file"; then
        EXIT_CODE=1
    fi
done

exit $EXIT_CODE
