#!/bin/bash

gh extension install seachicken/gh-poi

# Set up gh cli aliases
gh alias set agents '!open "https://github.com/copilot/agents"'
gh alias set co 'pr checkout'
gh alias set ic '!gh-ic "$@"'
gh alias set involved 'search issues --involves @me --state open'
gh alias set mine 'search prs --author @me'
gh alias set next 'search issues --assignee @me --state open --sort updated --order desc'
gh alias set stale 'search issues --involves @me --state open --sort updated --order asc --limit 3'
gh alias set watch-prs '!watch -n 10 gh pr list'