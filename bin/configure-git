#!/bin/bash

gh extension install seachicken/gh-poi

# Set up gh cli aliases
gh alias set --clobber agents '!open "https://github.com/copilot/agents"'
gh alias set --clobber co 'pr checkout'
gh alias set --clobber ic '!gh-ic "$@"'
gh alias set --clobber watch-prs '!watch -n 10 gh pr list'
gh alias set --clobber stale 'issue list --search "sort:updated-asc -label:snooze"'