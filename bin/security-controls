#!/usr/bin/env bash
# Check that expected security controls are still in place and write the
# result for pilot's sweep to read. Runs daily from launchd
# (com.narthur.security-controls), outside the Claude Code sandbox, because
# the sandbox hides listening ports, launchctl state and fdesetup output.
#
# Outputs, in $OBSIDIAN_VAULT/Skill Data/pilot/security/:
#   controls.tsv   "# checked <ISO time>", then check<TAB>ok|FAIL|UNKNOWN<TAB>detail
#   inventory.tsv  kind<TAB>item<TAB>fingerprint (see the Inventory section)
#
# A finding is not a job failure: this exits 0 whenever it wrote both files.
# Retiring a control = delete its line here and record why in the
# "Pilot Security Watch" fieldnote, not dismiss its card forever.
set -uo pipefail

VAULT="${OBSIDIAN_VAULT:-$HOME/Obsidian/Main}"
OUT_DIR="$VAULT/Skill Data/pilot/security"
OUT="$OUT_DIR/controls.tsv"
mkdir -p "$OUT_DIR" || exit 1
TMP="$(mktemp "$OUT_DIR/.controls.XXXXXX")" || exit 1
ITMP="$(mktemp "$OUT_DIR/.inventory.XXXXXX")" || exit 1
trap 'rm -f "$TMP" "$ITMP"' EXIT

row() { printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$TMP"; }

printf '# checked %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$TMP"

# --- listening services --------------------------------------------------------
# netstat sees every socket regardless of owner. If it reports no listeners at
# all, it was blocked (as inside the sandbox), so the port checks are UNKNOWN.
listen="$(netstat -an -p tcp 2>/dev/null | awk '$6=="LISTEN"{print $4}')"
disabled="$(launchctl print-disabled system 2>/dev/null)"

# label service port
port_check() {
  local label="$1" svc="$2" port="$3" state
  if [ -z "$listen" ]; then
    row "$label" UNKNOWN "netstat returned no listeners at all"; return
  fi
  if printf '%s\n' "$listen" | grep -qE "[.:]$port\$"; then
    row "$label" FAIL "something is listening on port $port"; return
  fi
  state="$(printf '%s\n' "$disabled" | grep -F "\"$svc\"" | sed -E 's/.*=> *//')"
  case "$state" in
    disabled|true) row "$label" ok "port $port closed; $svc disabled" ;;
    enabled|false) row "$label" FAIL "$svc enabled in launchd (port $port not open yet)" ;;
    *)             row "$label" ok "port $port closed; launchd state not listed" ;;
  esac
}
port_check remote-login   com.openssh.sshd         22
port_check screen-sharing com.apple.screensharing  5900

# --- platform protections -------------------------------------------------------
fw="$(/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate 2>&1)"
case "$fw" in
  *enabled*)  row firewall ok "$fw" ;;
  *disabled*) row firewall FAIL "$fw" ;;
  *)          row firewall UNKNOWN "${fw:-no output}" ;;
esac

fv="$(fdesetup status 2>&1 | head -1)"
case "$fv" in
  "FileVault is On."*)  row filevault ok "$fv" ;;
  "FileVault is Off."*) row filevault FAIL "$fv" ;;
  *)                    row filevault UNKNOWN "${fv:-no output}" ;;
esac

sip="$(csrutil status 2>&1)"
case "$sip" in
  *"status: enabled."*) row sip ok "enabled" ;;
  *"status: enabled"*)  row sip FAIL "partly disabled: $(printf '%s' "$sip" | head -1)" ;;
  *"status: disabled"*) row sip FAIL "disabled" ;;
  *)                    row sip UNKNOWN "${sip:-no output}" ;;
esac

gk="$(spctl --status 2>&1)"
case "$gk" in
  "assessments enabled")  row gatekeeper ok "$gk" ;;
  "assessments disabled") row gatekeeper FAIL "$gk" ;;
  *)                      row gatekeeper UNKNOWN "${gk:-no output}" ;;
esac

au="$(defaults read /Library/Preferences/com.apple.SoftwareUpdate AutomaticallyInstallMacOSUpdates 2>/dev/null)"
case "$au" in
  1) row macos-auto-install ok "AutomaticallyInstallMacOSUpdates = 1" ;;
  0) row macos-auto-install FAIL "AutomaticallyInstallMacOSUpdates = 0" ;;
  *) row macos-auto-install UNKNOWN "key not set" ;;
esac

# --- Claude Code hooks ------------------------------------------------------------
# A hook counts only if settings.json references it AND the script exists.
SETTINGS="$HOME/.claude/settings.json"
hook_cmds="$(jq -r '.. | objects | .command? // empty' "$SETTINGS" 2>/dev/null)"
# egress-guard retired on purpose (too many false alarms); see the fieldnote.
for hook in sensitive-file-guard; do
  if [ ! -r "$SETTINGS" ]; then
    row "hook:$hook" UNKNOWN "cannot read $SETTINGS"
  elif ! printf '%s\n' "$hook_cmds" | grep -q "$hook"; then
    row "hook:$hook" FAIL "not referenced in settings.json"
  else
    path="$(printf '%s\n' "$hook_cmds" | grep -m1 "$hook" | awk '{print $1}')"
    path="${path/#\~/$HOME}"
    if [ -x "$path" ]; then row "hook:$hook" ok "$path"
    else row "hook:$hook" FAIL "configured but $path is missing or not executable"
    fi
  fi
done

mv "$TMP" "$OUT" || exit 1
echo "wrote $(grep -vc '^#' "$OUT") checks to $OUT"

# === Inventory ===================================================================
# A sorted list of what can run or persist on this machine, for pilot to diff
# against inventory.baseline (the accepted list). One line per item:
#   kind<TAB>item<TAB>fingerprint
# Fingerprints are metadata only (hash, signer, mode, symlink target, state or
# "-"), never file contents: crontab lines, hosts entries and scripts can hold
# secrets. Each external command also writes a "source<TAB>name<TAB>ok|unavailable"
# row, so a source that stops working is one card instead of a silent gap.
INV="$OUT_DIR/inventory.tsv"
inv() { printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$ITMP"; }
src() { inv source "$1" "$2"; }
hash12() { local s; s="$(shasum -a 256 "$@" 2>/dev/null | cut -c1-12)"; echo "${s:-unreadable}"; }

# "dotfiles-clean" when the file matches HEAD in a dot repo, so routine dotfile
# commits don't churn the inventory; otherwise a content hash.
fingerprint() {
  local f="$1" rel="${1#$HOME/}" repo obj
  obj="$(git hash-object "$f" 2>/dev/null)"
  if [ -n "$obj" ]; then
    for repo in "$HOME/.dotfiles" "$HOME/.dotfiles-private"; do
      [ "$(git --git-dir="$repo" rev-parse -q --verify "HEAD:$rel" 2>/dev/null)" = "$obj" ] \
        && { echo dotfiles-clean; return; }
    done
  fi
  hash12 "$f"
}

signer() {
  local s
  [ -n "$1" ] || { echo unparsed; return; }
  [ -e "$1" ] || { echo missing; return; }
  s="$(codesign -dv --verbose=2 "$1" 2>&1 | sed -n 's/^Authority=//p' | head -1)"
  echo "${s:-unsigned}"
}

# Run a source command; record whether it worked; print its stdout.
collect() {
  local name="$1" out; shift
  if out="$("$@" 2>/dev/null)"; then src "$name" ok; else src "$name" unavailable; fi
  printf '%s\n' "$out" | grep -v '^$'
}

# launchd plists: hash of the plist + signer of what it runs.
for dir in "$HOME/Library/LaunchAgents" /Library/LaunchAgents /Library/LaunchDaemons; do
  for p in "$dir"/*.plist; do
    [ -e "$p" ] || continue
    prog="$(plutil -extract Program raw -o - "$p" 2>/dev/null || plutil -extract ProgramArguments.0 raw -o - "$p" 2>/dev/null)"
    inv launchd "$p" "$(hash12 "$p") $(signer "$prog")"
  done
done

# Loaded jobs that aren't Apple's. Per-launch "application.*" labels and
# PID-suffixed ones are dropped as noise.
collect launchctl launchctl list | awk 'NR>1{print $3}' \
  | grep -vE '^(com\.apple\.|application\.)|\.[0-9]+$' | sort -u \
  | while read -r l; do inv loaded "$l" -; done

# Rows: enabled active teamID bundleID (version) name [state]
collect systemextensionsctl systemextensionsctl list \
  | awk -F'\t' 'NF>=6 && $3!="teamID"{b=$4; sub(/ \(.*/,"",b); print b"\t"$5" "$6}' \
  | while IFS=$'\t' read -r id rest; do inv sysext "$id" "$rest"; done
collect profiles profiles list | sed -n 's/.*profileIdentifier: *//p' \
  | while read -r id; do inv profile "$id" -; done

# crontab -l exits 1 for "no crontab", so it isn't a source check. Item is the
# schedule only (arguments can hold tokens); the hash tells lines apart.
crontab -l 2>/dev/null | grep -vE '^\s*(#|$)' | while read -r line; do
  inv cron "$(printf '%s' "$line" | awk '/^[A-Za-z_]+=/{print "env"; next}{print $1" "$2" "$3" "$4" "$5}')" \
    "$(printf '%s' "$line" | shasum -a 256 | cut -c1-12)"
done
inv hosts /etc/hosts "$(hash12 /etc/hosts)"

# ~/.ssh: mode for every file; content hash only for files that are public or
# config (authorized_keys, config, *.pub) — never hash a private key.
if [ -r "$HOME/.ssh" ]; then src ssh-dir ok; else src ssh-dir unavailable; fi
for f in "$HOME"/.ssh/*; do
  [ -e "$f" ] || continue
  case "${f##*/}" in
    authorized_keys|config|*.pub) inv ssh "$f" "$(stat -f %Sp "$f") $(hash12 "$f")" ;;
    *)                            inv ssh "$f" "$(stat -f %Sp "$f")" ;;
  esac
done

for f in "$HOME"/.zshrc "$HOME"/.zshenv "$HOME"/.zprofile "$HOME"/.zlogin \
         "$HOME"/.bashrc "$HOME"/.bash_profile "$HOME"/.profile \
         /etc/zshrc /etc/zprofile /etc/zshenv /etc/profile; do
  [ -f "$f" ] && inv startup "$f" "$(fingerprint "$f")"
done

# ponytail: /opt/homebrew/bin is left out — its Cellar symlinks churn on every
# brew upgrade. Add it with Cellar/<name>/<ver> normalized if that matters.
for dir in "$HOME/bin" "$HOME/.local/bin" /usr/local/bin; do
  for f in "$dir"/*; do
    # A trailing /versions/<ver> in a symlink target is wildcarded so
    # auto-updates (claude) don't churn.
    if [ -L "$f" ]; then inv path "$f" "-> $(readlink "$f" | sed -E 's#/versions/[^/]+$#/versions/*#')"
    elif [ -f "$f" ] && [ -x "$f" ]; then inv path "$f" "$(fingerprint "$f")"
    fi
  done
done

# Browser extensions, by id only (versions update constantly).
for root in "$HOME/Library/Application Support/Google/Chrome" \
            "$HOME/Library/Application Support/BraveSoftware/Brave-Browser" \
            "$HOME/Library/Application Support/Microsoft Edge" \
            "$HOME/Library/Application Support/Vivaldi" \
            "$HOME/Library/Application Support/Firefox/Profiles"; do
  for e in "$root"/*/Extensions/* "$root"/*/extensions/*; do
    [ -e "$e" ] && [ "${e##*/}" != Temp ] && inv browser-ext "${root##*/}/$(basename "$(dirname "$(dirname "$e")")")" "$(basename "$e")"
  done
done

# Global packages, names only. npm is an asdf shim; the plist PATH includes it.
collect npm npm ls -g --depth=0 --parseable | tail -n +2 | sed 's#.*/node_modules/##' \
  | while read -r n; do inv npm-global "$n" -; done
collect pip3 pip3 list --user --format=freeze | sed -E 's/[ =@].*//' \
  | while read -r n; do inv pip-user "$n" -; done

# This user's listeners bound beyond loopback, by process (lsof without root
# can't see root daemons; the controls half checks ports 22/5900 via netstat).
# Port numbers are dropped because dev servers make them churn.
collect lsof lsof -nP -iTCP -sTCP:LISTEN | awk 'NR>1 && $9 !~ /^(127\.|\[::1\]|localhost)/{print $1}' \
  | sort -u | while read -r c; do inv listen "$c" all-interfaces; done

LC_ALL=C sort -u "$ITMP" -o "$ITMP"   # C order: sweep's comm must match
mv "$ITMP" "$INV" || exit 1
echo "wrote $(wc -l < "$INV" | tr -d ' ') inventory items to $INV"
