#!/bin/bash

set -euo pipefail

[ "$(uname -s)" = Linux ] || { echo "setup-linux: not Linux, exiting" >&2; exit 1; }

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log() {
    echo -e "${BLUE}[$(date '+%Y-%m-%d %H:%M:%S')]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[$(date '+%Y-%m-%d %H:%M:%S')] ✓${NC} $1"
}

log_error() {
    echo -e "${RED}[$(date '+%Y-%m-%d %H:%M:%S')] ✗${NC} $1" >&2
}

log_section() {
    echo ""
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}  $1${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

# Run a command with logging
run() {
    local description="$1"
    shift
    log "Running: $description"
    if "$@"; then
        log_success "$description"
        return 0
    else
        log_error "$description failed (exit code: $?)"
        return 1
    fi
}

log_section "Repo Prerequisites"
# The repo blocks below fetch keys with wget and dearmor them with gpg, before packages.txt is installed.
run "apt update for prerequisites" sudo apt update
run "install wget and gnupg" sudo apt install -y wget gnupg

log_section "Proton VPN Repo"
# Source: https://protonvpn.com/support/linux-vpn-debian-ubuntu
# Must precede the apt install: packages.txt lists proton-vpn-gnome-desktop.
if ! dpkg -s protonvpn-stable-release &> /dev/null; then
    log "proton repo not found, installing..."
    deb=/tmp/protonvpn-stable-release_1.0.8_all.deb
    run "download proton release package" wget -nv -O "$deb" https://repo.protonvpn.com/debian/dists/stable/main/binary-all/protonvpn-stable-release_1.0.8_all.deb
    run "verify proton release package" bash -c "echo '0b14e71586b22e498eb20926c48c7b434b751149b1f2af9902ef1cfe6b03e180  $deb' | sha256sum --check -"
    run "install proton release package" sudo dpkg -i "$deb"
else
    log_success "proton repo already installed"
fi

log_section "Vendor Apt Repos"
# Keyrings are refreshed every run, not just on first install: GitHub and HashiCorp
# rotate their signing keys, and a stale keyring silently freezes the repo.
# Must precede the apt install: packages.txt lists gh and terraform.
# Sources: https://github.com/cli/cli/blob/trunk/docs/install_linux.md
#          https://developer.hashicorp.com/terraform/install
run "create keyrings directory" sudo mkdir -p -m 755 /etc/apt/keyrings
out=$(mktemp)
run "download gh keyring" wget -nv -O"$out" https://cli.github.com/packages/githubcli-archive-keyring.gpg
run "install gh keyring" sudo install -m 644 "$out" /etc/apt/keyrings/githubcli-archive-keyring.gpg
run "add gh apt source" bash -c 'echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null'
run "download hashicorp keyring" wget -nv -O"$out" https://apt.releases.hashicorp.com/gpg
run "dearmor hashicorp keyring" gpg --yes --dearmor -o "$out.gpg" "$out"
run "install hashicorp keyring" sudo install -m 644 "$out.gpg" /usr/share/keyrings/hashicorp-archive-keyring.gpg
run "add hashicorp apt source" bash -c 'echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(. /etc/os-release && echo ${UBUNTU_CODENAME:-$VERSION_CODENAME}) main" | sudo tee /etc/apt/sources.list.d/hashicorp.list > /dev/null'
rm -f "$out" "$out.gpg"

log_section "Apt Packages"
run "apt update" sudo apt update
run "apt install packages" sudo apt install -y $(grep -v '^#' ~/packages.txt | tr '\n' ' ')

log_section "snixembed"
# Proton VPN's tray icon is StatusNotifierItem-only; i3bar only hosts XEmbed icons.
# snixembed bridges the two. Not packaged in Debian, so build it (deps in packages.txt).
if [ ! -x "$HOME/.local/bin/snixembed" ]; then
    log "snixembed not found, building..."
    src=$(mktemp -d)
    run "clone snixembed" git clone -q --depth 1 -b 0.3.3 https://git.sr.ht/~steef/snixembed "$src"
    run "build snixembed" make -C "$src" install PREFIX="$HOME/.local"
    rm -rf "$src"
else
    log_success "snixembed already installed"
fi

log_section "Brew Packages"
# Homebrew refuses formulae from untrusted taps. Trust exactly the tap formulae
# the Brewfile lists (not whole taps), so the Brewfile stays the one list of what's trusted.
run "trust Brewfile tap formulae" bash -c 'brew trust --formula $(sed -nE '\''s/^brew "([^"/]+\/[^"/]+\/[^"]+)".*/\1/p'\'' ~/.Brewfile)'
run "brew bundle install" brew bundle install --global

log_section "Pipx Packages"
run "pipx ensurepath" pipx ensurepath
run "pipx install rofimoji" pipx install rofimoji
run "pipx install ggshield" pipx install ggshield
run "pipx install stack-pr" pipx install stack-pr

log_section "Binary Manager (bin)"
if ! command -v bin &> /dev/null; then
    log "bin not found, installing..."
    run "download bin" curl -L -o /tmp/bin https://github.com/marcosnils/bin/releases/download/v0.24.2/bin_0.24.2_linux_amd64
    run "install bin" /tmp/bin install github.com/marcosnils/bin
else
    log "bin already installed"
fi

run "update bin" bin update bin
run "ensure buzz installed" bash -c 'bin ensure buzz || bin install github.com/pinepeakdigital/buzz'
run "ensure sysmon installed" bash -c 'bin ensure sysmon || bin install github.com/PinePeakDigital/sysmon'

log_section "GitHub CLI Extensions"
gh extension list | grep -q poi || run "install gh-poi" gh extension install seachicken/gh-poi

log_section "asdf Plugins"
run "add nodejs plugin" asdf plugin add nodejs https://github.com/asdf-vm/asdf-nodejs.git || true
run "add pnpm plugin" asdf plugin add pnpm || true
run "add ruby plugin" asdf plugin add ruby https://github.com/asdf-vm/asdf-ruby.git || true
run "add go plugin" asdf plugin add golang https://github.com/asdf-community/asdf-golang.git || true

log_section "asdf"
run "install global tools" bash -c 'cd ~ && asdf install'

log_section "Go tools"
# review-loop needs looper >= v0.2.10 at exactly this path (a PATH lookup is deliberately not used).
# `record pending --all -h` is the same version probe review-loop's Step 0 uses: v0.2.9 and older reject `-all`.
if ! ~/.local/bin/looper record pending --all -h &> /dev/null; then
    run "install looper" bash -c 'cd ~ && GOBIN=~/.local/bin go install github.com/pinepeakdigital/looper/cmd/looper@v0.2.10'
else
    log_success "looper already installed"
fi

log_section "Global pnpm packages"
run "install neonctl" bash -c 'cd ~ && pnpm install -g neonctl'
run "install surge" bash -c 'cd ~ && pnpm install -g surge'

log_section "LLM Plugins"
run "install llm-anthropic" llm install llm-anthropic

log_section "Flatpak packages"
run "add flathub remote" flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
run "install slack" flatpak install flathub com.slack.Slack

log_section "AWS CLI"
if ! command -v aws &> /dev/null; then
    log "aws not found, installing..."
    run "install aws" bash -c 'cd /tmp && curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" && unzip awscliv2.zip && sudo ./aws/install'
else
    log_success "aws already installed"
fi

log_section "Ghostty"
# Not in Debian's repos; ghostty.org points Debian users at the community ghostty-ubuntu .deb.
# Source: https://ghostty.org/docs/install/binary
# ponytail: pinned version, bump the URL + sha256 to upgrade.
if ! command -v ghostty &> /dev/null; then
    log "ghostty not found, installing..."
    deb=/tmp/ghostty_1.3.1-0.ppa2_amd64_trixie.deb
    run "download ghostty" wget -nv -O "$deb" https://github.com/mkasberg/ghostty-ubuntu/releases/download/1.3.1-0-ppa2/ghostty_1.3.1-0.ppa2_amd64_trixie.deb
    run "verify ghostty" bash -c "echo '9fda8e418d7a7f58149ba3ba823a255d6b80f8bb5431b3bd7e912ff597715b2e  $deb' | sha256sum --check -"
    run "install ghostty" sudo apt install -y "$deb"
else
    log_success "ghostty already installed"
fi

log_section "Claude Code"
if ! command -v claude &> /dev/null; then
    log "claude not found, installing..."
    run "install claude" curl -fsSL https://claude.ai/install.sh | bash
else
    log_success "claude already installed"
fi

log_section "Ollama"
if ! command -v ollama &> /dev/null; then
    log "ollama not found, installing..."
    run "install ollama" curl -fsSL https://ollama.com/install.sh | bash
else
    log_success "ollama already installed"
fi

log_section "Devcontainers CLI"
if ! command -v devcontainer &> /dev/null; then
    log "devcontainer not found, installing..."
    run "install devcontainer" curl -fsSL https://raw.githubusercontent.com/devcontainers/cli/main/scripts/install.sh | bash
else
    log_success "devcontainer already installed"
fi

log_section "Bun"
if ! command -v bun &> /dev/null; then
    log "bun not found, installing..."
    run "install bun" bash -c 'curl -fsSL https://bun.sh/install | bash'
else
    log_success "bun already installed"
fi

log_section "Vite+"
# VP_NODE_MANAGER=no: node comes from asdf, so skip the installer's interactive prompt.
if [ ! -x "$HOME/.vite-plus/bin/vp" ] && [ ! -x "$HOME/.local/share/vite-plus/bin/vp" ]; then
    log "vp not found, installing..."
    run "install vite-plus" bash -c 'curl -fsSL https://vite.plus | VP_NODE_MANAGER=no bash'
else
    log_success "vp already installed"
fi

log_section "YNAB CLI"
if ! command -v ynab &> /dev/null; then
    log "ynab not found, installing..."
    run "install ynab-cli" bun install -g @stephendolan/ynab-cli
else
    log_success "ynab already installed"
fi
# Keychain storage needs libsecret-1-dev (in packages.txt). Auth is interactive and
# can't be automated; without a keychain, fall back to the YNAB_API_KEY env var.
# `ynab auth status` always exits 0; it reports state as JSON, so grep the field.
if ynab auth status 2> /dev/null | grep -Eq '"authenticated":[[:space:]]*true'; then
    log_success "ynab authenticated"
else
    log "ynab not authenticated — run: ynab auth login  (token: https://app.ynab.com/settings/developer)"
fi

log_section "Private Setup"
# Setup steps tracked in the dotprivate repo. Optional by design: a fresh clone
# of the public dotfiles alone will not have it, and that is a valid machine.
if [ -x "$HOME/bin/setup-linux-private" ]; then
    run "private setup" "$HOME/bin/setup-linux-private"
else
    log_success "no private setup script (dotprivate not installed)"
fi

log_section "Complete"
log_success "All packages installed successfully!"
