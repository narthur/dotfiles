#!/bin/bash
# Sensitive-file checker for Claude Code Edit/Write/NotebookEdit calls.
#
# Takes a target file path as $1. Detects whether the path is a
# security-sensitive surface where an autonomous edit — especially one steered
# by untrusted issue/PR content — could plant a persistent attack (e.g. a
# malicious CI workflow that exfiltrates secrets on the next push) or tamper
# with credentials. The wrapper turns a match into permissionDecision "ask",
# re-inserting a human checkpoint regardless of permission mode.
#
# Output: on a match, prints a short category reason to stdout.
# Exit 0 = not sensitive (caller stays silent / allows).
# Exit 1 = sensitive (caller asks).
#
# This is a DETECTOR, not a blocker: legitimate edits still proceed with one
# confirmation. Scope is intentionally narrow + high-signal to avoid nagging on
# ordinary code; these paths are rarely touched in routine work.

path="$1"
[[ -z "$path" ]] && exit 0

# Case-insensitive [[ =~ ]] matching, portable to bash 3.2 (macOS /bin/bash),
# which lacks the ${var,,} lowercase expansion.
shopt -s nocasematch

# (regex, reason) pairs, split on ASCII Unit Separator (\x1f).
patterns=(
  "(^|/)\.github/workflows/"$'\x1f'"GitHub Actions workflow (runs in CI with repo secrets)"
  "(^|/)\.github/actions/"$'\x1f'"GitHub composite action (runs in CI)"
  "(^|/)\.gitlab-ci\.yml$"$'\x1f'"GitLab CI config"
  "(^|/)\.circleci/"$'\x1f'"CircleCI config"
  "(^|/)jenkinsfile$"$'\x1f'"Jenkins pipeline"
  "(^|/)azure-pipelines\.ya?ml$"$'\x1f'"Azure Pipelines config"
  "(^|/)\.drone\.yml$"$'\x1f'"Drone CI config"
  "(^|/)bitbucket-pipelines\.yml$"$'\x1f'"Bitbucket Pipelines config"
  "(^|/)cloudbuild\.ya?ml$"$'\x1f'"Google Cloud Build config"
  "(^|/)\.env(\.|$)"$'\x1f'"environment / secrets file"
  "(^|/)id_(rsa|ed25519|ecdsa|dsa)(\.pub)?$"$'\x1f'"SSH private/public key"
  "(^|/)\.ssh/"$'\x1f'"SSH config/keys directory"
  "(^|/)authorized_keys$"$'\x1f'"SSH authorized_keys"
  "\.pem$"$'\x1f'"PEM key/cert"
  "\.key$"$'\x1f'"private key file"
  "\.(p12|pfx|keystore|jks)$"$'\x1f'"keystore / PKCS#12 bundle"
  "(^|/)\.npmrc$"$'\x1f'"npm credentials (.npmrc)"
  "(^|/)\.netrc$"$'\x1f'"netrc credentials"
  "(^|/)\.git-credentials$"$'\x1f'"git stored credentials"
  "(^|/)\.pgpass$"$'\x1f'"Postgres password file"
  "(^|/)\.aws/(credentials|config)$"$'\x1f'"AWS credentials/config"
  "(^|/)\.htpasswd$"$'\x1f'"htpasswd auth file"
  "(^|/)\.dockercfg$"$'\x1f'"Docker registry credentials"
  "(^|/)\.docker/config\.json$"$'\x1f'"Docker registry credentials"
)

# .env.example / .env.sample / .env.template / .env.dist / .env.defaults are
# placeholders, not secrets — never prompt on those.
if [[ "$path" =~ (^|/)\.env\.(example|sample|template|dist|defaults)$ ]]; then
  exit 0
fi

for entry in "${patterns[@]}"; do
  regex="${entry%%$'\x1f'*}"
  reason="${entry##*$'\x1f'}"
  if [[ "$path" =~ $regex ]]; then
    echo "$reason"
    exit 1
  fi
done

exit 0
