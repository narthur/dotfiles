#!/bin/bash
# View Claude Code token usage statistics

log_dir="$HOME/.claude/token-usage"

# Function to convert a local datetime string to UTC ISO 8601
# Uses epoch as intermediate to avoid GNU date -d/-u quirks
local_to_utc() {
    local epoch
    epoch=$(date -d "$1" +%s)
    date -d "@$epoch" -u +"%Y-%m-%dT%H:%M:%SZ"
}

# Function to normalize a date to UTC ISO 8601 format
# Handles local timezone conversion and date-only inputs
normalize_date() {
    local input="$1"
    local position="$2"  # "start" or "end"

    # Check if date-only (YYYY-MM-DD)
    if [[ "$input" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        if [ "$position" = "start" ]; then
            # Beginning of day in local timezone, converted to UTC
            local_to_utc "${input} 00:00:00"
        else
            # End of day in local timezone, converted to UTC
            local_to_utc "${input} 23:59:59"
        fi
    elif [[ "$input" =~ Z$ ]]; then
        # Already UTC, use as-is
        echo "$input"
    else
        # Has time but no Z suffix - treat as local time, convert to UTC
        local_to_utc "$input"
    fi
}

# Parse date arguments
start_date=""
end_date=""
start_date_display=""
end_date_display=""
command=""
command_args=()

while [[ $# -gt 0 ]]; do
    case $1 in
        --start)
            start_date_display="$2"
            start_date=$(normalize_date "$2" "start")
            shift 2
            ;;
        --end)
            end_date_display="$2"
            end_date=$(normalize_date "$2" "end")
            shift 2
            ;;
        *)
            # This is the command or its arguments
            if [ -z "$command" ]; then
                command="$1"
            else
                command_args+=("$1")
            fi
            shift
            ;;
    esac
done

# Set command to summary if not specified
command="${command:-summary}"

# Check if log directory exists
if [ ! -d "$log_dir" ]; then
    echo "No token usage data found yet."
    exit 0
fi

# Function to filter data by date range
filter_by_date() {
    local input_file="$1"
    local filter='true'
    
    if [ -n "$start_date" ]; then
        filter="$filter and (.timestamp >= \"$start_date\")"
    fi
    
    if [ -n "$end_date" ]; then
        filter="$filter and (.timestamp <= \"$end_date\")"
    fi
    
    jq -c "select($filter)" "$input_file"
}

# Create filtered data file if date filters are specified
if [ -n "$start_date" ] || [ -n "$end_date" ]; then
    temp_dir=$(mktemp -d)
    trap "rm -rf $temp_dir" EXIT
    
    # Filter all-repos.jsonl
    if [ -f "$log_dir/all-repos.jsonl" ]; then
        filter_by_date "$log_dir/all-repos.jsonl" > "$temp_dir/all-repos.jsonl"
    fi
    
    # Filter individual repo files
    for file in "$log_dir"/*.jsonl; do
        if [ "$(basename "$file")" != "all-repos.jsonl" ] && [ -f "$file" ]; then
            basename=$(basename "$file")
            filter_by_date "$file" > "$temp_dir/$basename"
        fi
    done
    
    # Use filtered data
    log_dir="$temp_dir"
    
    # Show date range in output
    echo "Date range filter:"
    if [ -n "$start_date" ]; then
        if [ "$start_date_display" != "$start_date" ]; then
            echo "  Start: $start_date_display ($start_date UTC)"
        else
            echo "  Start: $start_date"
        fi
    fi
    if [ -n "$end_date" ]; then
        if [ "$end_date_display" != "$end_date" ]; then
            echo "  End: $end_date_display ($end_date UTC)"
        else
            echo "  End: $end_date"
        fi
    fi
    echo ""
fi

# Pricing configuration
pricing_file="$HOME/.claude/pricing.json"
pricing_loaded=false

# Function to load pricing configuration
load_pricing() {
    if [ -f "$pricing_file" ]; then
        if jq empty "$pricing_file" 2>/dev/null; then
            pricing_loaded=true
        else
            echo "Warning: Invalid pricing file format. Cost calculations disabled." >&2
            pricing_loaded=false
        fi
    else
        pricing_loaded=false
    fi
}

# Function to get base model name from full model identifier
# e.g., claude-haiku-4-5-20251001 -> claude-haiku-4-5
get_base_model_name() {
    local model="$1"
    # Extract base model name by removing date suffix (format: YYYYMMDD)
    echo "$model" | sed -E 's/-[0-9]{8}$//'
}

# Function to get pricing for a model
get_model_pricing() {
    local model="$1"
    local base_model=$(get_base_model_name "$model")
    
    if [ "$pricing_loaded" = false ]; then
        echo ""
        return
    fi
    
    # Try to find matching pricing entry (exact match)
    jq -r --arg base "$base_model" '.models | to_entries | map(select(.key == $base)) | .[0].value // empty' "$pricing_file" 2>/dev/null
}

# Function to calculate cost in dollars
calculate_cost() {
    local model="$1"
    local input_tokens="$2"
    local output_tokens="$3"
    local cache_creation_tokens="$4"
    local cache_read_tokens="$5"
    
    if [ "$pricing_loaded" = false ]; then
        echo ""
        return
    fi
    
    local pricing=$(get_model_pricing "$model")
    if [ -z "$pricing" ]; then
        echo ""
        return
    fi
    
    local input_price=$(echo "$pricing" | jq -r '.input_per_million // 0')
    local output_price=$(echo "$pricing" | jq -r '.output_per_million // 0')
    local cache_write_price=$(echo "$pricing" | jq -r '.cache_write_per_million // 0')
    local cache_read_price=$(echo "$pricing" | jq -r '.cache_read_per_million // 0')
    
    # Calculate cost: (tokens / 1,000,000) * price_per_million
    local cost=$(echo "scale=4; ($input_tokens / 1000000) * $input_price + ($output_tokens / 1000000) * $output_price + ($cache_creation_tokens / 1000000) * $cache_write_price + ($cache_read_tokens / 1000000) * $cache_read_price" | bc)
    
    echo "$cost"
}

# Function to format cost for display
format_cost() {
    local cost="$1"
    if [ -z "$cost" ] || [ "$cost" = "0" ] || [ "$(echo "$cost < 0.01" | bc)" = "1" ]; then
        echo ""
    else
        printf "$%.2f" "$cost"
    fi
}

# Load pricing at startup
load_pricing

# Function to display stats for a file
show_stats() {
    local file="$1"
    local basename=$(basename "$file" .jsonl)
    
    if [ ! -f "$file" ] || [ ! -s "$file" ]; then
        return
    fi
    
    # Calculate totals
    local total_input=$(jq -s 'map(.tokens.input) | add' "$file")
    local total_output=$(jq -s 'map(.tokens.output) | add' "$file")
    local total_cache_creation=$(jq -s 'map(.tokens.cache_creation) | add' "$file")
    local total_cache_read=$(jq -s 'map(.tokens.cache_read) | add' "$file")
    local total_all=$(jq -s 'map(.tokens.total) | add' "$file")
    local session_count=$(jq -s 'length' "$file")
    
    # Get repo path from first entry
    local repo_path=$(jq -r '.[0].repo_path' <(jq -s '.' "$file"))
    
    # Calculate effective billable tokens
    # Input: 1x, Output: 3x, Cache creation: 1.25x, Cache read: 0.1x
    local effective_billable=$(echo "$total_input + ($total_output * 3) + ($total_cache_creation * 1.25) + ($total_cache_read * 0.1)" | bc)
    
    # Calculate estimated cost
    local total_cost=0
    if [ "$pricing_loaded" = true ]; then
        # Group by model and calculate cost per model group, then sum
        local cost_sum=0
        while IFS= read -r line; do
            local model=$(echo "$line" | jq -r '.model')
            local model_input=$(echo "$line" | jq -r '.tokens.input')
            local model_output=$(echo "$line" | jq -r '.tokens.output')
            local model_cache_creation=$(echo "$line" | jq -r '.tokens.cache_creation')
            local model_cache_read=$(echo "$line" | jq -r '.tokens.cache_read')
            local model_cost=$(calculate_cost "$model" "$model_input" "$model_output" "$model_cache_creation" "$model_cache_read")
            if [ -n "$model_cost" ] && [ "$(echo "$model_cost > 0" | bc)" = "1" ]; then
                cost_sum=$(echo "$cost_sum + $model_cost" | bc)
            fi
        done < <(jq -s 'group_by(.model) | map({model: .[0].model, tokens: {input: (map(.tokens.input) | add), output: (map(.tokens.output) | add), cache_creation: (map(.tokens.cache_creation) | add), cache_read: (map(.tokens.cache_read) | add)}})' "$file" 2>/dev/null | jq -c '.[]')
        total_cost="$cost_sum"
    fi
    
    echo "Repository: $repo_path"
    echo "Sessions: $session_count"
    echo "Total tokens: $total_all"
    echo "  - Input: $total_input"
    echo "  - Output: $total_output"
    echo "  - Cache creation: $total_cache_creation"
    echo "  - Cache read: $total_cache_read"
    printf "Effective billable tokens: %.0f (at typical rates: input=1x, output=3x, cache_creation=1.25x, cache_read=0.1x)\n" "$effective_billable"
    
    local formatted_cost=$(format_cost "$total_cost")
    if [ -n "$formatted_cost" ]; then
        echo "Estimated cost: $formatted_cost"
    fi
    echo ""
}

# Execute command
case "$command" in
    summary)
        echo "=== Claude Code Token Usage Summary ==="
        echo ""
        
        # Show repositories grouped by client
        if [ -f "$log_dir/all-repos.jsonl" ] && [ -s "$log_dir/all-repos.jsonl" ]; then
            # Get unique clients (normalized to lowercase)
            clients=$(jq -r '.client // "unknown"' "$log_dir/all-repos.jsonl" | tr '[:upper:]' '[:lower:]' | sort -u)
            
            while IFS= read -r client_name; do
                echo "════════════════════════════════════════════════"
                echo "Client: $client_name"
                echo "════════════════════════════════════════════════"
                echo ""
                
                # Show repos for this client
                for file in "$log_dir"/*.jsonl; do
                    if [ "$(basename "$file")" != "all-repos.jsonl" ]; then
                        # Check if this repo belongs to this client
                        repo_client=$(jq -r '.[0].client // "unknown"' <(jq -s '.' "$file") | tr '[:upper:]' '[:lower:]')
                        if [ "$repo_client" = "$client_name" ]; then
                            show_stats "$file"
                        fi
                    fi
                done
            done <<< "$clients"
        else
            for file in "$log_dir"/*.jsonl; do
                if [ "$(basename "$file")" != "all-repos.jsonl" ]; then
                    show_stats "$file"
                fi
            done
        fi
        
        # Show breakdown by model
        echo "=== Usage by Model ==="
        echo ""
        if [ -f "$log_dir/all-repos.jsonl" ] && [ -s "$log_dir/all-repos.jsonl" ]; then
            jq -s 'group_by(.model) | map({model: .[0].model, sessions: length, tokens: {input: (map(.tokens.input) | add), output: (map(.tokens.output) | add), cache_creation: (map(.tokens.cache_creation) | add), cache_read: (map(.tokens.cache_read) | add), total: (map(.tokens.total) | add)}})' "$log_dir/all-repos.jsonl" 2>/dev/null | jq -c '.[]' | while read -r line; do
                model_name=$(echo "$line" | jq -r '.model')
                sessions=$(echo "$line" | jq -r '.sessions')
                total=$(echo "$line" | jq -r '.tokens.total')
                input=$(echo "$line" | jq -r '.tokens.input')
                output=$(echo "$line" | jq -r '.tokens.output')
                cache_creation=$(echo "$line" | jq -r '.tokens.cache_creation')
                cache_read=$(echo "$line" | jq -r '.tokens.cache_read')
                effective=$(echo "$input + ($output * 3) + ($cache_creation * 1.25) + ($cache_read * 0.1)" | bc)
                
                # Calculate cost
                cost=$(calculate_cost "$model_name" "$input" "$output" "$cache_creation" "$cache_read")
                formatted_cost=$(format_cost "$cost")
                
                echo "Model: $model_name"
                echo "  Sessions: $sessions"
                echo "  Total tokens: $total"
                echo "  - Input: $input"
                echo "  - Output: $output"
                echo "  - Cache creation: $cache_creation"
                echo "  - Cache read: $cache_read"
                printf "  Effective billable: %.0f\n" "$effective"
                if [ -n "$formatted_cost" ]; then
                    echo "  Estimated cost: $formatted_cost"
                fi
                echo ""
            done
        fi
        
        # Show breakdown by client
        echo "=== Usage by Client ==="
        echo ""
        if [ -f "$log_dir/all-repos.jsonl" ] && [ -s "$log_dir/all-repos.jsonl" ]; then
            jq -s 'map(.client |= (. // "unknown" | ascii_downcase)) | group_by(.client) | map({client: .[0].client, sessions: length, tokens: {input: (map(.tokens.input) | add), output: (map(.tokens.output) | add), cache_creation: (map(.tokens.cache_creation) | add), cache_read: (map(.tokens.cache_read) | add), total: (map(.tokens.total) | add)}})' "$log_dir/all-repos.jsonl" 2>/dev/null | jq -c '.[]' | while read -r line; do
                client_name=$(echo "$line" | jq -r '.client')
                sessions=$(echo "$line" | jq -r '.sessions')
                total=$(echo "$line" | jq -r '.tokens.total')
                input=$(echo "$line" | jq -r '.tokens.input')
                output=$(echo "$line" | jq -r '.tokens.output')
                cache_creation=$(echo "$line" | jq -r '.tokens.cache_creation')
                cache_read=$(echo "$line" | jq -r '.tokens.cache_read')
                effective=$(echo "$input + ($output * 3) + ($cache_creation * 1.25) + ($cache_read * 0.1)" | bc)
                
                # Calculate cost - need to get models for this client
                client_cost=0
                if [ "$pricing_loaded" = true ]; then
                    while IFS= read -r model_line; do
                        model=$(echo "$model_line" | jq -r '.model')
                        model_input=$(echo "$model_line" | jq -r '.tokens.input')
                        model_output=$(echo "$model_line" | jq -r '.tokens.output')
                        model_cache_creation=$(echo "$model_line" | jq -r '.tokens.cache_creation')
                        model_cache_read=$(echo "$model_line" | jq -r '.tokens.cache_read')
                        model_cost=$(calculate_cost "$model" "$model_input" "$model_output" "$model_cache_creation" "$model_cache_read")
                        if [ -n "$model_cost" ] && [ "$(echo "$model_cost > 0" | bc)" = "1" ]; then
                            client_cost=$(echo "$client_cost + $model_cost" | bc)
                        fi
                    done < <(jq -s --arg client "$client_name" 'map(.client |= (. // "unknown" | ascii_downcase)) | map(select(.client == $client)) | group_by(.model) | map({model: .[0].model, tokens: {input: (map(.tokens.input) | add), output: (map(.tokens.output) | add), cache_creation: (map(.tokens.cache_creation) | add), cache_read: (map(.tokens.cache_read) | add)}})' "$log_dir/all-repos.jsonl" 2>/dev/null | jq -c '.[]')
                fi
                formatted_cost=$(format_cost "$client_cost")
                
                echo "Client: $client_name"
                echo "  Sessions: $sessions"
                echo "  Total tokens: $total"
                echo "  - Input: $input"
                echo "  - Output: $output"
                echo "  - Cache creation: $cache_creation"
                echo "  - Cache read: $cache_read"
                printf "  Effective billable: %.0f\n" "$effective"
                if [ -n "$formatted_cost" ]; then
                    echo "  Estimated cost: $formatted_cost"
                fi
                echo ""
            done
        fi
        ;;
    
    all)
        echo "=== All Repositories Combined ==="
        echo ""
        show_stats "$log_dir/all-repos.jsonl"
        ;;
    
    client)
        if [ ${#command_args[@]} -eq 0 ]; then
            echo "Usage: $0 client <name> [--start DATE] [--end DATE]"
            exit 1
        fi
        
        client_name=$(echo "${command_args[0]}" | tr '[:upper:]' '[:lower:]')
        
        if [ ! -f "$log_dir/all-repos.jsonl" ]; then
            echo "No token usage data found yet."
            exit 1
        fi
        
        # Check if client exists
        if ! jq -r '.client // "unknown"' "$log_dir/all-repos.jsonl" | tr '[:upper:]' '[:lower:]' | grep -qx "$client_name"; then
            echo "No data found for client: ${command_args[0]}"
            echo ""
            echo "Available clients:"
            jq -r '.client // "unknown"' "$log_dir/all-repos.jsonl" | tr '[:upper:]' '[:lower:]' | sort -u | sed 's/^/  /'
            exit 1
        fi
        
        echo "═══════════════════════════════════════════════════"
        echo "Client: $client_name"
        echo "═══════════════════════════════════════════════════"
        echo ""
        
        # Show all repos for this client
        for file in "$log_dir"/*.jsonl; do
            if [ "$(basename "$file")" != "all-repos.jsonl" ]; then
                repo_client=$(jq -r '.[0].client // "unknown"' <(jq -s '.' "$file") | tr '[:upper:]' '[:lower:]')
                if [ "$repo_client" = "$client_name" ]; then
                    show_stats "$file"
                fi
            fi
        done
        
        # Show breakdown by model for this client
        echo "═══════════════════════════════════════════════════"
        echo "Usage by Model for client: $client_name"
        echo "═══════════════════════════════════════════════════"
        echo ""
        
        jq -s 'map(.client |= (. // "unknown" | ascii_downcase)) | map(select(.client == "'$client_name'")) | group_by(.model) | map({model: .[0].model, sessions: length, tokens: {input: (map(.tokens.input) | add), output: (map(.tokens.output) | add), cache_creation: (map(.tokens.cache_creation) | add), cache_read: (map(.tokens.cache_read) | add), total: (map(.tokens.total) | add)}})' "$log_dir/all-repos.jsonl" 2>/dev/null | jq -c '.[]' | while read -r line; do
            model_name=$(echo "$line" | jq -r '.model')
            sessions=$(echo "$line" | jq -r '.sessions')
            total=$(echo "$line" | jq -r '.tokens.total')
            input=$(echo "$line" | jq -r '.tokens.input')
            output=$(echo "$line" | jq -r '.tokens.output')
            cache_creation=$(echo "$line" | jq -r '.tokens.cache_creation')
            cache_read=$(echo "$line" | jq -r '.tokens.cache_read')
            effective=$(echo "$input + ($output * 3) + ($cache_creation * 1.25) + ($cache_read * 0.1)" | bc)
            
            # Calculate cost
            cost=$(calculate_cost "$model_name" "$input" "$output" "$cache_creation" "$cache_read")
            formatted_cost=$(format_cost "$cost")
            
            echo "Model: $model_name"
            echo "  Sessions: $sessions"
            echo "  Total tokens: $total"
            echo "  - Input: $input"
            echo "  - Output: $output"
            echo "  - Cache creation: $cache_creation"
            echo "  - Cache read: $cache_read"
            printf "  Effective billable: %.0f\n" "$effective"
            if [ -n "$formatted_cost" ]; then
                echo "  Estimated cost: $formatted_cost"
            fi
            echo ""
        done
        
        # Show client totals
        echo "═══════════════════════════════════════════════════"
        echo "Total for client: $client_name"
        echo "═══════════════════════════════════════════════════"
        echo ""
        
        # Calculate total cost for client
        client_total_cost=0
        if [ "$pricing_loaded" = true ]; then
            while IFS= read -r model_line; do
                model=$(echo "$model_line" | jq -r '.model')
                model_input=$(echo "$model_line" | jq -r '.tokens.input')
                model_output=$(echo "$model_line" | jq -r '.tokens.output')
                model_cache_creation=$(echo "$model_line" | jq -r '.tokens.cache_creation')
                model_cache_read=$(echo "$model_line" | jq -r '.tokens.cache_read')
                model_cost=$(calculate_cost "$model" "$model_input" "$model_output" "$model_cache_creation" "$model_cache_read")
                if [ -n "$model_cost" ] && [ "$(echo "$model_cost > 0" | bc)" = "1" ]; then
                    client_total_cost=$(echo "$client_total_cost + $model_cost" | bc)
                fi
            done < <(jq -s --arg client "$client_name" 'map(.client |= (. // "unknown" | ascii_downcase)) | map(select(.client == $client)) | group_by(.model) | map({model: .[0].model, tokens: {input: (map(.tokens.input) | add), output: (map(.tokens.output) | add), cache_creation: (map(.tokens.cache_creation) | add), cache_read: (map(.tokens.cache_read) | add)}})' "$log_dir/all-repos.jsonl" 2>/dev/null | jq -c '.[]')
        fi
        
        jq -s 'map(.client |= (. // "unknown" | ascii_downcase)) | map(select(.client == "'$client_name'")) | {sessions: length, tokens: {input: (map(.tokens.input) | add), output: (map(.tokens.output) | add), cache_creation: (map(.tokens.cache_creation) | add), cache_read: (map(.tokens.cache_read) | add), total: (map(.tokens.total) | add)}}' "$log_dir/all-repos.jsonl" | jq -r 'to_entries | map("\(.key): \(.value)") | .[]' | while IFS=': ' read -r key value; do
            if [ "$key" = "sessions" ]; then
                echo "Sessions: $value"
            elif [ "$key" = "tokens" ]; then
                input=$(echo "$value" | jq -r '.input')
                output=$(echo "$value" | jq -r '.output')
                cache_creation=$(echo "$value" | jq -r '.cache_creation')
                cache_read=$(echo "$value" | jq -r '.cache_read')
                total=$(echo "$value" | jq -r '.total')
                effective=$(echo "$input + ($output * 3) + ($cache_creation * 1.25) + ($cache_read * 0.1)" | bc)
                
                echo "Total tokens: $total"
                echo "  - Input: $input"
                echo "  - Output: $output"
                echo "  - Cache creation: $cache_creation"
                echo "  - Cache read: $cache_read"
                printf "Effective billable tokens: %.0f\n" "$effective"
                formatted_cost=$(format_cost "$client_total_cost")
                if [ -n "$formatted_cost" ]; then
                    echo "Estimated cost: $formatted_cost"
                fi
            fi
        done
        ;;
    
    repo)
        if [ ${#command_args[@]} -eq 0 ]; then
            echo "Usage: $0 repo <org/repo> [--start DATE] [--end DATE]"
            exit 1
        fi
        repo_slug=$(echo "${command_args[0]}" | sed 's|/|_|g' | sed 's|^_||')
        repo_file="$log_dir/${repo_slug}.jsonl"

        if [ ! -f "$repo_file" ]; then
            echo "No data found for repository: ${command_args[0]}"
            exit 1
        fi

        show_stats "$repo_file"
        ;;
    
    list)
        echo "=== Available Repository Logs ==="
        echo ""
        for file in "$log_dir"/*.jsonl; do
            if [ "$(basename "$file")" != "all-repos.jsonl" ]; then
                repo_path=$(jq -r '.[0].repo_path' <(jq -s '.' "$file"))
                echo "$repo_path"
            fi
        done
        ;;
    
    help|--help|-h)
        echo "get-claude-code-report - Display Claude Code token usage statistics"
        echo ""
        echo "Usage: get-claude-code-report [COMMAND] [ARGS] [OPTIONS]"
        echo ""
        echo "Commands:"
        echo "  summary (default)    Show per-repository usage grouped by client"
        echo "  all                  Show combined totals across all repositories"
        echo "  client <name>        Show usage for a specific client"
        echo "  repo <org/repo>      Show usage for a specific repository"
        echo "  list                 List all tracked repositories"
        echo ""
        echo "Options:"
        echo "  --start DATE         Filter to sessions on or after this date (ISO 8601)"
        echo "  --end DATE           Filter to sessions on or before this date (ISO 8601)"
        echo ""
        echo "Date format: YYYY-MM-DD or YYYY-MM-DDTHH:MM:SS or YYYY-MM-DDTHH:MM:SSZ"
        echo "  Date-only values are treated as local timezone."
        echo "  --start uses beginning of day, --end uses end of day."
        echo "  Timestamps ending in Z are treated as UTC."
        echo ""
        echo "Examples:"
        echo "  # Show all usage"
        echo "  get-claude-code-report"
        echo ""
        echo "  # Show usage for February 2026"
        echo "  get-claude-code-report --start 2026-02-01 --end 2026-02-28"
        echo ""
        echo "  # Show client-a usage for last week"
        echo "  get-claude-code-report client client-a --start 2026-01-30"
        echo ""
        echo "Token rates used for effective billable calculation:"
        echo "  Input tokens:         1.0x"
        echo "  Output tokens:        3.0x"
        echo "  Cache creation:       1.25x"
        echo "  Cache read:           0.1x (90% discount)"
        echo ""
        echo "Cost calculations:"
        echo "  Estimated costs are shown when pricing data is available."
        echo "  Pricing is stored in: $HOME/.claude/pricing.json"
        echo "  Update pricing with: update-claude-pricing edit"
        echo "  View current pricing: update-claude-pricing show"
        echo "  Pricing source: https://www.anthropic.com/pricing"
        echo ""
        echo "Data location: $HOME/.claude/token-usage"
        echo "Client mapping: $HOME/.claude/client-mapping.json"
        exit 0
        ;;
    
    *)
        echo "Error: Unknown command '$command'"
        echo "Run 'get-claude-code-report help' for usage information."
        exit 1
        ;;
esac
