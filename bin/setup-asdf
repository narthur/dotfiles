#!/usr/bin/env bash
# Install asdf plugins for each tool in ~/.tool-versions, then install all versions.
set -e

echo "Setting up asdf plugins..."

# Read plugins into array first to avoid fd conflicts with asdf commands
plugins=()
while IFS=' ' read -r plugin _version; do
  [[ -z "$plugin" || "$plugin" == \#* ]] && continue
  plugins+=("$plugin")
done < ~/.tool-versions

# Add any missing plugins
for plugin in "${plugins[@]}"; do
  if asdf plugin list 2>/dev/null | grep -q "^${plugin}$"; then
    echo "  $plugin: already installed"
  else
    echo "  $plugin: adding plugin..."
    asdf plugin add "$plugin"
  fi
done

echo "Installing tool versions..."
asdf install

echo "Done!"
