#!/usr/bin/env bash
# Install asdf plugins for each tool in ~/.tool-versions, then install all versions.
set -e

echo "Setting up asdf plugins..."

# Ensure well-known plugins are always available regardless of .tool-versions
asdf plugin add nodejs https://github.com/asdf-vm/asdf-nodejs.git 2>/dev/null || true
asdf plugin add pnpm 2>/dev/null || true
asdf plugin add golang https://github.com/asdf-community/asdf-golang.git 2>/dev/null || true

# Read plugins into array first to avoid fd conflicts with asdf commands
plugins=()
while IFS=' ' read -r plugin _version || [[ -n "$plugin" ]]; do
  [[ -z "$plugin" || "$plugin" == \#* ]] && continue
  plugins+=("$plugin")
done < ~/.tool-versions

# Add any missing plugins
for plugin in "${plugins[@]}"; do
  if asdf plugin list 2>/dev/null | grep -q "^${plugin}$"; then
    echo "  $plugin: already installed"
  else
    echo "  $plugin: adding plugin..."
    asdf plugin add "$plugin"
  fi
done

echo "Installing tool versions..."
asdf install

echo "Done!"
