#!/usr/bin/env bash
set -euo pipefail

# task-session: Manage parallel tasks with git worktrees and Claude Code sessions
# Data stored in ~/.local/share/task-session/<repo-slug>/tasks.json

DATA_DIR="$HOME/.local/share/task-session"

# --- Helpers ---

get_repo_slug() {
  local remote
  remote=$(git remote get-url origin 2>/dev/null || echo "")
  if [[ -z "$remote" ]]; then
    echo "Error: not inside a git repository with a remote" >&2
    return 1
  fi
  # Extract owner/repo from SSH or HTTPS URL, remove .git suffix
  echo "$remote" | sed -E 's#^(https?://[^/]+/|git@[^:]+:)##; s/\.git$//'
}

get_repo_dir() {
  local slug
  slug=$(get_repo_slug) || return 1
  local dir="$DATA_DIR/$(echo "$slug" | tr '/' '-')"
  mkdir -p "$dir"
  echo "$dir"
}

get_tasks_file() {
  local dir
  dir=$(get_repo_dir) || return 1
  local file="$dir/tasks.json"
  if [[ ! -f "$file" ]]; then
    echo '[]' > "$file"
  fi
  echo "$file"
}

slugify() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'
}

next_id() {
  local file="$1"
  local max
  max=$(jq '[.[].id] | map(tonumber) | max // 0' "$file")
  echo $((max + 1))
}

now_iso() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

get_repo_root() {
  git rev-parse --show-toplevel 2>/dev/null
}

get_repo_name() {
  basename "$(get_repo_root)"
}

get_default_branch() {
  git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || echo "main"
}

# --- Commands ---

cmd_add() {
  local title="" description=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -d|--description)
        description="$2"
        shift 2
        ;;
      *)
        if [[ -z "$title" ]]; then
          title="$1"
        else
          title="$title $1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$title" ]]; then
    echo "Usage: task-session add <title> [-d description]" >&2
    return 1
  fi

  local file
  file=$(get_tasks_file) || return 1
  local id
  id=$(next_id "$file")
  local now
  now=$(now_iso)

  jq --arg id "$id" \
     --arg title "$title" \
     --arg desc "$description" \
     --arg now "$now" \
     '. += [{
       id: ($id | tonumber),
       title: $title,
       description: $desc,
       status: "todo",
       branch: null,
       worktree_path: null,
       session_id: null,
       pr_number: null,
       created_at: $now,
       updated_at: $now
     }]' "$file" > "$file.tmp" && mv "$file.tmp" "$file"

  echo "Created task #$id: $title"
}

cmd_list() {
  local status_filter=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status|-s)
        status_filter="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  local file
  file=$(get_tasks_file) || return 1

  local filter='.'
  if [[ -n "$status_filter" ]]; then
    filter="map(select(.status == \"$status_filter\"))"
  fi

  local tasks
  tasks=$(jq -r "$filter | .[] | \"#\\(.id)\\t[\\(.status)]\\t\\(.title)\"" "$file")

  if [[ -z "$tasks" ]]; then
    echo "No tasks found."
  else
    echo "$tasks" | column -t -s $'\t'
  fi
}

cmd_next() {
  local file
  file=$(get_tasks_file) || return 1

  # Priority: doing > review > todo
  local task
  task=$(jq -r '
    (map(select(.status == "doing")) + map(select(.status == "review")) + map(select(.status == "todo")))
    | first // empty
  ' "$file")

  if [[ -z "$task" || "$task" == "null" ]]; then
    echo "No actionable tasks."
    return 0
  fi

  echo "$task" | jq -r '"#\(.id) [\(.status)] \(.title)\n\(.description // "")\nBranch: \(.branch // "none")\nWorktree: \(.worktree_path // "none")\nPR: \(.pr_number // "none")\nSession: \(.session_id // "none")"'
}

cmd_view() {
  local id="$1"
  if [[ -z "$id" ]]; then
    echo "Usage: task-session view <id>" >&2
    return 1
  fi

  local file
  file=$(get_tasks_file) || return 1

  local task
  task=$(jq "map(select(.id == ($id | tonumber))) | first // empty" "$file")

  if [[ -z "$task" || "$task" == "null" ]]; then
    echo "Task #$id not found." >&2
    return 1
  fi

  echo "$task" | jq -r '"#\(.id) [\(.status)] \(.title)\nDescription: \(.description // "none")\nBranch: \(.branch // "none")\nWorktree: \(.worktree_path // "none")\nPR: \(.pr_number // "none")\nSession: \(.session_id // "none")\nCreated: \(.created_at)\nUpdated: \(.updated_at)"'
}

cmd_edit() {
  local id="$1"; shift
  if [[ -z "$id" ]]; then
    echo "Usage: task-session edit <id> [--title T] [--description D]" >&2
    return 1
  fi

  local title="" description="" has_title=false has_desc=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title|-t)
        title="$2"; has_title=true
        shift 2
        ;;
      --description|-d)
        description="$2"; has_desc=true
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  local file
  file=$(get_tasks_file) || return 1
  local now
  now=$(now_iso)

  local update_expr=".updated_at = \$now"
  local jq_args=(--arg now "$now" --arg id "$id")

  if $has_title; then
    update_expr="$update_expr | .title = \$title"
    jq_args+=(--arg title "$title")
  fi
  if $has_desc; then
    update_expr="$update_expr | .description = \$desc"
    jq_args+=(--arg desc "$description")
  fi

  jq "${jq_args[@]}" \
    "map(if .id == (\$id | tonumber) then $update_expr else . end)" \
    "$file" > "$file.tmp" && mv "$file.tmp" "$file"

  echo "Updated task #$id."
}

cmd_status() {
  local id="$1" new_status="$2"
  if [[ -z "$id" || -z "$new_status" ]]; then
    echo "Usage: task-session status <id> <new-status>" >&2
    return 1
  fi

  local valid_statuses="todo doing review done cancelled"
  if ! echo "$valid_statuses" | grep -qw "$new_status"; then
    echo "Invalid status: $new_status. Must be one of: $valid_statuses" >&2
    return 1
  fi

  local file
  file=$(get_tasks_file) || return 1
  local now
  now=$(now_iso)

  jq --arg id "$id" --arg status "$new_status" --arg now "$now" \
    'map(if .id == ($id | tonumber) then .status = $status | .updated_at = $now else . end)' \
    "$file" > "$file.tmp" && mv "$file.tmp" "$file"

  echo "Task #$id status changed to $new_status."
}

cmd_start() {
  local id="$1"
  if [[ -z "$id" ]]; then
    echo "Usage: task-session start <id>" >&2
    return 1
  fi

  local file
  file=$(get_tasks_file) || return 1

  local task
  task=$(jq "map(select(.id == ($id | tonumber))) | first // empty" "$file")

  if [[ -z "$task" || "$task" == "null" ]]; then
    echo "Task #$id not found." >&2
    return 1
  fi

  local title
  title=$(echo "$task" | jq -r '.title')
  local description
  description=$(echo "$task" | jq -r '.description // ""')
  local current_status
  current_status=$(echo "$task" | jq -r '.status')

  if [[ "$current_status" == "doing" ]]; then
    local existing_wt
    existing_wt=$(echo "$task" | jq -r '.worktree_path // ""')
    if [[ -n "$existing_wt" && -d "$existing_wt" ]]; then
      echo "Task #$id already has an active worktree at $existing_wt"
      echo "Use 'task-session resume $id' to continue working."
      return 1
    fi
  fi

  local repo_root
  repo_root=$(get_repo_root)
  local repo_name
  repo_name=$(get_repo_name)
  local default_branch
  default_branch=$(get_default_branch)
  local slug
  slug=$(slugify "$title")
  local branch="task/$slug"
  local worktree_dir
  worktree_dir="$(dirname "$repo_root")/${repo_name}-tasks/${slug}"

  # Create the tasks directory if needed
  mkdir -p "$(dirname "$worktree_dir")"

  # Create branch from default branch
  git fetch origin "$default_branch" 2>/dev/null || true
  git branch "$branch" "origin/$default_branch" 2>/dev/null || true

  # Create worktree
  if [[ -d "$worktree_dir" ]]; then
    echo "Worktree directory already exists: $worktree_dir"
  else
    git worktree add "$worktree_dir" "$branch"
  fi

  local now
  now=$(now_iso)

  # Update task
  jq --arg id "$id" --arg branch "$branch" --arg wt "$worktree_dir" --arg now "$now" \
    'map(if .id == ($id | tonumber) then
      .status = "doing" | .branch = $branch | .worktree_path = $wt | .updated_at = $now
    else . end)' \
    "$file" > "$file.tmp" && mv "$file.tmp" "$file"

  echo "Task #$id started."
  echo "Branch: $branch"
  echo "Worktree: $worktree_dir"
  echo ""
  echo "To start a Claude Code session:"
  echo "  cd $worktree_dir && claude"
  echo ""
  if [[ -n "$description" ]]; then
    echo "Task description:"
    echo "  $description"
  fi
}

cmd_resume() {
  local id="$1"
  shift || true
  local input="${*:-}"

  if [[ -z "$id" ]]; then
    echo "Usage: task-session resume <id> [input message]" >&2
    return 1
  fi

  local file
  file=$(get_tasks_file) || return 1

  local task
  task=$(jq "map(select(.id == ($id | tonumber))) | first // empty" "$file")

  if [[ -z "$task" || "$task" == "null" ]]; then
    echo "Task #$id not found." >&2
    return 1
  fi

  local worktree_path
  worktree_path=$(echo "$task" | jq -r '.worktree_path // ""')
  local session_id
  session_id=$(echo "$task" | jq -r '.session_id // ""')

  if [[ -z "$worktree_path" || ! -d "$worktree_path" ]]; then
    echo "No worktree found for task #$id. Use 'task-session start $id' first." >&2
    return 1
  fi

  if [[ -n "$session_id" && "$session_id" != "null" ]]; then
    echo "Resuming session $session_id in $worktree_path"
    echo ""
    echo "Run:"
    echo "  cd $worktree_path && claude --resume $session_id"
  else
    echo "No previous session found. Starting fresh in $worktree_path"
    echo ""
    echo "Run:"
    echo "  cd $worktree_path && claude"
  fi
}

cmd_pr() {
  local id="$1"
  if [[ -z "$id" ]]; then
    echo "Usage: task-session pr <id>" >&2
    return 1
  fi

  local file
  file=$(get_tasks_file) || return 1

  local task
  task=$(jq "map(select(.id == ($id | tonumber))) | first // empty" "$file")

  if [[ -z "$task" || "$task" == "null" ]]; then
    echo "Task #$id not found." >&2
    return 1
  fi

  local title
  title=$(echo "$task" | jq -r '.title')
  local description
  description=$(echo "$task" | jq -r '.description // ""')
  local branch
  branch=$(echo "$task" | jq -r '.branch // ""')
  local worktree_path
  worktree_path=$(echo "$task" | jq -r '.worktree_path // ""')

  if [[ -z "$branch" || "$branch" == "null" ]]; then
    echo "Task #$id has no branch. Start it first." >&2
    return 1
  fi

  # Push the branch
  local push_dir="${worktree_path:-$(get_repo_root)}"
  git -C "$push_dir" push -u origin "$branch" 2>&1

  # Create PR
  local pr_url
  pr_url=$(gh pr create \
    --head "$branch" \
    --title "$title" \
    --body "${description:-No description provided.}" \
    --repo "$(get_repo_slug)" 2>&1) || {
    echo "Failed to create PR: $pr_url" >&2
    return 1
  }

  local pr_number
  pr_number=$(echo "$pr_url" | grep -oE '[0-9]+$')

  local now
  now=$(now_iso)

  jq --arg id "$id" --arg pr "$pr_number" --arg now "$now" \
    'map(if .id == ($id | tonumber) then
      .status = "review" | .pr_number = ($pr | tonumber) | .updated_at = $now
    else . end)' \
    "$file" > "$file.tmp" && mv "$file.tmp" "$file"

  echo "PR created: $pr_url"
  echo "Task #$id moved to review."
}

cmd_open() {
  local id="$1"
  if [[ -z "$id" ]]; then
    echo "Usage: task-session open <id>" >&2
    return 1
  fi

  local file
  file=$(get_tasks_file) || return 1

  local worktree_path
  worktree_path=$(jq -r "map(select(.id == ($id | tonumber))) | first .worktree_path // empty" "$file")

  if [[ -z "$worktree_path" || ! -d "$worktree_path" ]]; then
    echo "No worktree found for task #$id." >&2
    return 1
  fi

  cursor "$worktree_path"
  echo "Opened $worktree_path in Cursor."
}

cmd_done() {
  local id="$1"
  if [[ -z "$id" ]]; then
    echo "Usage: task-session done <id>" >&2
    return 1
  fi

  local file
  file=$(get_tasks_file) || return 1
  local now
  now=$(now_iso)

  jq --arg id "$id" --arg now "$now" \
    'map(if .id == ($id | tonumber) then .status = "done" | .updated_at = $now else . end)' \
    "$file" > "$file.tmp" && mv "$file.tmp" "$file"

  echo "Task #$id marked as done."

  # Check if worktree exists and offer cleanup
  local worktree_path
  worktree_path=$(jq -r "map(select(.id == ($id | tonumber))) | first .worktree_path // empty" "$file")

  if [[ -n "$worktree_path" && -d "$worktree_path" ]]; then
    echo "Worktree still exists at $worktree_path"
    echo "Run 'task-session cleanup $id' to remove it."
  fi
}

cmd_cancel() {
  local id="$1"
  if [[ -z "$id" ]]; then
    echo "Usage: task-session cancel <id>" >&2
    return 1
  fi

  local file
  file=$(get_tasks_file) || return 1
  local now
  now=$(now_iso)

  jq --arg id "$id" --arg now "$now" \
    'map(if .id == ($id | tonumber) then .status = "cancelled" | .updated_at = $now else . end)' \
    "$file" > "$file.tmp" && mv "$file.tmp" "$file"

  echo "Task #$id cancelled."

  local worktree_path
  worktree_path=$(jq -r "map(select(.id == ($id | tonumber))) | first .worktree_path // empty" "$file")

  if [[ -n "$worktree_path" && -d "$worktree_path" ]]; then
    echo "Worktree still exists at $worktree_path"
    echo "Run 'task-session cleanup $id' to remove it."
  fi
}

cmd_cleanup() {
  local id="$1"
  if [[ -z "$id" ]]; then
    echo "Usage: task-session cleanup <id>" >&2
    return 1
  fi

  local file
  file=$(get_tasks_file) || return 1

  local task
  task=$(jq "map(select(.id == ($id | tonumber))) | first // empty" "$file")

  if [[ -z "$task" || "$task" == "null" ]]; then
    echo "Task #$id not found." >&2
    return 1
  fi

  local worktree_path
  worktree_path=$(echo "$task" | jq -r '.worktree_path // ""')
  local branch
  branch=$(echo "$task" | jq -r '.branch // ""')

  if [[ -n "$worktree_path" && -d "$worktree_path" ]]; then
    git worktree remove "$worktree_path" --force 2>/dev/null || {
      echo "Warning: Could not remove worktree at $worktree_path" >&2
    }
    echo "Removed worktree: $worktree_path"
  else
    echo "No worktree to clean up."
  fi

  if [[ -n "$branch" && "$branch" != "null" ]]; then
    git branch -D "$branch" 2>/dev/null || true
    echo "Deleted branch: $branch"
  fi

  local now
  now=$(now_iso)

  jq --arg id "$id" --arg now "$now" \
    'map(if .id == ($id | tonumber) then .worktree_path = null | .branch = null | .session_id = null | .updated_at = $now else . end)' \
    "$file" > "$file.tmp" && mv "$file.tmp" "$file"

  echo "Cleanup complete for task #$id."
}

cmd_summary() {
  local file
  file=$(get_tasks_file) || return 1

  jq -r 'group_by(.status) | map("\(first.status): \(length)") | .[]' "$file"

  local total
  total=$(jq 'length' "$file")
  echo "Total: $total"
}

cmd_diff() {
  local id="$1"
  if [[ -z "$id" ]]; then
    echo "Usage: task-session diff <id>" >&2
    return 1
  fi

  local file
  file=$(get_tasks_file) || return 1

  local task
  task=$(jq "map(select(.id == ($id | tonumber))) | first // empty" "$file")

  if [[ -z "$task" || "$task" == "null" ]]; then
    echo "Task #$id not found." >&2
    return 1
  fi

  local worktree_path
  worktree_path=$(echo "$task" | jq -r '.worktree_path // ""')
  local branch
  branch=$(echo "$task" | jq -r '.branch // ""')

  if [[ -z "$worktree_path" || ! -d "$worktree_path" ]]; then
    echo "No worktree found for task #$id." >&2
    return 1
  fi

  local default_branch
  default_branch=$(get_default_branch)

  git -C "$worktree_path" diff "origin/$default_branch...$branch" --stat
}

cmd_pr_status() {
  local id="$1"
  if [[ -z "$id" ]]; then
    echo "Usage: task-session pr-status <id>" >&2
    return 1
  fi

  local file
  file=$(get_tasks_file) || return 1

  local pr_number
  pr_number=$(jq -r "map(select(.id == ($id | tonumber))) | first .pr_number // empty" "$file")

  if [[ -z "$pr_number" || "$pr_number" == "null" ]]; then
    echo "Task #$id has no PR." >&2
    return 1
  fi

  gh pr view "$pr_number" --repo "$(get_repo_slug)"
}

cmd_set_session() {
  local id="$1" session_id="$2"
  if [[ -z "$id" || -z "$session_id" ]]; then
    echo "Usage: task-session set-session <id> <session-id>" >&2
    return 1
  fi

  local file
  file=$(get_tasks_file) || return 1
  local now
  now=$(now_iso)

  jq --arg id "$id" --arg sid "$session_id" --arg now "$now" \
    'map(if .id == ($id | tonumber) then .session_id = $sid | .updated_at = $now else . end)' \
    "$file" > "$file.tmp" && mv "$file.tmp" "$file"

  echo "Session ID set for task #$id."
}

# --- Main ---

cmd="${1:-help}"
shift || true

case "$cmd" in
  add)        cmd_add "$@" ;;
  list|ls)    cmd_list "$@" ;;
  next)       cmd_next "$@" ;;
  view)       cmd_view "$@" ;;
  edit)       cmd_edit "$@" ;;
  status)     cmd_status "$@" ;;
  start)      cmd_start "$@" ;;
  resume)     cmd_resume "$@" ;;
  pr)         cmd_pr "$@" ;;
  pr-status)  cmd_pr_status "$@" ;;
  open)       cmd_open "$@" ;;
  done)       cmd_done "$@" ;;
  cancel)     cmd_cancel "$@" ;;
  cleanup)    cmd_cleanup "$@" ;;
  summary)    cmd_summary "$@" ;;
  diff)       cmd_diff "$@" ;;
  set-session) cmd_set_session "$@" ;;
  help|--help|-h)
    echo "task-session - Manage parallel tasks with git worktrees"
    echo ""
    echo "Commands:"
    echo "  add <title> [-d desc]        Create a new task"
    echo "  list [--status S]            List tasks"
    echo "  next                         Show next actionable task"
    echo "  view <id>                    Show task details"
    echo "  edit <id> [--title] [--desc] Edit task"
    echo "  status <id> <status>         Change task status"
    echo "  start <id>                   Create worktree and start working"
    echo "  resume <id>                  Resume Claude Code session"
    echo "  pr <id>                      Create PR from task branch"
    echo "  pr-status <id>               Check PR status"
    echo "  open <id>                    Open worktree in Cursor"
    echo "  done <id>                    Mark task as done"
    echo "  cancel <id>                  Cancel task"
    echo "  cleanup <id>                 Remove worktree and branch"
    echo "  summary                      Show task counts by status"
    echo "  diff <id>                    Show diff for task branch"
    echo "  set-session <id> <sid>       Store Claude session ID"
    echo ""
    echo "Statuses: todo, doing, review, done, cancelled"
    ;;
  *)
    echo "Unknown command: $cmd. Run 'task-session help' for usage." >&2
    exit 1
    ;;
esac
