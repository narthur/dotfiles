{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/heroku-guard.sh",
            "if": "Bash(heroku *)"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/track-tokens.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "coderabbit@claude-plugins-official": true,
    "example-skills@anthropic-agent-skills": false
  },
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true
}
