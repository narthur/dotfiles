#!/usr/bin/env bash
# Record a local scheduled job's heartbeat in ~/.local/state/job-runs.tsv.
#
#   hc-ping <slug>            job succeeded
#   hc-ping --fail <slug>     job failed
#   hc-ping --start <slug>    job started
#
# Despite the name, this no longer reaches Healthchecks.io: `job-health` reads the
# log, and its hourly agent sends the one remaining ping (check `local-jobs`). The
# name and interface stay so no job script changes. See Fieldnotes/Local Job
# Health Plan.md.
#
# Monitoring must never take down the thing it monitors: this always exits 0, and
# a failed write is a warning on stderr, not an error.
#
#   hc-ping --setup           store the Healthchecks ping key in the Keychain
#                             (service healthchecks-ping-base-url), used by job-health
set -uo pipefail

LOG="$HOME/.local/state/job-runs.tsv"
KC_ACCT=healthchecks
KC_SVC=healthchecks-ping-base-url

STATE=ok
case "${1:-}" in
  --fail)  STATE=fail;  shift ;;
  --start) STATE=start; shift ;;
  -h|--help) awk 'NR>1 && /^#/ {sub(/^# ?/,""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
  --setup)
    echo "Paste the Healthchecks ping key (input hidden)."
    echo "Healthchecks > your project > Settings > Ping Key. A full"
    echo "https://hc-ping.com/<key> URL is accepted too."
    read -rs URL
    if [[ "$URL" != https://* ]]; then
      if [[ -z "$URL" || "$URL" == *[[:space:]/]* ]]; then
        echo "That is neither a ping key nor an https URL; nothing stored." >&2
        exit 1
      fi
      URL="https://hc-ping.com/${URL}"
    fi
    # -w VALUE, not a pipe: `security` reads from /dev/tty when a terminal exists,
    # so a piped password is ignored and it blocks forever. Verified by read-back
    # because a zero exit proves nothing here.
    security add-generic-password -a "$KC_ACCT" -s "$KC_SVC" -U -A -w "$URL"
    BACK="$(security find-generic-password -a "$KC_ACCT" -s "$KC_SVC" -w </dev/null 2>/dev/null || true)"
    [[ "$BACK" == "$URL" ]] || { echo "Failed Keychain verification; nothing usable stored." >&2; exit 1; }
    echo "Stored and verified."
    exit 0 ;;
esac

SLUG="${1:-}"
if [[ -z "$SLUG" ]]; then
  echo "hc-ping: no slug given" >&2
  exit 0
fi

mkdir -p "$(dirname "$LOG")" 2>/dev/null
printf '%s\t%s\t%s\n' "$(date -Iseconds)" "$SLUG" "$STATE" >> "$LOG" \
  || echo "hc-ping: could not write heartbeat for '$SLUG' to $LOG" >&2

exit 0
