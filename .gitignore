# Prevent accidental adds of sensitive files
.ssh/
.gnupg/
.env
*.pem
*.key

# Personal data tracked in dotprivate instead
.config/backup-urls/urls.txt

# Finance: scripts under finance/ are tracked in dotprivate; the data is not.
# Ledgers, budget targets and account mappings are backed up (encrypted) to B2
# by finance/ledger-push, so git has no recovery role here and would only add
# exposure. Deny the directory, then re-allow the scripts.
finance/*
!finance/*.py
!finance/*.sh
!finance/ledger-push
finance/__pycache__/

# Added by ggshield
.cache_ggshield

# Secrets backups — the real values live in ~/.env, never in git
.env.bak-*

# zsh completion cache (machine-specific)
.zcompdump*

# Ad-hoc vault backup tarballs (multi-GB)
obsidian-backup-*.tgz

# Claude Code runtime state — regenerated, machine-specific, and high-volume.
# Without these the routing check drowns in ~6.6k files and goes blind.
.claude/projects/
.claude/file-history/
.claude/plugins/
.claude/status-cache/
.claude/shell-snapshots/
.claude/logs/
.claude/paste-cache/
.claude/backups/
.claude/sessions/
.claude/jobs/
.claude/tasks/
.claude/security/
.claude/state/
.claude/feedback/

# gcloud credentials and state
.config/gcloud/

# Per-run caches, logs, locks and backups — regenerated on demand.
.claude/cache/
.claude/daemon/
.claude/daemon.*
.claude/daemon-auth-*
.claude/image-cache/
.claude/review-loop/
.claude/usage-cache*
.claude/history.jsonl
.claude/skill-usage.log
.claude/gh-pr-status-cache.json*
.claude/mcp-needs-auth-cache.json
.claude/.last-cleanup
.claude/.last-update-result.json
.claude/.ponytail-active
*.bak
*.bak-*
*.v2-backup

# Machine-local binaries, state and logs
.local/bin/
.local/share/
.local/state/
.local/log/
.config/tmux/plugins/
.config/zed/prompts/

# gh auth token
.config/gh/

# Third-party skills installed from upstream — reinstall, don't vendor.
.claude/skills/agents-sdk/
.claude/skills/cloudflare/
.claude/skills/cloudflare-email-service/
.claude/skills/cloudflare-one/
.claude/skills/cloudflare-one-migrations/
.claude/skills/durable-objects/
.claude/skills/gh-stack/
.claude/skills/humanizer/
.claude/skills/sandbox-migrate-to-next/
.claude/skills/sandbox-next/
.claude/skills/sandbox-sdk/
.claude/skills/sandbox-stable/
.claude/skills/turnstile-spin/
.claude/skills/web-perf/
.claude/skills/workers-best-practices/
.claude/skills/wrangler/
.claude/skills/basin/
.claude/skills/cf-cli/
.claude/skills/gateway-workers/
.claude/skills/k2/
.claude/skills/nextjs-on-cloudflare/
.claude/skills/workers-profiling/
.claude/hooks/logs/
fires.log
*.md5
.config/uv/uv-receipt.json
.config/configstore/

# Tool state with machine-absolute paths or install hashes
.config/bin/config.json
.config/hunk/state.json
.config/varlock/config.json
.config/freebuff-desktop/

# Contains a live Make API key — belongs in ~/.env, never in git
.config/make-cli/config.json

# static-analysis: vendored ESLint runner for the `depend` tool; package.json
# and the lockfile are tracked, the tree is not.
.claude/skills/static-analysis/depend/node_modules/
.claude/skills/static-analysis/__pycache__/

# Claude Code telemetry spool
.claude/telemetry/

# Herdr runtime state and vendor-installed skills
.config/herdr/**/*.log
.config/herdr/**/session.json
.config/herdr/release-notes.json
.config/herdr/.plugins.lock
.claude/skills/herdr
.claude/skills/synced/
.agents/

# The bare repos' own git dirs. dotprivate tracks a file under its git dir
# (info/review-loop-learnings.md), which otherwise makes check-routing walk every object.
.dotfiles/
.dotfiles-private/
.config/codexbar/config.json.lock
# App caches, profiles and runtime state — regenerated, machine-specific.
# Signal's attachments.noindex holds message attachments: never track it.
.config/obsidian/
.config/Cursor/
.config/discord/
.config/zenflow-desktop/
.config/chromium/
.config/google-chrome-for-testing/
.config/Signal/
.config/unity3d/
.config/libreoffice/
.config/evolution/
.config/herdr/session-snapshots/
.config/go/telemetry/
.config/.wrangler/
.cursor/projects/
.local/zed.app/
.claude/token-usage/
.claude/token-usage-backup-*/
# Credentials: login tokens and API keys written by CLIs and test tooling
.claude/.credentials.json
.claude/playwright-*-auth.json
.config/cursor/auth.json
.config/cursor/prompt_history.json
.config/neonctl/credentials.json
.config/stripe/config.toml
.config/graphite/user_config
.config/ggshield/auth_config.yaml
.config/io.datasette.llm/keys.json
.config/pulse/cookie
# Runtime noise: sockets, logs, caches, window/recent-file state, backups
.claude/debug/
.claude/stats-cache.json
.claude/settings.json.bak.*
.claude/chrome/
.config/*/NativeMessagingHosts/
.config/BraveSoftware/Brave-Browser/NativeMessagingHosts/
.config/herdr/*.sock*
.config/ibus/bus/
.config/connections.db
.config/dconf/user
.config/turborepo/telemetry.json
.config/slackcli/update-check.json
.config/wireshark/recent*
.config/totem/state.ini
.config/simple-scan/state
.config/QtProject.conf
.config/.gsd-keyboard.settings-ported
.config/menus/
.config/i3/config.backup.*
.config/systemd/user/*.backup
.config/io.datasette.llm/logs.db
.local/tmp/
# Disabled or machine-local systemd units, and enable symlinks (setup scripts run systemctl enable)
.config/systemd/user/*.wants/
.config/systemd/user/aw-qt.service
.config/systemd/user/agent-orchestrator*
# ActivityWatch: default tomls and the server's live copy (the canonical settings.json is tracked in dotprivate)
.config/activitywatch/*/
# Retired experiments (agent-orchestrator, agent-runner): kept on disk, not versioned
.config/agent-orchestrator/
.config/launchd/com.narthur.agent-runner.plist
.config/agents/
# Machine-local or retired bin entries
bin/lazyagentic
bin/claude-worktree
bin/claude-worktree-selector
bin/migrate-token-logs
# Unused .claude leftovers (publish.sh: reports publish as Artifacts since 2026-09-07, dotprivate c7a26a3)
.claude/hooks/resolve-git-repo.sh
.claude/client-mapping.json
.claude/pricing.json
.claude/skills/oz-cli
.claude/skills/client-report/publish.sh
# App-written preferences and state, empty files, machine-specific paths
.config/warp-terminal/user_preferences.json
.config/vlc/
.config/Thunar/accels.scm
.config/xfce4/
.config/inkscape/
.config/xournalpp/
.config/gtk-3.0/bookmarks
.config/user-dirs.*
.config/*xdg-terminals.list
.config/gitbutler/
.config/astro/
.config/enchant/
.config/clerk/
.config/ynab-cli-nodejs/
# vite-plus installer shims (regenerated)
.config/vite-plus/

# Podman machine state (contains SSH keys)
.config/containers/
